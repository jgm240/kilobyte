#!/bin/sh
# kb: Kilobyte, the text-mode desktop, on macOS (the kilobyte-transition
# Homebrew package). Kilobyte runs in a small Debian virtual machine made
# with Lima (Apple's own virtualisation), shown in your terminal:
#
#   kb open             go to Kilobyte, in a Terminal window of its own with its
#                       pixel font (the first time it sets the machine up)
#   kb open --here      go to Kilobyte in this terminal
#   kb size N           Kilobyte's text size in points (sharpest at 8, 16, 24, 32...)
#   kb size auto        16 points, the size of Kilobyte on a PC (the default)
#   kb close            stop Kilobyte's machine
#   kb autolaunch on    open Kilobyte in Terminal when you log in to your Mac
#   kb autolaunch off   do not
#   kb autolaunch       say which it is
#   kb update           the newest Kilobyte (apt upgrade in the machine)
#   kb remove           remove Kilobyte's machine and everything in it
#
# Copyright (C) 2026 Kilobyte contributors. GNU GPL, version 3 or later.
set -e
VM=kilobyte
here=$(cd "$(dirname "$0")" && pwd -P)
# The Lima template: next to kb in a Homebrew install, or in the repository.
TEMPLATE=""
for t in "$here/../share/kilobyte-transition/kilobyte.yaml" "$here/kilobyte.yaml"; do
    [ -f "$t" ] && { TEMPLATE=$t; break; }
done
FONT="$(dirname "${TEMPLATE:-$here/x}")/kilobyte-vga16.ttf"
CONF="$HOME/Library/Application Support/Kilobyte"
AGENT="$HOME/Library/LaunchAgents/io.github.jgm240.kilobyte.plist"

usage() { sed -n 's/^#   //p' "$0"; exit "${1:-0}"; }

command -v limactl >/dev/null || { echo "kb: Lima is missing (brew install lima)" >&2; exit 1; }

status() { limactl list --format '{{.Status}}' "$VM" 2>/dev/null || true; }

ensure() {
    case $(status) in
        Running) return 0 ;;
        "")
            [ -n "$TEMPLATE" ] || { echo "kb: the Kilobyte template is missing" >&2; exit 1; }
            echo "Setting up Kilobyte's machine: Debian and Kilobyte download once (about 1 GB);"
            echo "this takes a few minutes."
            limactl create --name="$VM" --tty=false "$TEMPLATE" ;;
    esac
    limactl start --tty=false "$VM"
}

# The machine runs before Kilobyte is in it: the first time, its setup
# (Debian's packages, then Kilobyte's) goes on for some minutes.
# (Ready when Debian has kilobyte-transition fully installed and set up: the
# program file is there minutes earlier, while the packages are unpacked.)
ready() {
    limactl shell --workdir / "$VM" sh -c \
        'dpkg-query -W -f="\${Status}" kilobyte-transition 2>/dev/null | grep -q "ok installed" && ! pgrep -x apt-get >/dev/null' 2>/dev/null
}

wait_ready() {
    ready && return 0
    echo "Kilobyte is still being set up in its machine (the first time takes a few minutes)."
    i=0
    until ready; do
        i=$((i + 1))
        if [ $i -gt 240 ]; then
            echo >&2
            echo "kb: Kilobyte did not finish setting up. What happened:" >&2
            limactl shell --workdir / "$VM" sudo tail -n 15 /var/log/cloud-init-output.log >&2 || true
            exit 1
        fi
        printf '.'
        sleep 5
    done
    echo " ready."
}

run_here() { ensure; wait_ready; exec limactl shell --workdir / "$VM" /usr/bin/kilobyte; }

# Kilobyte's pixel font, for the user (Terminal finds it in ~/Library/Fonts).
install_font() {
    [ -f "$HOME/Library/Fonts/KilobyteVGA.ttf" ] && return 0
    [ -f "$FONT" ] || return 0
    mkdir -p "$HOME/Library/Fonts" && cp "$FONT" "$HOME/Library/Fonts/KilobyteVGA.ttf"
}

# Text sizes to try, first choice first. 16 points draws each pixel of
# Kilobyte's font as 2 x 2 on a Retina screen (1 x 1 on others): the size it
# has on a PC's console, sharp. 8 if the screen is too small for 80 x 25
# characters at 16. "kb size N" picks another.
sizes() {
    size=$(cat "$CONF/size" 2>/dev/null || echo auto)
    if [ "$size" = auto ]; then echo "16, 8"; else echo "$size, 8"; fi
}

# The "Kilobyte" Terminal profile, made once: the pixel font without smoothing,
# line spacing 1, the 16 CGA colours, and the window closing when Kilobyte
# ends. Only Kilobyte's windows use it; your own profile stays as it is.
# Written as a .terminal file (Terminal adds a profile when one is opened).
PROFILE="$CONF/Kilobyte.terminal"
make_profile() {
    mkdir -p "$CONF"
    osascript -l JavaScript - "$PROFILE" "$here/kb" >/dev/null <<'JS'
ObjC.import("AppKit");
function run(argv) {
    var path = argv[0], kb = argv[1];
    var d = $.NSMutableDictionary.alloc.init;
    function put(key, value) { d.setObjectForKey(value, key); }
    function archive(o) { return $.NSKeyedArchiver.archivedDataWithRootObjectRequiringSecureCodingError(o, false, null); }
    function color(hex) {
        var n = parseInt(hex, 16);
        return archive($.NSColor.colorWithSRGBRedGreenBlueAlpha(((n >> 16) & 255) / 255, ((n >> 8) & 255) / 255, (n & 255) / 255, 1));
    }
    put("name", "Kilobyte");
    put("type", "Window Settings");
    put("ProfileCurrentVersion", $.NSNumber.numberWithDouble(2.07));
    var font = $.NSFont.fontWithNameSize("KilobyteVGA-Regular", 16);
    if (font.isNil()) font = $.NSFont.userFixedPitchFontOfSize(16);
    put("Font", archive(font));
    put("FontAntialias", $.NSNumber.numberWithBool(false));
    put("FontHeightSpacing", $.NSNumber.numberWithDouble(1.0));
    put("FontWidthSpacing", $.NSNumber.numberWithDouble(1.0));
    put("columnCount", $.NSNumber.numberWithInt(100));
    put("rowCount", $.NSNumber.numberWithInt(32));
    put("BackgroundColor", color("000000"));
    put("TextColor", color("AAAAAA"));
    put("TextBoldColor", color("FFFFFF"));
    put("CursorColor", color("FFFFFF"));
    put("SelectionColor", color("5555FF"));
    var ansi = [["Black", "000000"], ["Red", "AA0000"], ["Green", "00AA00"], ["Yellow", "AA5500"],
                ["Blue", "0000AA"], ["Magenta", "AA00AA"], ["Cyan", "00AAAA"], ["White", "AAAAAA"],
                ["BrightBlack", "555555"], ["BrightRed", "FF5555"], ["BrightGreen", "55FF55"], ["BrightYellow", "FFFF55"],
                ["BrightBlue", "5555FF"], ["BrightMagenta", "FF55FF"], ["BrightCyan", "55FFFF"], ["BrightWhite", "FFFFFF"]];
    ansi.forEach(function (c) { put("ANSI" + c[0] + "Color", color(c[1])); });
    put("UseBrightBold", $.NSNumber.numberWithBool(true));
    put("useOptionAsMetaKey", $.NSNumber.numberWithBool(true));
    put("shellExitAction", $.NSNumber.numberWithInt(1));       // close when Kilobyte ends
    put("ShowWindowSettingsNameInTitle", $.NSNumber.numberWithBool(false));
    d.writeToFileAtomically(path, true);
}
JS
}

# A Terminal window of Kilobyte's own, in its profile, as large as the
# screen allows (the whole screen, like Kilobyte on a PC).
open_window() {
    install_font
    sleep 1                                   # (a font just added takes a moment)
    make_profile
    osascript >/dev/null <<OSA
tell application "Terminal"
    if not (exists settings set "Kilobyte") then
        -- Opening the profile's file adds it to Terminal, in a window of its
        -- own: that window (and only that one) is closed again.
        set oldWindows to id of every window
        do shell script "open " & quoted form of "$PROFILE"
        repeat 20 times
            if exists settings set "Kilobyte" then exit repeat
            delay 0.25
        end repeat
        delay 0.5
        repeat with w in (every window)
            if (id of w) is not in oldWindows then close w
        end repeat
    end if
    set t to do script "clear; exec '$here/kb' open --here"
    try
        set current settings of t to settings set "Kilobyte"
    end try
    activate
    try
        set custom title of t to "Kilobyte"
    end try
    repeat with n in {$(sizes)}
        try
            set font name of t to "KilobyteVGA-Regular"
            set font antialiasing of t to false
            set font size of t to (n as integer)
            set number of columns of t to 400
            set number of rows of t to 200
            if (number of columns of t) ≥ 80 and (number of rows of t) ≥ 25 then exit repeat
        end try
    end repeat
end tell
OSA
}

case "${1:-} ${2:-}" in
    "open --here")
        run_here ;;
    "open ")
        open_window ;;
    "size ")
        echo "Kilobyte's text size: $(cat "$CONF/size" 2>/dev/null || echo "auto (16 points, as on a PC)")" ;;
    "size auto")
        rm -f "$CONF/size"
        echo "Kilobyte picks its text size by itself; kb open shows it." ;;
    "size "*)
        case $2 in
            [1-9] | [1-9][0-9] | 1[0-9][0-9]) mkdir -p "$CONF" && echo "$2" > "$CONF/size"
                echo "Kilobyte's text size: $2 points (sharpest at 8, 16, 24, 32...); kb open shows it." ;;
            *) echo "kb: a size in points, such as 24, or auto" >&2; exit 2 ;;
        esac ;;
    "close ")
        [ "$(status)" = Running ] && limactl stop "$VM" || echo "Kilobyte is not running." ;;
    "autolaunch on")
        mkdir -p "$(dirname "$AGENT")"
        cat > "$AGENT" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>io.github.jgm240.kilobyte</string>
  <key>ProgramArguments</key><array><string>$here/kb</string><string>open</string></array>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>$(dirname "$(command -v limactl)"):/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>RunAtLoad</key><true/>
</dict>
</plist>
PLIST
        launchctl bootout "gui/$(id -u)" "$AGENT" 2>/dev/null || true
        launchctl bootstrap "gui/$(id -u)" "$AGENT" 2>/dev/null || true
        echo "Kilobyte opens in Terminal when you log in. (kb autolaunch off undoes it.)" ;;
    "autolaunch off")
        launchctl bootout "gui/$(id -u)" "$AGENT" 2>/dev/null || true
        rm -f "$AGENT"
        echo "Kilobyte no longer opens when you log in." ;;
    "autolaunch ")
        if [ -f "$AGENT" ]; then echo "on: Kilobyte opens when you log in"; else echo "off: Kilobyte does not open by itself"; fi ;;
    "update ")
        ensure
        limactl shell --workdir / "$VM" sudo sh -c 'apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y' ;;
    "remove ")
        printf 'This removes Kilobyte'"'"'s machine with everything in it (your Kilobyte documents too). Remove it? [y/N] '
        read -r a
        case $a in y | Y | yes) ;; *) exit 0 ;; esac
        launchctl bootout "gui/$(id -u)" "$AGENT" 2>/dev/null || true
        rm -f "$AGENT"
        limactl delete --force "$VM" 2>/dev/null || true
        echo "Kilobyte's machine is removed. (brew uninstall kilobyte-transition removes kb itself.)" ;;
    "help " | "--help " | "-h " | " ") usage 0 ;;
    *) usage 2 ;;
esac
