#!/bin/sh
# Kilobyte.app: Kilobyte (kb open, from the kilobyte-transition package) in a
# Terminal window big enough for it.
KB=""
for d in /opt/homebrew/bin /usr/local/bin "$HOME/.local/bin"; do
    [ -x "$d/kb" ] && { KB="$d/kb"; break; }
done
if [ -z "$KB" ]; then
    osascript -e 'display alert "Kilobyte" message "The kb command is missing. In Terminal: brew install jgm240/kilobyte/kilobyte-transition"' >/dev/null
    exit 1
fi
# kb opens Kilobyte's own Terminal window (its font, size and colours).
exec "$KB" open
