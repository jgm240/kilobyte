    [ -e "$KB_CONF/desktop-apps" ] || cur=" Files Editor Web Terminal Settings Trash "
    while IFS='|' read -r id cat name rest; do
        case $seen in *" $id "*) continue ;; esac
        seen+="$id "
        items+=("$id" "$name" "$(case $cur in *" $id "*) echo on ;; *) echo off ;; esac)")
    done < <(/usr/bin/kilobyte --list-apps)
    sel=$(kb_dialog --title " Desktop Icons " --ok-label "Save" --cancel-label "Back" --no-tags --separate-output --checklist \
"Programs with an icon on the desktop of Kilobyte Desktop (Space ticks).
Files and folders you put into ~/Desktop appear there too." 22 70 13 "${items[@]}") || return
    printf '%s\n' "$sel" > "$KB_CONF/desktop-apps"
}

# --- Defaults: which program opens what ---------------------------------------
DEFAULT_KINDS=(editor "Text editor" web "Web browser" files "File manager"
               mail "Email" spreadsheet "Spreadsheet" music "Music player")

default_name() { # default_name KIND ID
    local k i name rest
    while IFS='|' read -r k i name rest; do
        [ "$k" = "$1" ] && [ "$i" = "$2" ] && { printf '%s' "${name%% (*}"; return; }
    done < "$KB_SHARE/defaults.tsv"
    printf '%s' "$2"
}

default_set() { # default_set KIND ID
    local f="$KB_CONF/defaults" k v
    {
        if [ -r "$f" ]; then
            while IFS='=' read -r k v; do
                [ -n "$k" ] && [ "$k" != "$1" ] && printf '%s=%s\n' "$k" "$v"
            done < "$f"
        fi
        printf '%s=%s\n' "$1" "$2"
    } > "$f.new" && mv "$f.new" "$f"
    # The file manager's F4 opens the chosen editor, or mc's own.
    if [ "$1" = editor ] && [ -f "$HOME/.config/mc/ini" ]; then
        local internal=false
        [ "$2" = kilobyte ] && internal=true
        if grep -q '^use_internal_edit=' "$HOME/.config/mc/ini"; then
            sed -i "s/^use_internal_edit=.*/use_internal_edit=$internal/" "$HOME/.config/mc/ini"
        else
            sed -i "/^\[Midnight-Commander\]/a use_internal_edit=$internal" "$HOME/.config/mc/ini"
        fi
    fi
}

default_choose() { # default_choose KIND TITLE
    local kind=$1 title=$2 cur items=() k i name cmd pkg state sel bin
    cur=$(kb_default_id "$kind")
    while IFS='|' read -r k i name cmd pkg; do
        [ "$k" = "$kind" ] || continue
        bin=${cmd%% *}
        if [ -z "$bin" ] || command -v "$bin" >/dev/null 2>&1; then
            state=""
        else
            state="  (gets installed)"
        fi
        items+=("$i" "$([ "$i" = "$cur" ] && echo "»" || echo " ") $name$state")
    done < <(grep -v '^#' "$KB_SHARE/defaults.tsv")
    sel=$(kb_dialog --title " $title " --default-item "$cur" --ok-label "Choose" --cancel-label "Back" --no-tags --menu \
        "Which program opens when you start the $title, or open a\nfile of its kind (» is the one now):" 0 78 0 "${items[@]}") || return
    [ -n "$sel" ] || return
    while IFS='|' read -r k i name cmd pkg; do
        [ "$k" = "$kind" ] && [ "$i" = "$sel" ] || continue
        bin=${cmd%% *}
        if [ -n "$bin" ] && ! command -v "$bin" >/dev/null 2>&1; then
            kb_yesno "$title" "${name%% (*} is not installed yet.\n\nInstall it now (Debian package $pkg)?" 10 60 || return
            kb_sudo || return
            clear
            printf '\n  Installing %s ...\n\n' "${name%% (*}"
            sudo DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "$pkg" ||
                { sudo apt-get update && sudo DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "$pkg"; }
            command -v "$bin" >/dev/null 2>&1 ||
                { kb_msg "$title" "${name%% (*} could not be installed (is the computer on-line?)." 8 60; return; }
        fi
        default_set "$kind" "$sel"
        "$KB_LIB/kb-notify" "Defaults" "$title: ${name%% (*}" >/dev/null 2>&1 || true
    done < <(grep -v '^#' "$KB_SHARE/defaults.tsv")
}

defaults_panel() {
    local sel=editor items i kind title
    while true; do
        items=()
        for ((i = 0; i < ${#DEFAULT_KINDS[@]}; i += 2)); do
            kind=${DEFAULT_KINDS[i]} title=${DEFAULT_KINDS[i+1]}
            items+=("$kind" "$(printf '%-14s %s' "$title" "$(default_name "$kind" "$(kb_default_id "$kind")")")")
        done
        sel=$(kb_dialog --title " Defaults " --default-item "$sel" --ok-label "Change" --cancel-label "Back" --no-tags \
            --menu "The programs Kilobyte starts for each job. They open from the\nProgram Manager, the desktop and the file manager." 0 70 0 "${items[@]}") || return
        for ((i = 0; i < ${#DEFAULT_KINDS[@]}; i += 2)); do
            [ "${DEFAULT_KINDS[i]}" = "$sel" ] && default_choose "$sel" "${DEFAULT_KINDS[i+1]}"
        done
    done
}

# The pages of Settings, as ID "title" "what it is" triples, for this kind
# of Kilobyte.
settings_items() {
    items=(

        Update     "Kilobyte Update"               "Get the newest Kilobyte from GitHub" \
        Wi-Fi      "Wireless networks"             "Turn Wi-Fi on or off and connect to a network" \
        Windows    "Windows and multitasking: $([ -e "$KB_CONF/windows-off" ] && echo OFF || echo ON)" "Several programs at once in movable windows" \
        Hotspot    "Wi-Fi hotspot"                 "Share this computer's Internet connection over Wi-Fi" \
        Bluetooth  "Bluetooth"                     "Keyboards, mice, headphones and speakers" \
        Network    "Network status"                "Addresses, gateway, DNS and a connection test" \
        Appearance "Colour theme"                  "Classic blue, panels, 8-bit, 16-bit, 1984... or make your own" \
        Wallpaper  "Desktop wallpaper"             "Patterns, your own characters, colours or a picture" \
        Pointer    "Mouse pointer"                 "Any character(s) as the mouse pointer, in any colours" \
        Desktop    "Desktop icons"                 "Which programs have an icon on the desktop" \
        Defaults   "Default programs"              "Text editor, web browser, file manager, email, music..." \
        Display    "Console font and size"         "Bigger letters for high resolution screens" \
        Access     "Accessibility"                 "Screen reader (speech), braille display, large letters" \
        Swap       "Swap and memory"               "Compressed memory (zram), a swap file, how readily to swap" \
        Saver      "Screen saver"                  "Starfield, lines or flying floppies, and when" \
        Tiles      "Desktop tiles"                 "Weather and news beside the Program Manager" \
        Sound      "Sound"                         "Volume, start-up and shut-down sounds" \
        Printers   "Printers"                      "Add a printer, print a test page" \
        Battery    "Battery"                       "Charge, time left and battery health (laptops)" \
        Email      "Email account"                 "Set up the account the Email program uses" \
        Keyboard   "Keyboard layout"               "Choose the layout of your keyboard" \
        Date       "Date, time and time zone"      "Set the clock and the time zone" \
        Software   "Add or remove programs"        "Search, install and update Debian packages" \
        Login      "Login and startup"             "Windows, automatic login, start-up screen" \
        Users      "Users"                         "Switch user, add and remove users" \
        Remote     "Remote login"                  "Let other computers use this one (SSH)" \
        Password   "Change your password"          "Change the password of $USER" \
        Tasks      "Task manager"                  "htop: F9 ends a task, F10 closes" \
        About      "About this computer"           "Processor, memory, disk and version"
    )
    # Parental controls, when downloaded (kbutils dl parentalctl).
    [ -x /usr/lib/kilobyte-parentalctl/parentalctl ] &&
        items+=(Parental "Parental controls" "Time limits, bedtimes, programs and the Internet for children")
    if [ "$KB_VARIANT" = kindle ]; then
        # KilobytEink on a Kindle: the Kindle looks after Wi-Fi, the clock,
        # the screen, sound and power; only KilobytEink's own settings here.
        keep=" Update Appearance Defaults Network Battery Email Software Tasks About " k=()
        for ((n = 0; n < ${#items[@]}; n += 3)); do
            [[ $keep == *" ${items[n]} "* ]] && k+=("${items[@]:n:3}")
        done
        items=("${k[@]}")
    elif [ "$KB_VARIANT" = wsl ]; then
        # In Windows (WSL): Windows looks after the network, users, fonts,
        # printers and power; Kilobyte Update keeps Kilobyte itself new.
        keep=" Update Windows Appearance Wallpaper Pointer Desktop Defaults Saver Tiles Email Software Tasks About " k=()
        for ((n = 0; n < ${#items[@]}; n += 3)); do
            [[ $keep == *" ${items[n]} "* ]] && k+=("${items[@]:n:3}")
        done
        items=("${k[@]}")
    elif [ "$KB_VARIANT" = transition ]; then
        # Next to a normal desktop: the computer's own settings look after
        # the network, login, fonts, printers, users and updates (apt).
        keep=" Windows Appearance Wallpaper Pointer Desktop Defaults Saver Tiles Sound Battery Email Software Tasks About " k=()
        for ((n = 0; n < ${#items[@]}; n += 3)); do
            [[ $keep == *" ${items[n]} "* ]] && k+=("${items[@]:n:3}")
        done
        items=("${k[@]}")
    fi
}

page=${1:-}
# settings --list: the pages, ID<TAB>title<TAB>what it is (for KBFind).
if [ "$page" = --list ]; then
    settings_items
    for ((n = 0; n < ${#items[@]}; n += 3)); do printf '%s\t%s\t%s\n' "${items[@]:n:3}"; done
    exit 0
fi
sel=Update
while true; do
    if [ -z "$page" ]; then
        settings_items
        sel=$(kb_dialog --title " Settings " --item-help --default-item "$sel" \
            --ok-label "Open" --cancel-label "Close" \
            --menu "Settings for this computer." 0 64 0 "${items[@]}") || exit 0
    else
        sel=$page
    fi
    case $sel in
        Update)     update_panel ;;
        Wi-Fi)      wifi_panel ;;
        Windows)    windows_panel ;;
        Hotspot)    hotspot_panel ;;
        Bluetooth)  bluetooth_panel ;;
        Network)    network_panel ;;
        Appearance) appearance_panel ;;
        Wallpaper)  wallpaper_panel ;;
        Pointer)    pointer_panel ;;
        Display)    display_panel ;;
        Access)     access_panel ;;
        Swap)       swap_panel ;;
        Saver)      saver_panel ;;
        Tiles)      tiles_panel ;;
        Sound)      sound_panel ;;
        Printers)   printers_panel ;;
        Battery)    "$KB_LIB/apps/battery" ;;
        Email)      "$KB_LIB/apps/mail" --setup ;;
        Keyboard)   keyboard_panel ;;
        Date)       datetime_panel ;;
        Software)   software_panel ;;
        Login)      login_panel ;;
        Users)      users_panel ;;
        SwitchUser) switch_user_panel ;;
        Remote)     remote_panel ;;
        Desktop)    desktop_panel ;;
        Defaults)   defaults_panel ;;
        Password)   kb_run_pause passwd ;;
        Tasks)      kb_run htop ;;
        About)      about_panel ;;
        Parental)   [ -x /usr/lib/kilobyte-parentalctl/parentalctl-ui ] && /usr/lib/kilobyte-parentalctl/parentalctl-ui ;;
    esac
    [ -z "$page" ] || exit 0
done
