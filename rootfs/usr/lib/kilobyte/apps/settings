#!/bin/bash
# Settings: every knob of a Kilobyte computer in one place.
. /usr/lib/kilobyte/lib.sh

ROOT="sudo -n /usr/lib/kilobyte/kb-root"   # the few passwordless root actions

# --- Wi-Fi ----------------------------------------------------------------

wifi_iface() {
    local d
    for d in /sys/class/net/*/wireless; do
        [ -d "$d" ] && { basename "$(dirname "$d")"; return 0; }
    done
    return 1
}

wifi_is_on() { [ ! -e /etc/kilobyte/wifi-off ]; }

wcli() { wpa_cli -i "$IF" "$@" 2>/dev/null; }

wifi_status_text() {
    local st ssid ip
    if ! IF=$(wifi_iface); then echo "\Z1No Wi-Fi adapter found.\Zn"; return; fi
    if ! wifi_is_on; then echo "Wi-Fi is \Z1\ZbOFF\Zn."; return; fi
    st=$(wcli status)
    ssid=$(sed -n 's/^ssid=//p' <<< "$st")
    ip=$(sed -n 's/^ip_address=//p' <<< "$st")
    case $(sed -n 's/^wpa_state=//p' <<< "$st") in
        COMPLETED) echo "Wi-Fi is \ZbON\Zn, connected to \Zb$ssid\Zn${ip:+ ($ip)}." ;;
        SCANNING | ASSOCIATING | AUTHENTICATING | ASSOCIATED | 4WAY_HANDSHAKE | GROUP_HANDSHAKE)
                   echo "Wi-Fi is \ZbON\Zn, connecting..." ;;
        "")        echo "Wi-Fi is \ZbON\Zn, the adapter $IF is starting..." ;;
        *)         echo "Wi-Fi is \ZbON\Zn, not connected." ;;
    esac
}

bars() { # signal in dBm -> strength bars
    local s=${1%%.*}
    if   [ "$s" -ge -55 ]; then echo "■■■■"
    elif [ "$s" -ge -67 ]; then echo "■■■·"
    elif [ "$s" -ge -75 ]; then echo "■■··"
    else                        echo "■···"
    fi
}

wifi_connect() {
    local line bssid freq sig flags ssid items=() seen="" choice pw id hex n st
    kb_info "Looking for wireless networks..."
    wcli scan >/dev/null
    sleep 4
    # Strongest first, one entry per network name.
    while IFS=$'\t' read -r bssid freq sig flags ssid; do
        [ -n "$ssid" ] || continue
        case "$seen" in *$'\n'"$ssid"$'\n'*) continue ;; esac
        seen+=$'\n'"$ssid"$'\n'
        case $flags in *WPA* | *RSN* | *SAE*) flags="secured" ;; *WEP*) flags="WEP" ;; *) flags="open" ;; esac
        items+=("$ssid" "$(bars "$sig")  $flags")
    done < <(wcli scan_results | tail -n +2 | sort -t$'\t' -k3,3 -nr)
    if [ ${#items[@]} -eq 0 ]; then
        kb_msg "Wi-Fi" "No wireless networks found.\n\nMove closer to the access point and try again."
        return
    fi
    items+=("<Hidden>" "Network that does not broadcast its name")

    choice=$(kb_dialog --title " Connect to Wi-Fi " --ok-label "Connect" --cancel-label "Back" \
        --menu "Networks in range:" 20 64 12 "${items[@]}") || return
    if [ "$choice" = "<Hidden>" ]; then
        choice=$(kb_input "Hidden Network" "Name (SSID) of the network:") || return
        [ -n "$choice" ] || return
        flags=secured
    else
        flags=$(wcli scan_results | awk -F'\t' -v s="$choice" '$5 == s { print $4; exit }')
    fi

    id=$(wcli add_network | tail -n 1)
    hex=$(printf '%s' "$choice" | od -An -tx1 | tr -d ' \n')
    wcli set_network "$id" ssid "$hex" >/dev/null
    if ! grep -q 'secured\|WPA\|RSN\|SAE\|WEP' <<< "$flags"; then
        wcli set_network "$id" key_mgmt NONE >/dev/null
    else
        pw=$(kb_password "Wi-Fi Password" "Password for \"$choice\":") || { wcli remove_network "$id" >/dev/null; return; }
        wcli set_network "$id" psk "\"$pw\"" >/dev/null
        wcli set_network "$id" key_mgmt "WPA-PSK WPA-PSK-SHA256 SAE" >/dev/null
        wcli set_network "$id" ieee80211w 1 >/dev/null
    fi
    wcli set_network "$id" scan_ssid 1 >/dev/null
    wcli enable_network "$id" >/dev/null
    wcli select_network "$id" >/dev/null
    wcli save_config >/dev/null

    for n in $(seq 1 20); do
        kb_info "Connecting to \"$choice\"...  ($n)"
        st=$(wcli status)
        if grep -q '^wpa_state=COMPLETED' <<< "$st" && grep -q '^ip_address=' <<< "$st"; then
            kb_msg "Wi-Fi" "\ZbConnected\Zn to \"$choice\".\n\nAddress: $(sed -n 's/^ip_address=//p' <<< "$st")"
            return
        fi
        sleep 1
    done
    if grep -q '^wpa_state=COMPLETED' <<< "$st"; then
        kb_msg "Wi-Fi" "Connected to \"$choice\", still waiting for an address from the network."
    else
        kb_msg "Wi-Fi" "\Z1Could not connect\Zn to \"$choice\".\n\nCheck the password and try again."
        wcli remove_network "$id" >/dev/null
        wcli save_config >/dev/null
    fi
}

wifi_forget() {
    local items=() id ssid rest choice
    while IFS=$'\t' read -r id ssid rest; do
        [[ $id =~ ^[0-9]+$ ]] && items+=("$id" "$ssid")
    done < <(wcli list_networks)
    if [ ${#items[@]} -eq 0 ]; then kb_msg "Wi-Fi" "No saved networks."; return; fi
    choice=$(kb_dialog --title " Saved Networks " --ok-label "Forget" --cancel-label "Back" \
        --menu "Choose a network to forget:" 18 60 10 "${items[@]}") || return
    wcli remove_network "$choice" >/dev/null
    wcli save_config >/dev/null
}

wifi_panel() {
    local sel toggle
    while true; do
        if wifi_is_on; then toggle="Turn Wi-Fi off"; else toggle="Turn Wi-Fi on"; fi
        sel=$(kb_dialog --title " Wi-Fi " --ok-label "Select" --cancel-label "Back" \
            --menu "$(wifi_status_text)" 14 64 4 \
            Toggle  "$toggle" \
            Connect "Connect to a network" \
            Forget  "Forget a saved network") || return
        case $sel in
            Toggle)
                if wifi_is_on; then $ROOT wifi off; else $ROOT wifi on; sleep 2; fi ;;
            Connect | Forget)
                if ! IF=$(wifi_iface); then kb_msg "Wi-Fi" "\Z1No Wi-Fi adapter found.\Zn\n\nThe adapter may need firmware that is not included."; continue; fi
                wifi_is_on || { $ROOT wifi on; sleep 2; }
                if [ "$sel" = Connect ]; then wifi_connect; else wifi_forget; fi ;;
        esac
    done
}

network_panel() {
    local text gw dns
    gw=$(ip route show default 2>/dev/null | awk '{print $3; exit}')
    dns=$(awk '/^nameserver/ {print $2}' /etc/resolv.conf 2>/dev/null | tr '\n' ' ')
    local d links=""
    # Real adapters only: those with a device behind them.
    for d in /sys/class/net/*; do
        [ -e "$d/device" ] && links+="  $(ip -br addr show dev "$(basename "$d")" 2>/dev/null)\n"
    done
    text="\ZbConnections\Zn\n${links:-  none\n}\n"
    text+="\ZbGateway\Zn   ${gw:-none}\n\ZbDNS\Zn       ${dns:-none}\n\n"
    text+="$(wifi_status_text)\n\nCable connections are set up automatically."
    kb_dialog --title " Network " --ok-label "Close" --extra-button --extra-label "Test" \
        --msgbox "$text" 20 72
    if [ $? -eq "$DIALOG_EXTRA" ]; then
        kb_info "Testing the connection to the Internet..."
        if ping -c 2 -W 3 deb.debian.org >/dev/null 2>&1; then
            kb_msg "Network" "\ZbThe Internet can be reached.\Zn"
        else
            kb_msg "Network" "\Z1\ZbThe Internet cannot be reached.\Zn\n\nPlug in a cable or connect to Wi-Fi."
        fi
    fi
}

# --- Appearance: colour themes, and your own (the theme editor) -----------
# Your themes are made by py/themes.py, in $KB_CONF/themes/my-NAME.

THEMES_PY="$KB_LIB/py/themes.py"
MY_THEMES="$KB_CONF/themes"
COLOUR_NAMES=(black red green brown blue magenta cyan lightgrey
              darkgrey lightred lightgreen yellow lightblue lightmagenta lightcyan white)
COLOUR_BASE=(BLACK RED GREEN YELLOW BLUE MAGENTA CYAN WHITE)

theme_title() { cat "$1/name" 2>/dev/null || basename "$1"; }

# colour_words FG,BG,BRIGHT: "lightcyan on blue"
colour_words() {
    local fg bg on i f=0 b=0
    IFS=, read -r fg bg on <<< "$1"
    for i in "${!COLOUR_BASE[@]}"; do
        [ "${COLOUR_BASE[i]}" = "$fg" ] && f=$i
        [ "${COLOUR_BASE[i]}" = "$bg" ] && b=$i
    done
    [ "$on" = ON ] && f=$(( f + 8 ))
    echo "${COLOUR_NAMES[f]} on ${COLOUR_NAMES[b]}"
}

# colour_pick TITLE FG,BG,BRIGHT: prints the new FG,BG,BRIGHT
colour_pick() {
    local title=$1 fg bg on f=0 b=0 i items=()
    IFS=, read -r fg bg on <<< "$2"
    for i in "${!COLOUR_BASE[@]}"; do
        [ "${COLOUR_BASE[i]}" = "$fg" ] && f=$i
        [ "${COLOUR_BASE[i]}" = "$bg" ] && b=$i
    done
    [ "$on" = ON ] && f=$(( f + 8 ))
    for i in "${!COLOUR_NAMES[@]}"; do
        items+=("$i" "${COLOUR_NAMES[i]}" "$([ "$i" = "$f" ] && echo on || echo off)")
    done
    f=$(kb_dialog --title " $title: text " --no-tags --ok-label "Next" --cancel-label "Back" \
        --radiolist "The colour of the text (Space selects):" 0 46 0 "${items[@]}") || return 1
    items=()
    for i in 0 1 2 3 4 5 6 7; do
        items+=("$i" "${COLOUR_NAMES[i]}" "$([ "$i" = "$b" ] && echo on || echo off)")
    done
    b=$(kb_dialog --title " $title: background " --no-tags --ok-label "Use" --cancel-label "Back" \
        --radiolist "The colour behind it (8 to choose from, as on a DOS screen):" 0 46 0 "${items[@]}") || return 1
    printf '%s,%s,%s\n' "${COLOUR_BASE[f & 7]}" "${COLOUR_BASE[b]}" "$([ "$f" -ge 8 ] && echo ON || echo OFF)"
}

theme_set() { # theme_set ID KEY VALUE
    python3 "$THEMES_PY" set "$MY_THEMES/$1" "$2" "$3" 2>/dev/null ||
        kb_msg "Theme Editor" "That could not be changed." 7 44
}

# palette_edit ID: the 16 exact colours of the Linux console
palette_edit() {
    local id=$1 p sel items i c
    while true; do
        p=$(python3 "$THEMES_PY" get "$MY_THEMES/$id" | sed -n 's/^palette=//p')
        [ -n "$p" ] || p=$(tr '\n' ' ' < "$KB_SHARE/themes/classic/palette" | xargs)
        read -ra c <<< "$p"
        items=()
        for i in "${!COLOUR_NAMES[@]}"; do items+=("$i" "$(printf '%-14s #%s' "${COLOUR_NAMES[i]}" "${c[i]}")"); done
        items+=(Standard "Back to the standard colours")
        sel=$(kb_dialog --title " Exact Colours " --no-tags --ok-label "Change" --cancel-label "Back" --menu \
"What each of the 16 colours really looks like, as hex RGB (ff8800 is orange).
Only the Linux console can change them; other terminals keep their own." 0 60 0 "${items[@]}") || return
        if [ "$sel" = Standard ]; then
            theme_set "$id" palette ""
            kb_palette ""
            continue
        fi
        i=$(kb_input "Exact Colours" "${COLOUR_NAMES[sel]}: six hex digits, red green blue (00 to ff each):" "${c[sel]}") || continue
        i=${i#\#}
        [[ $i =~ ^[0-9a-fA-F]{6}$ ]] || { kb_msg "Exact Colours" "Six hex digits, such as ff8800." 7 44; continue; }
        c[sel]=$i
        theme_set "$id" palette "${c[*]}"
        kb_palette "$MY_THEMES/$id/palette"
    done
}

# theme_edit ID: change a theme of your own. The editor's screens use that
# theme, so every change shows at once.
theme_edit() {
    local id=$1 d="$MY_THEMES/$1" sel=dialog items k v label skins s
    local -A val
    while true; do
        val=()
        while IFS='=' read -r k v; do val[$k]=$v; done < <(python3 "$THEMES_PY" get "$d")
        export DIALOGRC="$d/dialogrc"
        kb_palette "$d/palette"
        items=(Name "Name: ${val[name]}")
        while IFS='|' read -r k label; do
            items+=("$k" "$(printf '%-28s %s' "$label" "$(colour_words "${val[$k]}")")")
        done < <(python3 "$THEMES_PY" roles)
        items+=(Shadow "Shadows under windows: ${val[shadow]}"
                Files  "File manager look: ${val[mc]}"
                Exact  "Exact colours: $([ -n "${val[palette]:-}" ] && [ "${val[palette]}" != "$(tr '\n' ' ' < "$KB_SHARE/themes/classic/palette" | xargs)" ] && echo "your own" || echo standard)"
                Use    "Use this theme")
        sel=$(kb_dialog --title " Theme Editor: ${val[name]} " --no-tags --default-item "$sel" \
            --ok-label "Change" --cancel-label "Done" --menu \
            "Choose a part to colour. This screen shows the theme as it is now." 0 72 0 "${items[@]}") || break
        case $sel in
            Name)   v=$(kb_input "Theme Name" "Name of the theme:" "${val[name]}") && [ -n "$v" ] && theme_set "$id" name "$v" ;;
            Shadow) theme_set "$id" shadow "$([ "${val[shadow]}" = ON ] && echo OFF || echo ON)" ;;
            Files)
                skins=()
                for s in default dark darkfar double-lines gotar mc46 nicedark; do
                    skins+=("$s" "" "$([ "$s" = "${val[mc]}" ] && echo on || echo off)")
                done
                v=$(kb_dialog --title " File Manager Look " --ok-label "Use" --cancel-label "Back" --radiolist \
                    "The colours of the file manager (mc skins):" 0 50 0 "${skins[@]}") && theme_set "$id" mc "$v" ;;
            Exact)  palette_edit "$id" ;;
            Use)    echo "$id" > "$KB_CONF/theme"; break ;;
            *)      v=$(colour_pick "$(python3 "$THEMES_PY" roles | sed -n "s/^$sel|//p")" "${val[$sel]}") &&
                        theme_set "$id" "$sel" "$v" ;;
        esac
    done
    kb_load_theme                                   # back to the theme in use
}

# my_theme_pick TITLE: one of your own themes, or nothing
my_theme_pick() {
    local items=() d
    for d in "$MY_THEMES"/my-*/; do
        [ -f "$d/theme.conf" ] && items+=("$(basename "$d")" "$(theme_title "$d")")
    done
    [ ${#items[@]} -gt 0 ] || { kb_msg "$1" "You have not made a theme yet. Choose New." 7 50; return 1; }
    kb_dialog --title " $1 " --no-tags --ok-label "Select" --cancel-label "Back" \
        --menu "Your themes:" 0 50 0 "${items[@]}"
}

# The gallery: https://jgm240.github.io/kilobyte/themes.html. A theme travels
# as a short code (py/themes.py code); approved ones are listed in
# themes/gallery.json on the website's branch.
GALLERY=https://jgm240.github.io/kilobyte/themes.html
GALLERY_JSON=https://raw.githubusercontent.com/jgm240/kilobyte/gh-pages/themes/gallery.json

theme_upload() {
    local id code by url q
    id=$(my_theme_pick "Upload to the Gallery") || return
    by=$(kb_input "Upload to the Gallery" "Your name or nickname in the gallery (or nothing):" "") || return
    by=$(printf '%s' "$by" | tr -cd '[:alnum:] ._-' | cut -c1-30)
    code=$(python3 "$THEMES_PY" code "$MY_THEMES/$id") || return
    url="$GALLERY?add=$code${by:+&by=$(python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1]))' "$by")}"
    clear
    printf '
  [1mUpload "%s" to the gallery[0m

' "$(theme_title "$MY_THEMES/$id")"
    printf '  Open this on a phone or computer: it shows your theme, and "Submit to the
'
    printf '  gallery" sends it (with a GitHub account). Once it is approved, everyone
'
    printf '  can get it, also from Settings > Colour theme > Theme editor > Gallery.

'
    if command -v qrencode >/dev/null; then
        qrencode -t UTF8 -m 2 -l L "$url" | sed 's/^/  /'
    fi
    printf '
  %s

' "$url"
    printf '[7m Enter: done   W: open it here in the web browser [0m'
    read -r -n 1 q
    case $q in w | W) "$KB_LIB/kb-link" "$url" ;; esac
    kb_load_theme
}

theme_gallery() {
    local items=() n name by code sel id i=0
    getent hosts raw.githubusercontent.com >/dev/null 2>&1 || { kb_msg "Gallery" "Not connected to the Internet." 7 40; return; }
    kb_info "Looking at the gallery..."
    curl -fsS --max-time 30 "$GALLERY_JSON" 2>/dev/null | python3 -c 'import json, sys, re
for t in json.load(sys.stdin):
    c = str(t.get("code", ""))
    if re.fullmatch(r"[A-Za-z0-9_-]{20,200}", c):
        print("%s	%s	%s" % (c, re.sub(r"[	
]", " ", str(t.get("name", "")))[:40], re.sub(r"[	
]", " ", str(t.get("by", "")))[:30]))'         > "$TMP_G" 2>/dev/null
    while IFS=$'	' read -r code name by; do
        i=$((i + 1))
        items+=("$i" "$(printf '%-30s %s' "$name" "${by:+by $by}")")
    done < "$TMP_G"
    [ ${#items[@]} -gt 0 ] || { kb_msg "Gallery" "The gallery is empty, or could not be reached. ($GALLERY)" 8 64; return; }
    sel=$(kb_dialog --title " The Theme Gallery " --ok-label "Get it" --cancel-label "Back" --menu         "Themes people made (see them at $GALLERY):" 0 70 0 "${items[@]}") || return
    code=$(sed -n "${sel}p" "$TMP_G" | cut -f1)
    mkdir -p "$MY_THEMES"
    if id=$(python3 "$THEMES_PY" fromcode "$code" "$MY_THEMES" 2>&1); then
        kb_yesno "Gallery" "\Zb$(theme_title "$MY_THEMES/$id")\Zn is one of your themes now.\n\nUse it?" 9 56 &&
            { echo "$id" > "$KB_CONF/theme"; kb_load_theme; }
    else
        kb_msg "Gallery" "\Z1$id\Zn" 7 50
    fi
}
TMP_G=$(mktemp)
trap 'rm -f "$TMP_G"' EXIT

theme_editor() { # theme_editor BASE: the theme to start a new one from
    local base=$1 sel name id f bd
    case $base in my-*) bd="$MY_THEMES/$base" ;; *) bd="$KB_SHARE/themes/$base" ;; esac
    [ -f "$bd/dialogrc" ] || bd="$KB_SHARE/themes/classic"
    while true; do
        sel=$(kb_dialog --title " Theme Editor " --ok-label "Select" --cancel-label "Back" --menu \
"Make colour themes of your own, and share them as small files." 14 66 5 \
            New    "A new theme, starting from $(theme_title "$bd")" \
            Edit   "Change one of your themes" \
            Import "Add a theme someone gave you (a .kbtheme file)" \
            Export "Save one of yours in Documents, to give away" \
            Upload "Upload one of yours to the gallery (on Kilobyte's website)" \
            Gallery "Get a theme from the gallery" \
            Delete "Delete one of your themes") || return
        case $sel in
            New)
                name=$(kb_input "New Theme" "Name of your theme:" "My $(theme_title "$bd")") && [ -n "$name" ] || continue
                mkdir -p "$MY_THEMES"
                id=$(python3 "$THEMES_PY" folder "$name" "$MY_THEMES")
                python3 "$THEMES_PY" new "$bd" "$MY_THEMES/$id" "$name" && theme_edit "$id" ;;
            Edit)   id=$(my_theme_pick "Edit a Theme") && theme_edit "$id" ;;
            Import)
                f=$(kb_dialog --title " Import a Theme " --fselect "$KB_DOCS/" 14 64) || continue
                [ -f "$f" ] || { kb_msg "Import" "\"$f\" is not a file."; continue; }
                mkdir -p "$MY_THEMES"
                if id=$(python3 "$THEMES_PY" import "$f" "$MY_THEMES" 2>&1); then
                    kb_yesno "Import" "\Zb$(theme_title "$MY_THEMES/$id")\Zn is one of your themes now.\n\nUse it?" 9 56 &&
                        { echo "$id" > "$KB_CONF/theme"; kb_load_theme; }
                else
                    kb_msg "Import" "\Z1$(tail -n 1 <<< "$id")\Zn" 7 50
                fi ;;
            Export)
                id=$(my_theme_pick "Export a Theme") || continue
                mkdir -p "$KB_DOCS"
                name=$(theme_title "$MY_THEMES/$id" | tr -cd 'A-Za-z0-9 ._-')
                f="$KB_DOCS/${name:-$id}.kbtheme"
                python3 "$THEMES_PY" export "$MY_THEMES/$id" "$f" &&
                    kb_msg "Export" "Saved as\n\n  \Zb${f#"$HOME"/}\Zn\n\nGive this file to someone: they choose Import in their theme editor." 11 64 ;;
            Upload)  theme_upload ;;
            Gallery) theme_gallery ;;
            Delete)
                id=$(my_theme_pick "Delete a Theme") || continue
                kb_yesno "Delete" "Delete the theme \Zb$(theme_title "$MY_THEMES/$id")\Zn?" 7 56 || continue
                rm -rf "${MY_THEMES:?}/$id"
                [ "$(kb_theme_name)" = classic ] && [ "$(cat "$KB_CONF/theme" 2>/dev/null)" = "$id" ] && echo classic > "$KB_CONF/theme"
                kb_load_theme ;;
        esac
    done
}

appearance_panel() {
    local cur items d t rc
    while true; do
        cur=$(kb_theme_name)
        items=()
        for d in "$KB_SHARE"/themes/*/ "$MY_THEMES"/my-*/; do
            [ -f "$d/dialogrc" ] || continue
            t=$(basename "$d")
            items+=("$t" "$(theme_title "$d")$([[ $t == my-* ]] && echo "  (yours)")" "$([ "$t" = "$cur" ] && echo on || echo off)")
        done
        t=$(kb_dialog --title " Appearance " --no-tags --ok-label "Apply" --extra-button --extra-label "Theme editor" \
            --cancel-label "Back" --radiolist "Colour theme (Space selects):" 18 64 10 "${items[@]}")
        rc=$?
        case $rc in
            "$DIALOG_OK")    [ -n "$t" ] && echo "$t" > "$KB_CONF/theme"; kb_load_theme; return ;;
            "$DIALOG_EXTRA") theme_editor "${t:-$cur}" ;;
            *)               return ;;
        esac
    done
}

# --- Display --------------------------------------------------------------

# --- Wallpaper: the desktop behind the windows of Kilobyte Desktop -------------
# Kept in $KB_CONF/wallpaper (see py/deskbg.py), which Kilobyte Desktop reads
# again whenever it changes.

wp_get() { sed -n "s/^$1=//p" "$KB_CONF/wallpaper" 2>/dev/null | tail -n 1; }

wp_set() { # wp_set KEY VALUE [KEY VALUE ...]
    local f="$KB_CONF/wallpaper" k
    touch "$f"
    while [ $# -ge 2 ]; do
        k=$1
        { grep -v "^$k=" "$f"; printf '%s=%s\n' "$k" "$2"; } > "$f.new" && mv "$f.new" "$f"
        shift 2
    done
}

wp_colour() { # wp_colour TITLE CURRENT [BACKGROUND] -> name
    local items=() c names="black red green brown blue magenta cyan lightgrey"
    [ -z "${3:-}" ] && names="$names darkgrey lightred lightgreen yellow lightblue lightmagenta lightcyan white"
    for c in $names; do
        items+=("$c" "" "$([ "$c" = "$2" ] && echo on || echo off)")
    done
    kb_dialog --title " $1 " --ok-label "Use" --cancel-label "Back" --no-tags --radiolist \
        "Space selects, Enter uses it." 0 40 0 "${items[@]}"
}

wallpaper_panel() {
    local sel style pattern text picture fg bg what items p label
    while true; do
        style=$(wp_get style) pattern=$(wp_get pattern) text=$(wp_get text) picture=$(wp_get picture)
        fg=$(wp_get fg) bg=$(wp_get bg)
        case ${style:-pattern} in
            text)    what="Characters: ${text:-Kilobyte }" ;;
            picture) what="Picture: $(basename "${picture:-none}")" ;;
            *)       what="Pattern: ${pattern:-classic}" ;;
        esac
        sel=$(kb_dialog --title " Wallpaper " --ok-label "Select" --cancel-label "Back" --menu \
"The desktop behind the windows of Kilobyte Desktop.
Now: $what" 0 66 0 \
            Pattern    "A pattern of blocks, lines or symbols" \
            Characters "Your own characters, repeated" \
            Picture    "A picture, drawn with coloured blocks" \
            Colour     "Colour of the pattern: ${fg:-lightgrey}" \
            Background "Colour behind it: ${bg:-blue}" \
            Reset      "Back to the classic blue desktop") || return
        case $sel in
            Pattern)
                items=()
                while IFS='|' read -r p label; do
                    items+=("$p" "$label" "$([ "$p" = "${pattern:-classic}" ] && [ "${style:-pattern}" = pattern ] && echo on || echo off)")
                done < <(python3 -c 'import sys; sys.path.insert(0, "/usr/lib/kilobyte/py"); import deskbg
for k, (label, _) in deskbg.PATTERNS.items(): print(k + "|" + label)')
                p=$(kb_dialog --title " Pattern " --ok-label "Use" --cancel-label "Back" --no-tags --radiolist \
                    "Space selects, Enter uses it." 0 50 0 "${items[@]}") && wp_set style pattern pattern "$p" ;;
            Characters)
                text=$(kb_input "Wallpaper" "Characters to repeat over the desktop\n(a word, a name, symbols from the Character Map):" "${text:-Kilobyte }") &&
                    [ -n "$text" ] && wp_set style text text "$text" ;;
            Picture)
                p=$(kb_dialog --title " Wallpaper - Picture " --fselect "${picture:-$HOME/Pictures/}" 14 64) || continue
                if [ -f "$p" ]; then
                    wp_set style picture picture "$p"
                else
                    kb_msg "Wallpaper" "\"$p\" is not a file."
                fi ;;
            Colour)     p=$(wp_colour "Pattern Colour" "${fg:-lightgrey}") && wp_set fg "$p" ;;
            Background) p=$(wp_colour "Background Colour" "${bg:-blue}" bg) && wp_set bg "$p" ;;
            Reset)      rm -f "$KB_CONF/wallpaper" ;;
        esac
    done
}

# --- Swap: compressed memory, a swap file, how readily to swap -----------------
# The work is done by kb-swap (as root, after asking for the password).

swap_get() { sed -n "s/^$1=//p" <<< "$SWAP_STATUS" | tail -n 1; }

swap_mb() { echo "$(( ${1:-0} / 1024 )) MB"; }

swap_do() { # swap_do ARGS...: run kb-swap as root, show what went wrong
    local out
    kb_sudo || return 1
    kb_dialog --title " Swap " --infobox "Working ..." 5 40
    if ! out=$(sudo "$KB_LIB/kb-swap" "$@" 2>&1); then
        kb_msg "Swap" "That did not work:\n\n${out:-unknown error}" 12 66
        return 1
    fi
}

swap_panel() {
    local sel zram zact file possible swp total used zlabel flabel slabel v mem
    while true; do
        SWAP_STATUS=$("$KB_LIB/kb-swap" status 2>/dev/null)
        zram=$(swap_get zram) zact=$(swap_get zram_active) file=$(swap_get file_mb)
        possible=$(swap_get file_possible) swp=$(swap_get swappiness)
        mem=$(swap_get memory_kb) total=$(swap_get swap_total_kb)
        used=$(( ${total:-0} - $(swap_get swap_free_kb) ))
        if [ -n "$zram" ]; then
            zlabel="ON, $zram% of the memory$([ "$zact" = yes ] || echo " (from the next start)")"
        else
            zlabel="OFF"
        fi
        if [ -n "$file" ]; then flabel="$file MB"
        elif [ "$possible" = yes ]; then flabel="OFF"
        else flabel="not on the live system"
        fi
        case $swp in
            ''|*[!0-9]*) slabel="?" ;;
            *) if   [ "$swp" -le 20 ];  then slabel="only when memory is nearly full ($swp)"
               elif [ "$swp" -le 80 ];  then slabel="normally ($swp)"
               else                          slabel="early ($swp)"
               fi ;;
        esac
        sel=$(kb_dialog --title " Swap " --ok-label "Select" --cancel-label "Back" --menu \
"Swap gives programs more room than the memory has.
Memory: $(swap_mb "$mem"), $(swap_mb "$(swap_get available_kb)") free.   Swap: $(swap_mb "$total"), $(swap_mb "$used") in use." 0 72 0 \
            Compressed "Compressed memory (zram): $zlabel" \
            File       "Swap file on the disk: $flabel" \
            Eagerness  "Use swap: $slabel" \
            Details    "What is in use right now") || return
        case $sel in
            Compressed)
                v=$(kb_dialog --title " Compressed Memory " --ok-label "Use" --cancel-label "Back" --no-tags --radiolist \
"Pages that are not needed at the moment are kept compressed in
memory instead of on a disk: fast, no wear on SD cards and sticks,
and it works on the live system. Good for computers with little
memory; it costs a little processor time." 17 70 5 \
                    off "Off"                        "$([ -z "$zram" ] && echo on || echo off)" \
                    25  "A quarter of the memory"    "$([ "$zram" = 25 ] && echo on || echo off)" \
                    50  "Half of the memory (usual)" "$([ "$zram" = 50 ] && echo on || echo off)" \
                    100 "As much as the memory"      "$([ "$zram" = 100 ] && echo on || echo off)" \
                    150 "One and a half times"       "$([ "$zram" = 150 ] && echo on || echo off)") || continue
                swap_do zram "$v" ;;
            File)
                if [ "$possible" != yes ]; then
                    kb_msg "Swap File" "The live system runs from memory, so a swap file would be in memory too.\n\nInstall Kilobyte to a disk first, or use compressed memory." 10 64
                    continue
                fi
                v=$(kb_dialog --title " Swap File " --ok-label "Use" --cancel-label "Back" --no-tags --radiolist \
"A file on the disk (/swapfile) for what does not fit in memory.
Slower than memory, and on an SD card it wears the card; with
compressed memory on, it is only used when that is full." 17 70 6 \
                    off   "Off"                  "$([ -z "$file" ] && echo on || echo off)" \
                    512   "512 MB"               "$([ "$file" = 512 ] && echo on || echo off)" \
                    1024  "1 GB"                 "$([ "$file" = 1024 ] && echo on || echo off)" \
                    2048  "2 GB"                 "$([ "$file" = 2048 ] && echo on || echo off)" \
                    4096  "4 GB"                 "$([ "$file" = 4096 ] && echo on || echo off)" \
                    other "Another size ..."     off) || continue
                if [ "$v" = other ]; then
                    v=$(kb_input "Swap File" "Size in megabytes (64 to 65536):" "${file:-1024}") || continue
                    case $v in ''|*[!0-9]*) kb_msg "Swap File" "\"$v\" is not a number."; continue ;; esac
                fi
                swap_do file "$v" ;;
            Eagerness)
                v=$(kb_dialog --title " Use Swap " --ok-label "Use" --cancel-label "Back" --no-tags --radiolist \
"How readily the computer moves things out of memory
(the kernel's \"swappiness\")." 14 70 4 \
                    10  "Only when memory is nearly full"          "$([ "$swp" = 10 ] && echo on || echo off)" \
                    60  "Normally"                                  "$([ "$swp" = 60 ] && echo on || echo off)" \
                    100 "Early (good with compressed memory)"       "$([ "$swp" = 100 ] && echo on || echo off)" \
                    180 "Very early (compressed memory only)"       "$([ "$swp" = 180 ] && echo on || echo off)") || continue
                swap_do swappiness "$v" ;;
            Details)
                v=$( { echo "Swap areas in use:"; echo
                       swapon --show=NAME,TYPE,SIZE,USED,PRIO 2>/dev/null | sed 's/^/  /'
                       [ -n "$(swapon --noheadings 2>/dev/null)" ] || echo "  (none)"
                       echo; echo "Compressed memory:"; echo
                       zramctl 2>/dev/null | sed 's/^/  /' | cut -c1-70
                       [ -n "$(zramctl --noheadings 2>/dev/null)" ] || echo "  (not in use)"
                       echo; free -h | sed 's/^/  /'; } 2>&1 )
                kb_msg "Swap" "$v" 0 0 ;;
        esac
    done
}

display_panel() {
    local sel face size font
    sel=$(kb_dialog --title " Display " --ok-label "Apply" --cancel-label "Back" \
        --menu "Console font. Bigger fonts help on high resolution screens." 15 64 6 \
        VGA16   "Classic VGA 8x16 (like DOS)" \
        VGA32   "Classic VGA 16x32 (big)" \
        Term16  "Terminus 8x16 (sharp)" \
        Term24  "Terminus 12x24 (large)" \
        Term32  "Terminus 16x32 (huge)") || return
    case $sel in
        VGA16)  font=Kilobyte-VGA16.psf.gz;    face=VGA;      size=8x16 ;;
        VGA32)  font=Kilobyte-VGA32x16.psf.gz; face=VGA;      size=16x32 ;;
        Term16) font="";                       face=Terminus; size=8x16 ;;
        Term24) font="";                       face=Terminus; size=12x24 ;;
        Term32) font="";                       face=Terminus; size=16x32 ;;
    esac
    # VGA: Kilobyte's merged VGA font (FONT wins over the other settings).
    kb_sudo || return
    sudo sed -i -e "s/^FONT=.*/FONT=\"$font\"/" -e "s/^CODESET=.*/CODESET=\"Uni2\"/" \
        -e "s/^FONTFACE=.*/FONTFACE=\"$face\"/" -e "s/^FONTSIZE=.*/FONTSIZE=\"$size\"/" /etc/default/console-setup
    grep -q '^FONT=' /etc/default/console-setup || echo "FONT=\"$font\"" | sudo tee -a /etc/default/console-setup >/dev/null
    sudo setupcon --save-only --force 2>/dev/null   # keep it after a restart
    [ "$TERM" = linux ] && sudo setupcon --force --font-only 2>/dev/null
    kb_msg "Display" "The console font is now $face $size."
}

# --- Accessibility: a screen reader (Speakup with espeakup), braille
# displays (brltty), large letters and high contrast --------------------------

VOICES=(en "English" en-US "English (American)" de "Deutsch" fr "Français" es "Español"
        es-419 "Español (Latinoamérica)" it "Italiano" nl "Nederlands" pt "Português"
        pt-BR "Português (Brasil)" pl "Polski" cs "Čeština" sk "Slovenčina" hu "Magyar"
        ro "Română" hr "Hrvatski" sl "Slovenščina" sv "Svenska" da "Dansk" nb "Norsk"
        fi "Suomi" el "Ελληνικά" tr "Türkçe" ru "Русский" uk "Українська" bg "Български")

access_panel() {
    local sel speech braille rate voice
    while true; do
        speech=OFF braille=OFF
        [ -e /etc/kilobyte/speech-on ] && speech=ON
        [ -e /etc/kilobyte/braille-on ] && braille=ON
        systemctl -q is-active espeakup.service 2>/dev/null && [ $speech = OFF ] && speech="on for now"
        systemctl -q is-active brltty.service 2>/dev/null && [ $braille = OFF ] && braille="on for now"
        rate=$(cat /etc/kilobyte/speech-rate 2>/dev/null || echo 5)
        voice=$(sed -n 's/^default_voice=//p' /etc/default/espeakup 2>/dev/null)
        sel=$(kb_dialog --title " Accessibility " --default-item "${sel:-Speech}" --ok-label "Select" --cancel-label "Back" --menu \
"For people who cannot see the screen well, or at all. At start-up,
\"Kilobyte with speech\" in the boot menu (or the S key there) speaks
from the first screen on." 0 70 0 \
            Speech   "Screen reader (speech): $speech" \
            Voice    "Language of the voice: ${voice:-en}" \
            Speed    "Speed of speech: $rate (1 slow, 9 fast)" \
            Braille  "Braille display: $braille" \
            Letters  "Large letters" \
            Contrast "High contrast (black and white)" \
            Keys     "How to use the screen reader") || return
        # (Not on the CD version: downloaded with kbutils dl accessibility.)
        if [[ $sel == Speech || $sel == Voice || $sel == Speed || $sel == Braille ]] && ! command -v espeakup >/dev/null; then
            kb_yesno "Accessibility" "The screen reader is not installed on this computer.\n\nDownload it now? (About 36 MB; needs the Internet.)" 9 60 &&
                kb_run_pause /usr/bin/kbutils dl accessibility
            continue
        fi
        case $sel in
            Speech)
                if [ "$speech" = ON ]; then
                    sudo -n "$KB_LIB/kb-root" speech off
                    continue
                fi
                kb_info "Starting speech..."
                sudo -n "$KB_LIB/kb-root" speech on >/dev/null 2>&1
                sleep 2
                if ! systemctl -q is-active espeakup.service; then
                    sudo -n "$KB_LIB/kb-root" speech off
                    kb_msg "Accessibility" "\Z1Speech could not start.\Zn\n\nIt needs a sound card (or headphones), and Speakup in the computer's Linux kernel." 10 64
                elif [ ! -e "$KB_CONF/windows-off" ]; then
                    : > "$KB_CONF/windows-off"
                    kb_msg "Accessibility" "Speech is on.\n\nKilobyte starts without windows from now on: a screen reader follows one program at a time best. (Settings > Windows can turn them on again.)" 11 64
                fi ;;
            Voice)
                local items=() i
                for ((i = 0; i < ${#VOICES[@]}; i += 2)); do
                    items+=("${VOICES[i]}" "${VOICES[i+1]}" "$([ "${VOICES[i]}" = "${voice:-en}" ] && echo on || echo off)")
                done
                voice=$(kb_dialog --title " Voice " --ok-label "Use" --cancel-label "Back" --radiolist \
                    "The language the screen reader speaks (Space selects):" 0 50 0 "${items[@]}") &&
                    sudo -n "$KB_LIB/kb-root" speech voice "$voice" ;;
            Speed)
                rate=$(kb_dialog --title " Speed of Speech " --ok-label "Use" --cancel-label "Back" \
                    --rangebox "From 1 (slow) to 9 (fast); the arrow keys change it:" 7 60 1 9 "$rate") &&
                    sudo -n "$KB_LIB/kb-root" speech rate "$rate" ;;
            Braille)
                if [ "$braille" = ON ]; then
                    sudo -n "$KB_LIB/kb-root" braille off
                else
                    sudo -n "$KB_LIB/kb-root" braille on >/dev/null 2>&1
                    kb_msg "Accessibility" "Braille is on: plug in a braille display (USB). brltty finds most of them by itself, and shows the line the cursor is on." 9 64
                fi ;;
            Letters)  display_panel ;;
            Contrast) echo mono > "$KB_CONF/theme"; kb_load_theme
                      kb_msg "Accessibility" "The colours are black and white now. Settings > Colour theme brings others back." 8 60 ;;
            Keys)     kb_msg "The Screen Reader" "Kilobyte reads what is chosen in its menus aloud, and what programs write.

On the number pad (with Num Lock off):
  7  8  9    the line above, this line, the line below
  4  5  6    the word before, this word, the next word
  1  2  3    the letter before, this letter, the next one

Insert on the number pad is the screen reader's own key:
  Insert + F1   its help, with all of its keys

The arrow keys and the first letters choose in the menus,
Enter opens, Esc goes back." 20 66 ;;
        esac
    done
}

# --- The mouse pointer of Kilobyte Desktop: any character(s), in any colours.
# Kept in $KB_CONF/pointer (chars, fg, bg, hotspot); py/desk.py draws it.

pointer_panel() {
    local f="$KB_CONF/pointer" sel chars fg bg hot size p items c
    pget() { sed -n "s/^$1=//p" "$f" 2>/dev/null | tail -n 1; }
    pset() { # pset KEY VALUE [KEY VALUE ...]
        local k
        touch "$f"
        while [ $# -ge 2 ]; do
            k=$1
            { grep -v "^$k=" "$f"; printf '%s=%s\n' "$k" "$2"; } > "$f.new" && mv "$f.new" "$f"
            shift 2
        done
    }
    while true; do
        chars=$(pget chars) fg=$(pget fg) bg=$(pget bg) hot=$(pget hotspot) size=$(pget size)
        sel=$(kb_dialog --title " Mouse Pointer " --ok-label "Select" --cancel-label "Back" --menu \
"How the mouse pointer looks in Kilobyte Desktop (with windows).
Now: $([ -n "$chars" ] && echo "\"$chars\" in ${fg:-white} on ${bg:-what is under it}" || echo "the classic block (the colours swapped)")
(Without windows, the text console's own block pointer shows.)" 0 70 0 \
            Pick    "Choose a pointer" \
            Own     "Type your own: any characters (up to 8)" \
            Colour  "Its colour: ${fg:-white}" \
            Behind  "Behind it: ${bg:-what is under it}" \
            Size    "Size: ${size:-1} ($([ "${size:-1}" = 1 ] && echo "one row" || echo "an arrow ${size} rows tall"))" \
            Point   "It points with its $([ "$hot" = last ] && echo "last character (an arrow: to the right)" || echo "first character (an arrow: to the left)")" \
            Classic "Back to the classic block (the size stays)") || return
        case $sel in
            Pick)
                items=(arrow "▲   arrow" up "↑   arrow up" left "←   arrow left (points with ←)" ptr "<-  two characters"
                       ptr2 "->  points with its tip" dot "●   dot" ring "○   ring" diamond "♦   diamond"
                       smile "☺   smiley" heart "♥   heart" block "█   solid block" shade "▓   shaded block"
                       plus "+   cross" star "*   star" at "@   at" x "X   letter X")
                p=$(kb_dialog --title " Choose a Pointer " --no-tags --ok-label "Use" --cancel-label "Back" \
                    --menu "Characters every Kilobyte screen font has:" 0 50 0 "${items[@]}") || continue
                case $p in
                    arrow) pset chars "▲" hotspot first ;;   up) pset chars "↑" hotspot first ;;
                    left) pset chars "←" hotspot first ;;    ptr) pset chars "<-" hotspot first ;;
                    ptr2) pset chars "->" hotspot last ;;    dot) pset chars "●" hotspot first ;;
                    ring) pset chars "○" hotspot first ;;    diamond) pset chars "♦" hotspot first ;;
                    smile) pset chars "☺" hotspot first ;;   heart) pset chars "♥" hotspot first ;;
                    block) pset chars "█" hotspot first ;;   shade) pset chars "▓" hotspot first ;;
                    plus) pset chars "+" hotspot first ;;    star) pset chars "*" hotspot first ;;
                    at) pset chars "@" hotspot first ;;      x) pset chars "X" hotspot first ;;
                esac
                [ -n "$(pget fg)" ] || pset fg white ;;
            Own)
                c=$(kb_input "Your Pointer" "Any characters, up to 8 (from the Character Map, too).\nOn the text console only those in its font show:" "$chars") || continue
                c=${c:0:8}
                [ -n "$c" ] && pset chars "$c"
                [ -n "$(pget fg)" ] || pset fg white ;;
            Colour)
                [ -n "$chars" ] || { kb_msg "Mouse Pointer" "Choose a pointer first: the classic one has the colours under it." 8 56; continue; }
                c=$(wp_colour "Pointer Colour" "${fg:-white}") && pset fg "$c" ;;
            Behind)
                [ -n "$chars" ] || { kb_msg "Mouse Pointer" "Choose a pointer first." 7 40; continue; }
                items=(under "What is under it (see-through)" "$([ -z "$bg" ] || [ "$bg" = under ] && echo on || echo off)")
                for c in black red green brown blue magenta cyan lightgrey; do
                    items+=("$c" "" "$([ "$c" = "$bg" ] && echo on || echo off)")
                done
                c=$(kb_dialog --title " Behind the Pointer " --ok-label "Use" --cancel-label "Back" --radiolist \
                    "Space selects, Enter uses it." 0 50 0 "${items[@]}") && pset bg "$c" ;;
            Size)
                c=$(kb_dialog --title " Pointer Size " --rangebox \
"1: the pointer's characters as they are. 2 to 5: an arrow that many rows
tall, made of them (or, classic, of cells with their colours swapped):" 8 76 1 5 "${size:-1}") && pset size "$c" ;;
            Point)  pset hotspot "$([ "$hot" = last ] && echo first || echo last)" ;;
            Classic)
                if [ -n "$(pget size)" ] && [ "$(pget size)" != 1 ]; then
                    c=$(pget size); rm -f "$f"; pset size "$c"
                else
                    rm -f "$f"
                fi ;;
        esac
    done
}

