# --- Bluetooth -------------------------------------------------------------

bt() { bluetoothctl "$@" 2>/dev/null; }

bt_device() { # bt_device MAC NAME
    local mac=$1 name=$2 sel
    sel=$(kb_dialog --title " $name " --ok-label "Select" --cancel-label "Back" --menu "$mac" 14 60 5 \
        Connect    "Connect" \
        Disconnect "Disconnect" \
        Sound      "Play sound through it (headphones, speakers)" \
        Local      "Play sound through this computer again" \
        Remove     "Forget this device") || return
    case $sel in
        Connect)    kb_info "Connecting to $name..."; bt connect "$mac" >/dev/null ;;
        Disconnect) bt disconnect "$mac" >/dev/null ;;
        Sound)
            printf 'defaults.bluealsa.device "%s"\ndefaults.bluealsa.profile "a2dp"\npcm.!default bluealsa\nctl.!default bluealsa\n' "$mac" > "$HOME/.asoundrc"
            kb_msg "Bluetooth" "Sound now plays through \Zb$name\Zn." 7 56 ;;
        Local)      rm -f "$HOME/.asoundrc"; kb_msg "Bluetooth" "Sound plays through this computer again." 7 56 ;;
        Remove)     bt remove "$mac" >/dev/null ;;
    esac
}

bluetooth_panel() {
    local sel powered items=() mac name
    if ! bt show | grep -q Controller; then
        sudo -n "$KB_LIB/kb-root" bluetooth on >/dev/null 2>&1
        sleep 1
        bt show | grep -q Controller || { kb_msg "Bluetooth" "\Z1No Bluetooth adapter found.\Zn" 7 44; return; }
    fi
    while true; do
        powered=$(bt show | sed -n 's/.*Powered: //p' | head -n 1)
        items=(Power "Bluetooth is $([ "$powered" = yes ] && echo ON || echo OFF)" Find "Find and pair a new device")
        while read -r _ mac name; do items+=("$mac" "$name"); done < <(bt devices Paired)
        sel=$(kb_dialog --title " Bluetooth " --ok-label "Select" --cancel-label "Back" \
            --menu "Keyboards, mice, headphones and speakers:" 16 64 8 "${items[@]}") || return
        case $sel in
            Power)
                if [ "$powered" = yes ]; then bt power off >/dev/null; else sudo -n "$KB_LIB/kb-root" bluetooth on >/dev/null 2>&1; bt power on >/dev/null; fi ;;
            Find)
                bt power on >/dev/null
                kb_info "Searching for 12 seconds. Put your device into pairing mode now..."
                bt --timeout 12 scan on >/dev/null
                items=()
                while read -r _ mac name; do
                    [ "$name" = "${mac//:/-}" ] && continue    # nameless beacons
                    items+=("$mac" "$name")
                done < <(bt devices)
                [ ${#items[@]} -gt 0 ] || { kb_msg "Bluetooth" "No devices found." 7 40; continue; }
                mac=$(kb_dialog --title " Pair " --ok-label "Pair" --cancel-label "Back" --menu "Devices nearby:" 16 64 8 "${items[@]}") || continue
                kb_run_pause sh -c "echo 'Pairing. If a code appears, type it on the device and press Enter there.'; echo;
                    bluetoothctl --agent KeyboardDisplay pair $mac && bluetoothctl trust $mac && bluetoothctl connect $mac" ;;
            *)
                bt_device "$sel" "$(bt info "$sel" | sed -n 's/.*Name: //p')" ;;
        esac
    done
}

