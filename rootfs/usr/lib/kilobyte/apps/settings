# --- Printers --------------------------------------------------------------

printer_add() {
    local items=() kind uri name line
    kb_info "Looking for printers (10 seconds)..."
    while read -r kind uri; do
        case $uri in dnssd://* | ipp://* | ipps://* | usb://*) ;; *) continue ;; esac
        name=$(printf '%s' "${uri#*://}" | sed 's/%20/ /g; s/[._]*ipp.*//; s/[?/].*//' | cut -c1-40)
        items+=("$uri" "${name:-printer}")
    done < <(lpinfo --timeout 10 -v 2>/dev/null)
    items+=(address "Type the printer's network address")
    uri=$(kb_dialog --title " Add Printer " --ok-label "Add" --cancel-label "Back" \
        --menu "Printers found. Most printers made since about 2012 work without a driver." 16 76 8 "${items[@]}") || return
    if [ "$uri" = address ]; then
        line=$(kb_input "Add Printer" "Address of the printer (e.g. 192.168.1.40):" "") || return
        uri="ipp://$line/ipp/print"
    fi
    name=$(kb_input "Add Printer" "A short name for this printer (no spaces):" "Printer") || return
    name=$(printf '%s' "$name" | tr -cd 'A-Za-z0-9_-')
    kb_info "Setting up $name ..."
    if out=$(lpadmin -p "${name:-Printer}" -E -v "$uri" -m everywhere 2>&1); then
        lpoptions -d "${name:-Printer}" >/dev/null 2>&1
        kb_msg "Printers" "\Zb${name:-Printer} is ready\Zn and is now the default printer." 8 60
    else
        kb_msg "Printers" "\Z1The printer could not be set up:\Zn\n\n$out\n\nOlder printers may need a driver package (Settings > Software: printer-driver-gutenprint or hplip)." 14 70
    fi
}

printers_panel() {
    local sel p items=() default
    while true; do
        default=$(lpstat -d 2>/dev/null | sed -n 's/.*: //p')
        items=(Add "Add a printer")
        while IFS= read -r p; do items+=("$p" "$([ "$p" = "$default" ] && echo "(default)")"); done < <(lpstat -e 2>/dev/null)
        sel=$(kb_dialog --title " Printers " --ok-label "Select" --cancel-label "Back" \
            --menu "Printers on this computer:" 15 60 7 "${items[@]}") || return
        if [ "$sel" = Add ]; then printer_add; continue; fi
        p=$sel
        sel=$(kb_dialog --title " $p " --ok-label "Select" --cancel-label "Back" --menu "" 13 50 4 \
            Test    "Print a test page" \
            Default "Make it the default printer" \
            Queue   "Cancel everything waiting to print" \
            Remove  "Remove this printer") || continue
        case $sel in
            Test)    lp -d "$p" /usr/share/cups/data/testprint >/dev/null 2>&1 && kb_msg "Printers" "Test page sent." 6 30 ;;
            Default) lpoptions -d "$p" >/dev/null ;;
            Queue)   cancel -a "$p" 2>/dev/null; kb_msg "Printers" "The queue is empty." 6 30 ;;
            Remove)  kb_yesno "Printers" "Remove $p?" 7 40 && lpadmin -x "$p" ;;
        esac
    done
}

# --- Hotspot ---------------------------------------------------------------

hotspot_panel() {
    local IF ssid pass state
    IF=$(wifi_iface) || { kb_msg "Hotspot" "\Z1No Wi-Fi adapter found.\Zn" 7 40; return; }
    state=$(cat /run/kilobyte/hotspot 2>/dev/null)
    if [ -n "$state" ]; then
        kb_yesno "Hotspot" "The hotspot is \ZbON\Zn: $(cat "$KB_CONF/hotspot-name" 2>/dev/null)\nPassword: $(cat "$KB_CONF/hotspot-pass" 2>/dev/null)\n\nSwitch it off?" 10 60 || return
        kb_sudo && kb_info "Switching the hotspot off..." && sudo "$KB_LIB/kb-hotspot" stop >/dev/null 2>&1
        return
    fi
    ssid=$(cat "$KB_CONF/hotspot-name" 2>/dev/null || echo "Kilobyte-$(hostname)")
    pass=$(cat "$KB_CONF/hotspot-pass" 2>/dev/null || tr -dc 'a-km-z2-9' < /dev/urandom | head -c 10)
    kb_msg "Hotspot" "The hotspot shares this computer's Internet connection (cable or USB phone tethering) with phones and other computers over Wi-Fi.\n\nWhile it is on, this computer's own Wi-Fi cannot connect to other networks." 12 66
    ssid=$(kb_input "Hotspot" "Name of the hotspot:" "$ssid") || return
    pass=$(kb_input "Hotspot" "Password (at least 8 characters):" "$pass") || return
    [ ${#pass} -ge 8 ] || { kb_msg "Hotspot" "The password needs at least 8 characters." 7 50; return; }
    printf '%s\n' "$ssid" > "$KB_CONF/hotspot-name"
    (umask 077; printf '%s\n' "$pass" > "$KB_CONF/hotspot-pass")
    kb_sudo || return
    kb_info "Starting the hotspot..."
    if out=$(sudo "$KB_LIB/kb-hotspot" start "$IF" "$ssid" "$pass" 2>&1); then
        kb_msg "Hotspot" "\ZbThe hotspot is on.\Zn\n\nOn your phone, connect to \Zb$ssid\Zn\nwith the password \Zb$pass\Zn" 11 60
    else
        kb_msg "Hotspot" "\Z1The hotspot could not start:\Zn\n\n$out\n\nNot every Wi-Fi adapter can be a hotspot." 12 64
    fi
}

# --- Bluetooth -------------------------------------------------------------

bt() { bluetoothctl "$@" 2>/dev/null; }

bt_device() { # bt_device MAC NAME
    local mac=$1 name=$2 sel
    sel=$(kb_dialog --title " $name " --ok-label "Select" --cancel-label "Back" --menu "$mac" 14 60 5 \
        Connect    "Connect" \
        Disconnect "Disconnect" \
        Sound      "Play sound through it (headphones, speakers)" \
        Local      "Play sound through this computer again" \
        Remove     "Forget this device") || return
    case $sel in
        Connect)    kb_info "Connecting to $name..."; bt connect "$mac" >/dev/null ;;
        Disconnect) bt disconnect "$mac" >/dev/null ;;
        Sound)
            printf 'defaults.bluealsa.device "%s"\ndefaults.bluealsa.profile "a2dp"\npcm.!default bluealsa\nctl.!default bluealsa\n' "$mac" > "$HOME/.asoundrc"
            kb_msg "Bluetooth" "Sound now plays through \Zb$name\Zn." 7 56 ;;
        Local)      rm -f "$HOME/.asoundrc"; kb_msg "Bluetooth" "Sound plays through this computer again." 7 56 ;;
        Remove)     bt remove "$mac" >/dev/null ;;
    esac
}

bluetooth_panel() {
    local sel powered items=() mac name
    if ! bt show | grep -q Controller; then
        sudo -n "$KB_LIB/kb-root" bluetooth on >/dev/null 2>&1
        sleep 1
        bt show | grep -q Controller || { kb_msg "Bluetooth" "\Z1No Bluetooth adapter found.\Zn" 7 44; return; }
    fi
    while true; do
        powered=$(bt show | sed -n 's/.*Powered: //p' | head -n 1)
        items=(Power "Bluetooth is $([ "$powered" = yes ] && echo ON || echo OFF)" Find "Find and pair a new device")
        while read -r _ mac name; do items+=("$mac" "$name"); done < <(bt devices Paired)
        sel=$(kb_dialog --title " Bluetooth " --ok-label "Select" --cancel-label "Back" \
            --menu "Keyboards, mice, headphones and speakers:" 16 64 8 "${items[@]}") || return
        case $sel in
            Power)
                if [ "$powered" = yes ]; then bt power off >/dev/null; else sudo -n "$KB_LIB/kb-root" bluetooth on >/dev/null 2>&1; bt power on >/dev/null; fi ;;
            Find)
                bt power on >/dev/null
                kb_info "Searching for 12 seconds. Put your device into pairing mode now..."
                bt --timeout 12 scan on >/dev/null
                items=()
                while read -r _ mac name; do
                    [ "$name" = "${mac//:/-}" ] && continue    # nameless beacons
                    items+=("$mac" "$name")
                done < <(bt devices)
                [ ${#items[@]} -gt 0 ] || { kb_msg "Bluetooth" "No devices found." 7 40; continue; }
                mac=$(kb_dialog --title " Pair " --ok-label "Pair" --cancel-label "Back" --menu "Devices nearby:" 16 64 8 "${items[@]}") || continue
                kb_run_pause sh -c "echo 'Pairing. If a code appears, type it on the device and press Enter there.'; echo;
                    bluetoothctl --agent KeyboardDisplay pair $mac && bluetoothctl trust $mac && bluetoothctl connect $mac" ;;
            *)
                bt_device "$sel" "$(bt info "$sel" | sed -n 's/.*Name: //p')" ;;
        esac
    done
}

