# --- Users: several people, each with their own files; switching ----------------

users_list() { awk -F: '$3 >= 1000 && $3 < 60000 { print $1 }' /etc/passwd; }

# "N USER" for every console somebody is logged in on.
console_sessions() {
    loginctl list-sessions --no-legend 2>/dev/null | awk '{
        for (i = 1; i <= NF; i++) if ($i ~ /^tty[1-6]$/) { print substr($i, 4), $3; break } }' | sort -u
}

switch_user_panel() {
    local here items=() n u free="" sel
    here=$(cat /sys/class/tty/tty0/active 2>/dev/null)
    here=${here#tty}
    while read -r n u; do
        [ "$n" = "$here" ] && continue
        items+=("$n" "$u (console $n, Ctrl+Alt+F$n)")
    done < <(console_sessions)
    for n in 2 3 4 5 6 1; do
        console_sessions | grep -q "^$n " || { [ "$n" != "$here" ] && { free=$n; break; }; }
    done
    [ -n "$free" ] && items+=("$free" "Somebody else: a login prompt (console $free)")
    [ ${#items[@]} -gt 0 ] || { kb_msg "Switch User" "All six consoles are in use."; return; }
    sel=$(kb_dialog --title " Switch User " --ok-label "Switch" --cancel-label "Back" --menu \
"Your programs keep running. You come back to this session
with Ctrl+Alt+F${here:-1}, or with Switch user from the other one." 0 66 0 "${items[@]}") || return
    if kb_dialog --title " Switch User " --yesno "Lock your session while you are away?\n\n(It asks for your password when you come back.)" 9 60; then
        ( sleep 1; "$KB_LIB/apps/lock" ) &
    fi
    sudo -n "$KB_LIB/kb-root" vt switch "$sel" ||
        kb_msg "Switch User" "Switching did not work. Try Ctrl+Alt+F$sel."
    wait 2>/dev/null
}

user_add() {
    local name pass pass2 groups admin
    name=$(kb_input "Add a User" "User name (lower case letters and digits, e.g. \"ada\"):" "") || return
    [[ $name =~ ^[a-z][a-z0-9_-]{0,30}$ ]] || { kb_msg "Add a User" "A user name starts with a letter and has only lower case letters, digits, - and _."; return; }
    id "$name" >/dev/null 2>&1 && { kb_msg "Add a User" "There is a user \"$name\" already."; return; }
    pass=$(kb_password "Add a User" "Password for $name:") || return
    pass2=$(kb_password "Add a User" "The same password again:") || return
    [ -n "$pass" ] && [ "$pass" = "$pass2" ] || { kb_msg "Add a User" "The two passwords are not the same (or empty)."; return; }
    . "$KB_LIB/setup-questions.sh"
    groups=$(user_groups /etc/group)
    if kb_dialog --title " Add a User " --defaultno --yesno "May $name change settings of the whole computer\n(install programs, add users, update Kilobyte)?" 8 62; then
        admin=yes
    else
        groups=$(printf '%s' "$groups" | sed 's/^sudo,//; s/,sudo//')
    fi
    kb_sudo || return
    if sudo useradd -m -s /bin/bash -G "$groups" "$name" && printf '%s:%s\n' "$name" "$pass" | sudo chpasswd; then
        kb_msg "Add a User" "\Zb$name\Zn can log in now: Switch user, or at the next start." 8 60
    else
        kb_msg "Add a User" "\Z1The user could not be added.\Zn"
    fi
}

user_remove() {
    local items=() u sel keep
    while read -r u; do
        [ "$u" = "$USER" ] || items+=("$u" "$(getent passwd "$u" | cut -d: -f6)")
    done < <(users_list)
    [ ${#items[@]} -gt 0 ] || { kb_msg "Remove a User" "There is no other user."; return; }
    sel=$(kb_dialog --title " Remove a User " --ok-label "Remove" --cancel-label "Back" --menu "Who?" 0 60 0 "${items[@]}") || return
    if loginctl list-sessions --no-legend 2>/dev/null | awk '{ print $3 }' | grep -qx "$sel"; then
        kb_msg "Remove a User" "$sel is logged in. Log that session out first."
        return
    fi
    keep=""
    kb_dialog --title " Remove a User " --defaultno --yes-label "Delete files" --no-label "Keep files" --yesno \
        "Delete the files of $sel too ($(getent passwd "$sel" | cut -d: -f6))?\n\nDeleted files cannot be brought back." 9 64 || keep=1
    kb_dialog --title " Remove a User " --defaultno --yesno "Remove the user \Zb$sel\Zn now?" 7 50 || return
    kb_sudo || return
    if sudo userdel $([ -z "$keep" ] && echo -r) "$sel" 2>/dev/null; then
        kb_msg "Remove a User" "$sel was removed."
    else
        kb_msg "Remove a User" "\Z1$sel could not be removed.\Zn"
    fi
}

users_panel() {
    local sel
    while true; do
        sel=$(kb_dialog --title " Users " --ok-label "Select" --cancel-label "Back" --menu \
            "Everybody has their own files, settings and desktop.\nUsers: $(users_list | xargs)" 0 66 0 \
            Switch   "Switch user (your programs keep running)" \
            Add      "Add a user" \
            Remove   "Remove a user" \
            Password "Change your password") || return
        case $sel in
            Switch)   switch_user_panel ;;
            Add)      user_add ;;
            Remove)   user_remove ;;
            Password) kb_run_pause passwd ;;
        esac
    done
}

