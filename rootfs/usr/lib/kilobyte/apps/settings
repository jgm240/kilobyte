# --- Screen saver ----------------------------------------------------------

saver_panel() {
    local mode min items=() m
    mode=$(cat "$KB_CONF/saver-mode" 2>/dev/null || echo random)
    for m in random starfield lines floppies off; do
        items+=("$m" "$(case $m in random) echo "A different one each time" ;; starfield) echo "Flying through the stars" ;;
            lines) echo "Bouncing coloured lines" ;; floppies) echo "Flying floppy disks" ;; off) echo "No screen saver" ;; esac)" \
            "$([ "$m" = "$mode" ] && echo on || echo off)")
    done
    m=$(kb_dialog --title " Screen Saver " --ok-label "Next" --cancel-label "Back" --extra-button --extra-label "Preview" \
        --radiolist "The screen saver starts when the Program Manager is left alone." 14 60 5 "${items[@]}")
    case $? in
        "$DIALOG_EXTRA") "$KB_LIB/apps/saver" "${m:-$mode}"; kb_load_theme; return ;;
        "$DIALOG_OK") ;;
        *) return ;;
    esac
    echo "$m" > "$KB_CONF/saver-mode"
    [ "$m" = off ] && return
    min=$(cat "$KB_CONF/saver-minutes" 2>/dev/null || echo 5)
    min=$(kb_dialog --title " Screen Saver " --default-item "$min" --ok-label "Save" --cancel-label "Back" \
        --menu "Start after how many minutes?" 14 40 6 1 "minute" 2 "minutes" 5 "minutes" 10 "minutes" 15 "minutes" 30 "minutes") || return
    echo "$min" > "$KB_CONF/saver-minutes"
}

