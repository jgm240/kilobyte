#!/bin/bash
# Host a BBS: this computer as a bulletin board system that friends dial into
# with a BBS dialer (Kilobyte's, or any telnet BBS program): chat rooms,
# message boards, private mail, file areas, games and apps. The board is
# hostbbs from rBBS (github.com/jgm240/rbbs; Kilobyte's copy, or a newer one
# "Update" brought: kb-bbs-run), run by kilobyte-bbs.service as the user kbbs;
# its own setup dialog sets it up. kb-root switches it on and off.
. /usr/lib/kilobyte/lib.sh

T="Host a BBS"
ETC=/etc/kilobyte/bbs
CONF="$ETC/hostbbs.json"
FILES=/srv/kilobyte-bbs/files
STORIES=/srv/kilobyte-bbs/stories
HOSTBBS="$KB_LIB/kb-bbs-run"
TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT

# cfg KEY: a setting from hostbbs.json (text; lists and switches as JSON)
cfg() {
    python3 -c 'import json, sys
v = json.load(open(sys.argv[1])).get(sys.argv[2], "")
print(v if isinstance(v, str) else json.dumps(v))' "$CONF" "$1" 2>/dev/null
}

bbs_root() { # bbs_root ACTION [ARGS]: kb-root bbs, without a password where allowed
    sudo -n "$KB_LIB/kb-root" bbs "$@" 2>"$TMP/err" && return 0
    grep -q "password is required\|a terminal is required" "$TMP/err" || { cat "$TMP/err" >&2; return 1; }
    kb_sudo && sudo "$KB_LIB/kb-root" bbs "$@"
}

# (Where systemctl cannot be asked, the board's port tells.)
running() {
    systemctl -q is-active kilobyte-bbs.service 2>/dev/null && return 0
    systemctl show -p ActiveState kilobyte-bbs.service >/dev/null 2>&1 && return 1
    (exec 3<>"/dev/tcp/127.0.0.1/$(cfg port)") 2>/dev/null
}
addresses() { ip -4 -o addr show scope global 2>/dev/null | awk '{ sub("/.*", "", $4); print $4 }' | xargs; }
dial_list() { local a; for a in $(addresses); do printf '%s:%s  ' "$a" "$(cfg port)"; done; }

sysop_password() { # sysop_password [FIRST]: ask for it twice and set it
    local p1 p2
    while true; do
        p1=$(kb_password "Sysop Password" "${1:+You log in to your BBS as $(cfg sysop), the sysop. }Your password there\n(at least 4 characters):") || return 1
        [ ${#p1} -ge 4 ] || { kb_msg "$T" "At least 4 characters, please." 7 44; continue; }
        p2=$(kb_password "Sysop Password" "The same password again:") || return 1
        [ "$p1" = "$p2" ] && break
        kb_msg "$T" "The two were not the same. Once more." 7 44
    done
    if printf '%s\n' "$p1" | bbs_root passwd > /dev/null 2>"$TMP/err2"; then
        kb_msg "$T" "Log in to your BBS as \Zb$(cfg sysop)\Zn with that password: the main menu then has Sysop tools (kick, broadcast), and you may delete messages on the boards." 9 66
    else
        kb_msg "$T" "\Z1The password could not be set.\Zn\n\n$(tail -n 2 "$TMP/err2")" 9 66
    fi
}

first_time() {
    local name sysop
    kb_msg "$T" "Your computer can be a BBS, a bulletin board system as in the 1980s and 90s: friends dial in with a BBS dialer, chat, leave messages and mail, download files and play games, and you are the sysop.

Next: a name for your board and your password as its sysop. Everything else is in Settings, later." 14 68
    if ! bbs_root setup 2>"$TMP/err"; then
        kb_msg "$T" "\Z1The BBS could not be set up.\Zn\n\n$(tail -n 2 "$TMP/err")" 9 66
        exit 0
    fi
    name=$(kb_input "$T" "The name of your BBS:" "$(hostname | sed 's/./\U&/') BBS") || name="Kilobyte BBS"
    # hostbbs handles: 2 to 16 letters, digits, _ or -.
    sysop=$(printf '%s' "$USER" | tr -cd 'A-Za-z0-9_-' | cut -c1-16)
    [ ${#sysop} -ge 2 ] || sysop=sysop
    printf 'Welcome!\n\nBe kind, have fun, and leave a message on the boards.\n' > "$ETC/greeting.txt"
    python3 - "$CONF" "${name:-Kilobyte BBS}" "$sysop" "$(cat "$KB_CONF/tiles-city" 2>/dev/null)" <<'PY'
import json, sys
path, name, sysop, city = sys.argv[1:5]
json.dump({
    "name": name, "tagline": "Dial in, log on, hang out.", "port": 2323, "color": True, "charset": "utf-8",
    "features": {"chat": True, "boards": True, "mail": True, "files": True, "games": True, "apps": True,
                 "guests": True, "register": True},
    "sysop": sysop, "data_dir": "/var/lib/kilobyte-bbs", "max_users": 16, "idle_timeout": 900, "minutes": 60,
    "motd": ["Be excellent to each other."], "greeting": "/etc/kilobyte/bbs/greeting.txt", "goodbye": "",
    "hosted": True, "files_dir": "/srv/kilobyte-bbs/files", "stories_dir": "/srv/kilobyte-bbs/stories",
    "weather_city": city,
    "rooms": [{"name": "lobby", "topic": "Say hello!"}, {"name": "retro", "topic": "Old computers and games"},
              {"name": "random", "topic": "Anything goes"}],
    "board_list": [{"name": "General", "desc": "Open discussion"},
                   {"name": "Announcements", "desc": "News from the sysop"}],
}, open(path, "w"), indent=2)
PY
    mkdir -p "$FILES/General" 2>/dev/null
    [ -e "$FILES/General/descriptions.txt" ] || printf '%s\n' "# One line per file: its name, then what it is." > "$FILES/General/descriptions.txt"
    sysop_password first
}

# The settings (hostbbs's own setup dialog). It ends with 10 for "Save and
# restart the BBS".
settings() {
    clear
    HOSTBBS_SERVICE=1 "$HOSTBBS" setup -c "$CONF"
    local rc=$?
    kb_load_theme
    if [ $rc -eq 10 ]; then
        if running; then bbs_root restart; else bbs_root on; fi
        kb_msg "$T" "The BBS runs with the new settings." 7 50
    elif running; then
        kb_yesno "$T" "Restart the BBS so that callers get the new settings?\n(Those on it now are hung up.)" 9 60 && bbs_root restart
    fi
}

switch() {
    if running; then
        kb_yesno "$T" "Switch the BBS off? Callers on it now are hung up." 7 60 || return
        bbs_root off
    else
        kb_yesno "$T" "Switch the BBS on?\n\nAnyone who can reach this computer on port $(cfg port) can call it: everyone on this network, and the whole Internet if your router forwards that port here." 11 66 || return
        if bbs_root on 2>"$TMP/err" && sleep 2 && running; then
            kb_msg "$T" "\ZbYour BBS is on.\Zn\n\nFriends on this network dial:\n  $(dial_list)\n\nFrom the Internet, forward port $(cfg port) on your router to this computer, and give out your Internet address." 14 70
        else
            journalctl -u kilobyte-bbs.service -n 5 --no-pager 2>/dev/null | tail -n 3 > "$TMP/why"
            kb_msg "$T" "\Z1It did not start.\Zn\n\n$(cat "$TMP/why" "$TMP/err" 2>/dev/null | tail -n 3)" 11 70
        fi
    fi
}

files_panel() {
    local sel n f
    while true; do
        n=$(find "$STORIES" -maxdepth 1 -type f \( -iname '*.z[1-8]' -o -iname '*.zblorb' \) 2>/dev/null | wc -l)
        sel=$(kb_dialog --title " Files " --ok-label "Select" --cancel-label "Back" --menu \
"Every folder in $FILES is a file area; callers download
its files (ZMODEM). Describe them in the area's descriptions.txt:
one line per file, its name, then what it is." 0 72 0 \
            Open     "Open the file areas in the file manager" \
            Area     "Add a file area" \
            Stories  "Text adventures for callers: $n (copy them from Documents/Stories)" \
            Greeting "Edit the greeting (shown after the banner)") || return
        case $sel in
            Open)  kb_guarded '\e[21~' mc "$FILES" "$KB_DOCS" ;;
            Area)  n=$(kb_input "New File Area" "Its name:" "") && n=${n//\//} && [ -n "$n" ] &&
                       mkdir -p "$FILES/$n" && printf '%s\n' "# One line per file: its name, then what it is." > "$FILES/$n/descriptions.txt" ;;
            Stories)
                for f in "$KB_DOCS"/Stories/*; do
                    case ${f,,} in *.z[1-8] | *.zblorb) cp -n "$f" "$STORIES/" ;; esac
                done
                kb_msg "$T" "Callers have $(find "$STORIES" -maxdepth 1 -type f | wc -l) text adventures now.\n\n(Games > Text adventures downloads more into Documents/Stories.)" 9 64 ;;
            Greeting) kb_guarded '\e[21~' mcedit "$ETC/greeting.txt" ;;
        esac
    done
}

who_panel() {
    bbs_root who 2>/dev/null | python3 -c 'import json, sys, time
people = json.load(sys.stdin)
print("Callers on the BBS now: %d\n" % len(people))
for p in people:
    print("  %-18s %-24s %d min" % (p["name"], p["where"], (time.time() - p["since"]) // 60))' > "$TMP/who" 2>&1
    kb_textfile "Who Is On" "$TMP/who"
}

call_it() {
    running || { kb_msg "$T" "Switch the BBS on first." 7 40; return; }
    kb_msg "$T" "Log in as \Zb$(cfg sysop)\Zn for the sysop tools.\n\nCtrl+C hangs up." 8 56
    clear
    kb_guarded '' python3 "$KB_LIB/py/bbsterm.py" 127.0.0.1 "$(cfg port)" --utf8
}

[ -f "$CONF" ] || first_time
[ -f "$CONF" ] || exit 0
[ -w "$CONF" ] || { kb_msg "$T" "This BBS belongs to $(stat -c %U "$ETC"), its sysop: only they can change it." 8 60; exit 0; }

sel=Switch
while true; do
    if running; then state="\ZbON\Zn: friends dial $(dial_list)"; else state="OFF"; fi
    sel=$(kb_dialog --title " $T: $(cfg name) " --default-item "$sel" --ok-label "Select" --cancel-label "Close" --menu \
        "The BBS is $state" 0 76 0 \
        Switch   "Switch the BBS $(running && echo off || echo on)" \
        Settings "Name, banner, rooms, boards, features, games, port... (hostbbs)" \
        Files    "File areas, text adventures and the greeting" \
        Password "The sysop's password" \
        Who      "Who is on now" \
        Update   "Get the newest hostbbs (from rBBS on GitHub): $("$HOSTBBS" --version 2>/dev/null | cut -d' ' -f2) now" \
        Restart  "Restart the BBS (callers are told first)" \
        Log      "The log: what callers did in public (never mail or private messages)" \
        Call     "Call your BBS (log in as the sysop for the sysop tools)") || exit 0
    case $sel in
        Switch)   switch ;;
        Settings) settings ;;
        Files)    files_panel ;;
        Password) sysop_password ;;
        Who)      who_panel ;;
        Update)   kb_info "Getting the newest hostbbs..."
                  bbs_root update > "$TMP/up" 2>&1
                  kb_msg "$T" "$(tail -n 2 "$TMP/up" | sed 's/^[0-9-]* [0-9:]*  //')" 9 70 ;;
        Restart)  if running; then bbs_root op restart > "$TMP/out" 2>&1 || bbs_root restart; kb_msg "$T" "The BBS restarts: callers are told, then it is back in a moment." 8 60
                  else kb_msg "$T" "The BBS is off." 7 30; fi ;;
        Log)      bbs_root log > "$TMP/log" 2>&1; tac "$TMP/log" > "$TMP/log.new" && kb_textfile "Activity Log (newest first)" "$TMP/log.new" ;;
        Call)     call_it ;;
    esac
done
