#!/bin/bash
# kb-play MODE SOURCE [MPV-OPTIONS...]
#
# Play a video file, web address or disc (dvd://, cdda://) with mpv.
#
#   extreme | fine | medium   coloured character blocks: the text console
#                             switches to a tiny Kilobyte pixel font (1x2,
#                             2x4 or 4x8 pixels per character) while playing
#   text                      coloured blocks in the normal font (in Kilobyte
#                             Windows: inside the window)
#   real                      the real picture, drawn straight to the screen
#   audio                     sound only, with mpv's status line
#
# Keys while playing: Space pause, arrows seek, 9/0 volume, q or Ctrl-C stop.

. /usr/lib/kilobyte/lib.sh

mode=${1:-medium}
src=${2:?usage: kb-play MODE SOURCE [MPV-OPTIONS...]}
shift 2

# In Kilobyte Windows a window cannot switch the console to a tiny pixel font
# or show the real picture: for those modes Kilobyte Windows lends the whole
# screen while the video plays (KB_FULL_SCREEN is set there). "text" and
# "audio" play inside the window.
if [ -n "${KILOBYTE_DESK:-}" ] && [ -S "${KB_DESK_SOCK:-}" ]; then
    case $mode in
        extreme | fine | medium | real)
            clear
            printf '\n  Playing on the whole screen ...\n\n  Space pauses, the arrow keys seek, q or Ctrl+C stops.\n'
            python3 "$KB_LIB/py/deskrun.py" play "$mode" "$src" "$@"
            rc=$?
            clear
            [ $rc -ne 125 ] && exit $rc
            mode=text                  # Kilobyte Windows did not answer: in the window
            ;;
    esac
fi

# Streams from the web (YouTube and others) in the chosen picture size.
height=$(cat "$KB_CONF/stream-height" 2>/dev/null)
[[ $height =~ ^[0-9]+$ ]] || height=720
opts=(--really-quiet --input-terminal=yes --keep-open=no
      "--ytdl-format=bv*[height<=$height]+ba/b[height<=$height]/b")

on_console() { [ "$TERM" = linux ] && case $(tty) in /dev/tty[0-9]*) true ;; *) false ;; esac; }

play_blocks() {
    local size=$1 saved="" f
    printf '\033]R'            # video wants the true colours, not the theme's
    if [ -n "$size" ] && on_console && command -v setfont >/dev/null; then
        saved=$(mktemp /tmp/kb-font.XXXXXX)
        setfont -O "$saved" 2>/dev/null || { rm -f "$saved"; saved=""; }
        if [ -n "$saved" ]; then
            # Very large screens can exceed the console's limit on character
            # cells; then fall back to the next bigger pixel size.
            case $size in
                1x2) sizes="1x2 2x4 4x8" ;;
                2x4) sizes="2x4 4x8" ;;
                *)   sizes="4x8" ;;
            esac
            for f in $sizes; do
                setfont "$KB_SHARE/fonts/kb-pixels-$f.psf" 2>/dev/null && break
            done
        fi
    fi
    tput civis 2>/dev/null
    CACA_DRIVER=ncurses mpv --vo=caca "${opts[@]}" "$src" "$@"
    local rc=$?
    if [ -n "$saved" ]; then
        setfont "$saved" 2>/dev/null
        rm -f "$saved"
    fi
    tput cnorm 2>/dev/null
    return $rc
}

clear
case $mode in
    extreme) play_blocks 1x2 "$@" ;;
    fine)    play_blocks 2x4 "$@" ;;
    medium)  play_blocks 4x8 "$@" ;;
    text)    play_blocks "" "$@" ;;
    real)
        printf '\033]R'
        tput civis 2>/dev/null
        mpv --vo=drm "${opts[@]}" "$src" "$@"
        rc=$?
        tput cnorm 2>/dev/null
        clear
        # mpv: 0 end of file, 4 stopped by the user
        if [ $rc -ne 0 ] && [ $rc -ne 4 ]; then
            kb_load_theme
            kb_msg "Video Player" "The real picture could not be shown here.\n\nIt needs the text console of a computer with a graphics card (not a remote terminal). Try one of the block modes." 10 64
        fi
        exit $rc
        ;;
    audio)
        printf '\033[1;37;44m%*s\r  Playing: %s   (Space pause, arrows seek, 9/0 volume, q stops)\033[0m\n\n' \
            "$(tput cols)" "" "$(basename "$src")"
        mpv --no-video --term-osd-bar "$src" "$@"
        ;;
    *) echo "kb-play: unknown mode $mode" >&2; exit 2 ;;
esac
rc=$?
clear
kb_load_theme
exit $rc
