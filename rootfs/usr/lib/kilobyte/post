#!/bin/bash
# The Kilobyte start-up screen, in the style of a PC's power-on self test.
# Shows the real hardware, then beeps once. Runs on tty1 before the login
# (kilobyte-post.service). Switch it off in Settings > Startup.

# The start-up messages end here: Kilobyte has the screen from now on
# (systemd stops printing its status lines to the console).
kill -s RTMIN+21 1 2>/dev/null || true
[ -e /etc/kilobyte/post-off ] && { printf '\033[r\033[0m\033[2J\033[H'; exit 0; }

W="\033[1;37m" G="\033[0;37m" C="\033[1;36m" Y="\033[1;33m" N="\033[0m"

printf '\033[r\033[0m\033[2J\033[H\033[?25l'
version=$(sed -n 's/^KB_VERSION="\(.*\)"/\1/p' /usr/lib/kilobyte/lib.sh)
printf "$W  ▄▄▄▄▄▄   $C%s$N\n" "Kilobyte BIOS v$version"
printf "$W  █ ▄▀ █   $G%s$N\n" "Copyright (C) 2026 Kilobyte contributors  ·  free software, GNU GPL 3"
printf "$W  █▀▄  █$N\n"
printf "$W  ▀▀▀▀▀▀$N\n\n"

model=""
[ -r /proc/device-tree/model ] && model=$(tr -d '\0' < /proc/device-tree/model)   # Raspberry Pi
[ -n "$model" ] && printf "  System            : %s\n" "$model"
cpu=$(sed -n 's/^model name[[:space:]]*: //p' /proc/cpuinfo | head -n 1)
[ -n "$cpu" ] || cpu=$(lscpu 2>/dev/null | sed -n 's/^Model name: *//p' | head -n 1)
printf "  Main Processor    : %s x %s\n" "${cpu:-unknown}" "$(nproc)"

# Count the memory up, like the old memory test.
total=$(awk '/^MemTotal/ {print $2}' /proc/meminfo)
steps=24
for ((i = 1; i <= steps; i++)); do
    printf "\r  Memory Testing    : %sK" $(( total * i / steps ))
    sleep 0.04
done
printf " ${W}OK$N\n\n"

printf "  Detecting drives ...\n"
lsblk -dno NAME,TYPE,SIZE,MODEL 2>/dev/null | while read -r name type size model; do
    case $name in loop* | ram* | zram*) continue ;; esac
    case $type in
        rom)  printf "    CD/DVD drive    : %s\n" "${model:-$name}" ;;
        disk) [ "$size" = 0B ] || printf "    Disk            : %s (%s)\n" "${model:-$name}" "$size" ;;
    esac
done
usb=$(ls /sys/bus/usb/devices/ 2>/dev/null | grep -c '^[0-9]*-[0-9.]*$')
printf "  USB devices       : %s\n" "$usb"
for d in /sys/class/net/*; do
    n=$(basename "$d")
    [ -e "$d/device" ] || continue
    [ -d "$d/wireless" ] && kind="Wi-Fi" || kind="Ethernet"
    printf "  Network           : %s (%s)\n" "$n" "$kind"
done
snd=$(sed -n 's/^ *[0-9]* \[[^]]*\]: \(.*\)/\1/p' /proc/asound/cards 2>/dev/null | head -n 1)
printf "  Sound             : %s\n" "${snd:-none found}"
bat=$(cat /sys/class/power_supply/BAT*/capacity 2>/dev/null | head -n 1)
[ -n "$bat" ] && printf "  Battery           : %s%%\n" "$bat"

printf "\n  ${Y}Starting Kilobyte ...$N\n"
[ -e /etc/kilobyte/sounds-off ] || aplay -q /usr/share/kilobyte/sounds/post-beep.wav 2>/dev/null
sleep 1.2
printf '\033[?25h'
