#!/bin/bash
# kb-update: update Kilobyte straight from its GitHub repository.
#
#   kb-update check     print "INSTALLED LATEST" commit ids (any user)
#   kb-update changes   list the changes between them, one per line (any user)
#   kb-update apply SHA install that commit (root; run through kb-root)
#
# The repository and branch are set in /usr/share/kilobyte/update.conf. The
# commit this system was built from is in /usr/share/kilobyte/commit.
#
# An update replaces Kilobyte's own files (programs, themes, fonts, help) and
# installs packages that were added to image/packages.txt since this system
# was built (packages the owner removed stay removed). It never touches the
# owner's settings: keyboard, font, host name, Wi-Fi, users.
set -euo pipefail

SHARE=/usr/share/kilobyte
REPO=jgm240/kilobyte
BRANCH=main
# shellcheck source=/dev/null
[ -r "$SHARE/update.conf" ] && . "$SHARE/update.conf"
API="https://api.github.com/repos/$REPO"

installed() { cat "$SHARE/commit" 2>/dev/null || echo unknown; }

latest() {
    curl -fsS --max-time 20 -H 'Accept: application/vnd.github.sha' "$API/commits/$BRANCH"
}

cmd_check() {
    local new
    new=$(latest) || { echo "kb-update: cannot reach github.com/$REPO" >&2; exit 1; }
    [[ $new =~ ^[0-9a-f]{40}$ ]] || { echo "kb-update: unexpected answer from GitHub" >&2; exit 1; }
    echo "$(installed) $new"
}

# One line per commit: the first line of each commit message, newest first.
cmd_changes() {
    local old new
    read -r old new < <(cmd_check)
    if [[ $old =~ ^[0-9a-f]{40}$ ]]; then
        curl -fsS --max-time 20 "$API/compare/$old...$new" |
            python3 -c 'import json, sys
for c in reversed(json.load(sys.stdin).get("commits", [])):
    print(c["commit"]["message"].splitlines()[0])'
    else
        curl -fsS --max-time 20 "$API/commits?sha=$BRANCH&per_page=15" |
            python3 -c 'import json, sys
for c in json.load(sys.stdin):
    print(c["commit"]["message"].splitlines()[0])'
    fi
}

TMP=""
cleanup() { [ -n "$TMP" ] && rm -rf "$TMP"; }

# Package names in the given package list files, one per line.
package_list() { sed 's/#.*//' "$@" 2>/dev/null | xargs -n 1 | sort -u; }

cmd_apply() {
    local sha=${1:-} src
    [[ $sha =~ ^[0-9a-f]{40}$ ]] || { echo "usage: kb-update apply COMMIT-ID" >&2; exit 2; }
    [ "$(id -u)" -eq 0 ] || { echo "kb-update: apply needs root" >&2; exit 1; }

    TMP=$(mktemp -d /tmp/kb-update.XXXXXX)
    trap cleanup EXIT
    echo "Downloading Kilobyte ${sha:0:7} from github.com/$REPO ..."
    curl -fsSL --max-time 300 "https://codeload.github.com/$REPO/tar.gz/$sha" | tar -xz -C "$TMP"
    src=$(find "$TMP" -mindepth 1 -maxdepth 1 -type d | head -n 1)/rootfs
    [ -x "$src/usr/bin/kilobyte" ] || [ -f "$src/usr/bin/kilobyte" ] || { echo "kb-update: download is not a Kilobyte tree" >&2; exit 1; }

    echo "Checking the new files ..."
    # Every program is checked in its own language before anything is installed.
    for f in "$src/usr/bin/kilobyte" "$src"/usr/sbin/kilobyte-* "$src"/usr/lib/kilobyte/*.sh \
             "$src"/usr/lib/kilobyte/apps/* "$src"/usr/lib/kilobyte/kb-* "$src"/usr/lib/kilobyte/py/*.py; do
        [ -f "$f" ] || continue
        case "$f $(head -n 1 "$f")" in
            *.py\ * | *python*) python3 -c 'import ast, sys; ast.parse(open(sys.argv[1], "rb").read())' "$f" ;;
            *perl*)   perl -c "$f" >/dev/null 2>&1 ;;
            *)        bash -n "$f" ;;
        esac || { echo "kb-update: $f is broken, update stopped" >&2; exit 1; }
    done
    visudo -cqf "$src/etc/sudoers.d/kilobyte" || { echo "kb-update: sudoers file is broken, update stopped" >&2; exit 1; }
    install_tree "$src" "$sha"
}

# Hand the installing over to the updater that came with the download, so an
# update's own changes to the updater (new files to install, new steps)
# already count for this update.
cmd_apply_from() {
    local src=$1 sha=$2
    TMP=${KB_UPDATE_TMP:-}
    trap cleanup EXIT
    install_tree "$src" "$sha"
}

install_tree() {
    local src=$1 sha=$2 d f old_pkgs new_pkgs added=() missing=() failed=() p kind
    if [ -z "${KB_UPDATE_TMP:-}" ] && [ -f "$src/usr/lib/kilobyte/kb-update" ] &&
       ! cmp -s "$src/usr/lib/kilobyte/kb-update" "$0"; then
        export KB_UPDATE_TMP=$TMP
        trap - EXIT                  # the new updater cleans up
        exec bash "$src/usr/lib/kilobyte/kb-update" apply-from "$src" "$sha"
    fi

    # The package list this system has (from its image or last update).
    old_pkgs=$(package_list "$SHARE/packages.txt")
    # Common packages plus those for PCs or the Raspberry Pi.
    case $(dpkg --print-architecture) in
        amd64 | i386) kind=pc ;;
        *)            kind=pi ;;
    esac
    new_pkgs=$(package_list "$src/../image/packages.txt" "$src/../image/packages-$kind.txt" \
        "$src/../image/packages-$(dpkg --print-architecture).txt")
    grep -qx firmware-iwlwifi <<< "$old_pkgs" &&   # not a --lite image
        new_pkgs=$(printf '%s\n' "$new_pkgs" "$(package_list "$src/../image/packages-wifi.txt")" | sort -u)

    echo "Installing ..."
    # Kilobyte's own directories are swapped in as a whole.
    for d in usr/lib/kilobyte usr/share/kilobyte; do
        rm -rf "/$d.new" "/$d.old"
        cp -a "$src/$d" "/$d.new"
        chown -R root:root "/$d.new"
        mv "/$d" "/$d.old"
        mv "/$d.new" "/$d"
        rm -rf "/$d.old"
    done
    chmod 755 /usr/lib/kilobyte/kb-* /usr/lib/kilobyte/wifi-up /usr/lib/kilobyte/post \
        /usr/lib/kilobyte/resize-root /usr/lib/kilobyte/apps/*
    [ -f /usr/lib/kilobyte/bootlogo ] && chmod 755 /usr/lib/kilobyte/bootlogo
    install -m 755 "$src/usr/bin/kilobyte" /usr/bin/kilobyte
    install -m 755 "$src/usr/sbin/kilobyte-install" /usr/sbin/kilobyte-install
    install -m 755 "$src/usr/sbin/kilobyte-firstboot" /usr/sbin/kilobyte-firstboot
    install -D -m 644 -t /usr/share/consolefonts "$src"/usr/share/consolefonts/Kilobyte-*
    install -m 440 "$src/etc/sudoers.d/kilobyte" /etc/sudoers.d/kilobyte
    # System files that belong to Kilobyte (not the owner's settings).
    for f in etc/profile.d/kilobyte.sh etc/systemd/system/kilobyte-wifi.service \
             etc/modules-load.d/kilobyte-optical.conf etc/sysctl.d/10-kilobyte.conf \
             etc/yt-dlp.conf etc/elinks/elinks.conf etc/gpm.conf etc/issue etc/systemd/network/20-wired.network \
             etc/systemd/system/kilobyte-post.service etc/systemd/system/kilobyte-resize.service \
             etc/systemd/network/25-wireless.network etc/systemd/system/kilobyte-bootlogo.service \
             etc/systemd/system/kilobyte-swap.service \
             etc/X11/Xwrapper.config etc/X11/xorg.conf.d/10-kilobyte.conf; do
        [ -f "$src/$f" ] && install -D -m 644 "$src/$f" "/$f"
    done
    # The start-up logo in the initramfs.
    local initramfs_changed=
    for f in etc/initramfs-tools/hooks/kilobyte-logo etc/initramfs-tools/hooks/kilobyte-storage \
             etc/initramfs-tools/scripts/init-top/kilobyte-logo \
             etc/initramfs-tools/scripts/init-bottom/kilobyte-logo; do
        [ -f "$src/$f" ] || continue
        cmp -s "$src/$f" "/$f" || initramfs_changed=1
        install -D -m 755 "$src/$f" "/$f"
    done
    # Installed PCs: Kilobyte's boot menu (not on the live system).
    if [ -f "$src/etc/default/grub" ] && [ ! -d /run/live/medium ] && command -v update-grub >/dev/null &&
       ! cmp -s "$src/etc/default/grub" /etc/default/grub; then
        install -m 644 "$src/etc/default/grub" /etc/default/grub
        update-grub >/dev/null 2>&1 || true
    fi
    cp -a "$src/etc/skel/." /etc/skel/ 2>/dev/null || true
    chown -R root:root /etc/skel
    echo "$sha" > "$SHARE/commit"
    # Whoever was told "Update available" has the update now.
    local note
    for note in /home/*/.config/kilobyte/update-latest /root/.config/kilobyte/update-latest; do
        [ -f "$note" ] && echo "$sha" > "$note"     # (keeps the file's owner)
    done
    printf '%s\n' "$new_pkgs" > "$SHARE/packages.txt"
    systemctl daemon-reload 2>/dev/null || true

    # Programs added to the image since this system was built. Only new
    # names count, so programs the owner removed are not brought back.
    if [ -n "$old_pkgs" ]; then
        mapfile -t added < <(comm -13 <(printf '%s\n' "$old_pkgs") <(printf '%s\n' "$new_pkgs"))
    fi
    for p in "${added[@]}"; do
        [ "$p" = live-boot ] && continue
        dpkg-query -W -f '${Status}' "$p" 2>/dev/null | grep -q 'ok installed' || missing+=("$p")
    done
    if [ ${#missing[@]} -gt 0 ]; then
        echo "New programs: ${missing[*]}"
        export DEBIAN_FRONTEND=noninteractive
        # 32-bit packages on a 64-bit PC (Wine for 32-bit Windows programs).
        if printf '%s\n' "${missing[@]}" | grep -q ':i386$' && ! dpkg --print-foreign-architectures | grep -qx i386; then
            dpkg --add-architecture i386
        fi
        apt-get update -qq || true
        if ! apt-get install -y -q --no-install-recommends "${missing[@]}"; then
            # Install one by one so one unavailable package does not block the rest.
            for p in "${missing[@]}"; do
                apt-get install -y -q --no-install-recommends "$p" || failed+=("$p")
            done
        fi
        [ ${#failed[@]} -eq 0 ] || echo "Could not install: ${failed[*]} (try again later in Settings > Software)"
    fi

    # New services and groups that came with the update.
    systemctl enable kilobyte-post.service kilobyte-bootlogo.service kilobyte-swap.service 2>/dev/null || true
    if [ -n "$initramfs_changed" ] && [ ! -d /run/live/medium ]; then
        echo "Updating the start-up files ..."
        update-initramfs -u -k all >/dev/null 2>&1 || true
    fi
    systemctl try-restart gpm.service 2>/dev/null || true      # new mouse settings
    # shellcheck source=/dev/null
    . /usr/lib/kilobyte/setup-questions.sh
    for u in $(awk -F: '$3 >= 1000 && $3 < 60000 {print $1}' /etc/passwd); do
        usermod -aG "$(user_groups /etc/group)" "$u" 2>/dev/null || true
    done

    echo
    echo "Kilobyte is up to date (${sha:0:7})."
    [ -d /run/live/medium ] && echo "This is the live system: the update lasts until it is restarted."
    return 0
}

case "${1:-}" in
    check)   cmd_check ;;
    changes) cmd_changes ;;
    apply)   cmd_apply "${2:-}" ;;
    apply-from) cmd_apply_from "${2:-}" "${3:-}" ;;
    *) echo "usage: kb-update check | changes | apply COMMIT-ID" >&2; exit 2 ;;
esac
