def text_to_docx(src, dest, template=None):
    blocks = parse_text(src)
    if template and zipfile.is_zipfile(template):
        tz = zipfile.ZipFile(template)
        styles = set(re.findall(r'w:styleId="([^"]+)"', tz.read("word/styles.xml").decode("utf-8", "replace"))) \
            if "word/styles.xml" in tz.namelist() else set()
        doc = tz.read("word/document.xml").decode("utf-8")
        # Keep the section properties (page size, headers, footers).
        sect = re.search(r"<w:sectPr\b.*</w:sectPr>\s*(?=</w:body>)", doc, re.S)
        body = docx_body(blocks, styles) + (sect.group(0) if sect else "")
        doc = re.sub(r"(<w:body[^>]*>).*(</w:body>)", lambda m: m.group(1) + body + m.group(2), doc, flags=re.S)
        with zipfile.ZipFile(dest + ".new", "w", zipfile.ZIP_DEFLATED) as out:
            for item in tz.infolist():
                out.writestr(item, doc if item.filename == "word/document.xml" else tz.read(item.filename))
    else:
        doc = ('<?xml version="1.0" encoding="UTF-8" standalone="yes"?><w:document xmlns:w="%s" xmlns:r="%s">'
               "<w:body>%s<w:sectPr><w:pgSz w:w=\"11906\" w:h=\"16838\"/><w:pgMar w:top=\"1417\" w:right=\"1417\" "
               "w:bottom=\"1134\" w:left=\"1417\" w:header=\"708\" w:footer=\"708\" w:gutter=\"0\"/></w:sectPr>"
               "</w:body></w:document>") % (W, R, docx_body(blocks, {"Heading%d" % i for i in range(1, 7)} | {"ListBullet"}))
        with zipfile.ZipFile(dest + ".new", "w", zipfile.ZIP_DEFLATED) as out:
            out.writestr("[Content_Types].xml", DOCX_TYPES)
            out.writestr("_rels/.rels", DOCX_RELS)
            out.writestr("word/_rels/document.xml.rels", DOCX_DOC_RELS)
            out.writestr("word/styles.xml", DOCX_STYLES)
            out.writestr("word/document.xml", doc)
    replace(dest)


def odt_body(blocks):
    out, table, items = [], [], []

    def end_list():
        if items:
            out.append("<text:list>%s</text:list>" % "".join(
                "<text:list-item><text:p>%s</text:p></text:list-item>" % escape(t) for t in items))
            items.clear()

    def end_table():
        if table:
            width = max(len(r) for r in table)
            rows = "".join("<table:table-row>%s</table:table-row>" % "".join(
                '<table:table-cell office:value-type="string"><text:p>%s</text:p></table:table-cell>' % escape(c)
                for c in r + [""] * (width - len(r))) for r in table)
            out.append('<table:table table:name="Table%d"><table:table-column table:number-columns-repeated="%d"/>%s</table:table>'
                       % (len(out) + 1, width, rows))
            table.clear()

    for b in blocks:
        if b[0] != "li":
            end_list()
        if b[0] != "row":
            end_table()
        if b[0] == "h":
            out.append('<text:h text:style-name="Heading_20_%d" text:outline-level="%d">%s</text:h>' % (b[1], b[1], escape(b[2])))
        elif b[0] == "li":
            items.append(b[1])
        elif b[0] == "row":
            table.append(b[1])
        else:
            out.append('<text:p text:style-name="Text_20_body">%s</text:p>' % escape(b[1]))
    end_list()
    end_table()
    return "".join(out)


ODT_NS = " ".join('xmlns:%s="%s"' % kv for kv in ODF.items())


def text_to_odt(src, dest, template=None):
    body = odt_body(parse_text(src))
    if template and zipfile.is_zipfile(template):
        tz = zipfile.ZipFile(template)
        content = tz.read("content.xml").decode("utf-8")
        # Keep declarations at the start of office:text (sequences, forms).
        content = re.sub(r"(<office:text[^>]*>)(.*)(</office:text>)",
                         lambda m: m.group(1) + "".join(re.findall(
                             r"<(?:text:sequence-decls|office:forms|text:variable-decls)\b.*?(?:/>|</(?:text:sequence-decls|office:forms|text:variable-decls)>)",
                             m.group(2), re.S)) + body + m.group(3), content, flags=re.S)
        with zipfile.ZipFile(dest + ".new", "w") as out:
            for item in tz.infolist():
                data = content if item.filename == "content.xml" else tz.read(item.filename)
                out.writestr(item, data, zipfile.ZIP_STORED if item.filename == "mimetype" else zipfile.ZIP_DEFLATED)
    else:
        content = ('<?xml version="1.0" encoding="UTF-8"?><office:document-content %s office:version="1.2">'
                   "<office:body><office:text>%s</office:text></office:body></office:document-content>") % (ODT_NS, body)
        write_odf(dest + ".new", "application/vnd.oasis.opendocument.text", content)
    replace(dest)


def write_odf(path, mime, content):
    with zipfile.ZipFile(path, "w") as out:
        out.writestr("mimetype", mime, zipfile.ZIP_STORED)          # must come first, uncompressed
        out.writestr("META-INF/manifest.xml",
                     '<?xml version="1.0" encoding="UTF-8"?><manifest:manifest xmlns:manifest="urn:oasis:names:tc:opendocument:xmlns:manifest:1.0" manifest:version="1.2">'
                     '<manifest:file-entry manifest:full-path="/" manifest:media-type="%s"/>'
                     '<manifest:file-entry manifest:full-path="content.xml" manifest:media-type="text/xml"/>'
                     "</manifest:manifest>" % mime, zipfile.ZIP_DEFLATED)
        out.writestr("content.xml", content, zipfile.ZIP_DEFLATED)


def replace(dest):
    import os
    os.replace(dest + ".new", dest)


# ========================================================= spreadsheets
# sc-im numbers rows from 0 (A0); Excel and ODS from 1 (A1).

EXCEL_TO_SC = {"SUM": "@sum", "AVERAGE": "@avg", "MIN": "@min", "MAX": "@max", "COUNT": "@count",
               "ABS": "@abs", "SQRT": "@sqrt", "ROUND": "@round", "INT": "@int", "EXP": "@exp", "LN": "@ln",
               "LOG10": "@log", "PI": "@pi", "STDEV": "@stddev", "NOW": "@now", "TODAY": "@now",
               "SIN": "@sin", "COS": "@cos", "TAN": "@tan", "IF": "@if"}
SC_TO_EXCEL = {v: k for k, v in EXCEL_TO_SC.items() if k not in ("TODAY",)}
REF = re.compile(r"\$?\b([A-Z]{1,3})\$?(\d+)\b")


def shift_refs(formula, delta):
    return REF.sub(lambda m: "%s%d" % (m.group(1), int(m.group(2)) + delta), formula)


def excel_to_sc(formula):
    f = formula.lstrip("=")
    if re.search(r"[A-Za-z]+!|\[|\"", f):                  # other sheets, structured refs, text: too hard
        return None
    for name in sorted(EXCEL_TO_SC, key=len, reverse=True):
        f = re.sub(r"\b%s\(" % name, EXCEL_TO_SC[name] + "(", f, flags=re.I)
    if re.search(r"\b[A-Z]{2,}\(", f):                      # a function sc-im does not know
        return None
    return shift_refs(f, -1)


def sc_to_excel(expr):
    f = shift_refs(expr, +1)
    for name, xl in SC_TO_EXCEL.items():
        f = f.replace(name + "(", xl + "(")
    return re.sub(r"@(\w+)", lambda m: m.group(1).upper(), f)


def col_index(letters):
    n = 0
    for ch in letters:
        n = n * 26 + ord(ch) - 64
    return n - 1


def col_letters(i):
    s = ""
    i += 1
    while i:
        i, r = divmod(i - 1, 26)
        s = chr(65 + r) + s
    return s


def read_xlsx(path):
    """First sheet -> {(col, row0): ("n", value) | ("s", text) | ("f", formula, cached)}"""
    z = zipfile.ZipFile(path)
    shared = []
    if "xl/sharedStrings.xml" in z.namelist():
        for si in ET.fromstring(z.read("xl/sharedStrings.xml")).findall(q(S, "si")):
            shared.append("".join(t.text or "" for t in si.iter(q(S, "t"))))
    wb = ET.fromstring(z.read("xl/workbook.xml"))
    rels = ET.fromstring(z.read("xl/_rels/workbook.xml.rels"))
    first = wb.find(q(S, "sheets"))[0]
    rid = first.get(q(R, "id"))
    target = next(r.get("Target") for r in rels if r.get("Id") == rid)
    target = target.lstrip("/") if target.startswith("/") else "xl/" + target
    cells = {}
    for c in ET.fromstring(z.read(target)).iter(q(S, "c")):
        m = re.match(r"([A-Z]+)(\d+)", c.get("r", ""))
        if not m:
            continue
        key = (col_index(m.group(1)), int(m.group(2)) - 1)
        t = c.get("t", "n")
        v = c.findtext(q(S, "v"))
        f = c.findtext(q(S, "f"))
        if t == "s" and v is not None:
            cells[key] = ("s", shared[int(v)])
        elif t == "inlineStr":
            cells[key] = ("s", "".join(x.text or "" for x in c.iter(q(S, "t"))))
        elif t == "str":
            cells[key] = ("s", v or "")
        elif t == "b":
            cells[key] = ("n", v or "0")
        elif f:
            cells[key] = ("f", f, v)
        elif v is not None:
            cells[key] = ("n", v)
    return cells


def read_ods(path):
    z = zipfile.ZipFile(path)
    root = ET.fromstring(z.read("content.xml"))
    table = next(root.iter(q(ODF["table"], "table")))
    cells, row = {}, 0
    T, O = ODF["table"], ODF["office"]
    for tr in table.iter(q(T, "table-row")):
        rrep = int(tr.get(q(T, "number-rows-repeated"), "1"))
        col = 0
        for tc in tr:
            if tc.tag not in (q(T, "table-cell"), q(T, "covered-table-cell")):
                continue
            crep = int(tc.get(q(T, "number-columns-repeated"), "1"))
            vtype = tc.get(q(O, "value-type"))
            formula = tc.get(q(T, "formula"))
            text = "\n".join("".join(p.itertext()) for p in tc.findall(q(ODF["text"], "p")))
            value = tc.get(q(O, "value"))
            if vtype and rrep < 1000 and crep < 1000:          # skip the "rest of the sheet" filler
                for dr in range(rrep):
                    for dc in range(crep):
                        key = (col + dc, row + dr)
                        if formula:
                            f = re.sub(r"^of:=", "=", formula)
                            f = re.sub(r"\[\.?([A-Z]+\d+)(?::\.?([A-Z]+\d+))?\]",
                                       lambda m: m.group(1) + (":" + m.group(2) if m.group(2) else ""), f)
                            cells[key] = ("f", f.replace(";", ","), value)
                        elif vtype in ("float", "percentage", "currency"):
                            cells[key] = ("n", value)
                        elif vtype == "boolean":
                            cells[key] = ("n", "1" if tc.get(q(O, "boolean-value")) == "true" else "0")
                        else:
                            cells[key] = ("s", text)
            col += crep
        row += rrep
    return cells


def sheet_to_sc(src, dest):
    cells = read_xlsx(src) if ext(src) == "xlsx" else read_ods(src)
    lines = ["# Converted by Kilobyte from %s" % src.rsplit("/", 1)[-1]]
    for (c, r), cell in sorted(cells.items(), key=lambda kv: (kv[0][1], kv[0][0])):
        ref = "%s%d" % (col_letters(c), r)
        if cell[0] == "s":
            text = cell[1].replace("\\", "\\\\").replace('"', '\\"').replace("\n", " ")
            lines.append('leftstring %s = "%s"' % (ref, text))
        elif cell[0] == "n":
            lines.append("let %s = %s" % (ref, cell[1]))
        else:
            sc = excel_to_sc(cell[1])
            if sc:
                lines.append("let %s = %s" % (ref, sc))
            elif cell[2] is not None:                        # keep the last result
                try:
                    float(cell[2])
                    lines.append("let %s = %s" % (ref, cell[2]))
                except ValueError:
                    lines.append('leftstring %s = "%s"' % (ref, cell[2]))
    with open(dest, "w", encoding="utf-8") as f:
        f.write("\n".join(lines) + "\n")


def read_sc(path):
    """sc-im file -> {(col, row0): ("n", v) | ("s", text) | ("f", excel_formula)}"""
    cells = {}
    for line in open(path, encoding="utf-8", errors="replace"):
        m = re.match(r'^(let|label|leftstring|rightstring)\s+([A-Z]+)(\d+)\s*=\s*(.*)$', line.strip())
        if not m:
            continue
        kind, col, row, rhs = m.groups()
        key = (col_index(col), int(row))
        if kind == "let":
            try:
                float(rhs)
                cells[key] = ("n", rhs)
            except ValueError:
                cells[key] = ("f", sc_to_excel(rhs))
        else:
            text = rhs.strip()
            if text.startswith('"') and text.endswith('"'):
                text = text[1:-1].replace('\\"', '"').replace("\\\\", "\\")
            cells[key] = ("s", text)
    return cells


def sc_to_xlsx(src, dest):
    cells = read_sc(src)
    rows = {}
    for (c, r), cell in cells.items():
        rows.setdefault(r, []).append((c, cell))
    xml = []
    for r in sorted(rows):
        cs = []
        for c, cell in sorted(rows[r]):
            ref = "%s%d" % (col_letters(c), r + 1)
            if cell[0] == "n":
                cs.append('<c r="%s"><v>%s</v></c>' % (ref, cell[1]))
            elif cell[0] == "s":
                cs.append('<c r="%s" t="inlineStr"><is><t xml:space="preserve">%s</t></is></c>' % (ref, escape(cell[1])))
            else:
                cs.append('<c r="%s"><f>%s</f></c>' % (ref, escape(cell[1])))
        xml.append('<row r="%d">%s</row>' % (r + 1, "".join(cs)))
    with zipfile.ZipFile(dest + ".new", "w", zipfile.ZIP_DEFLATED) as z:
        z.writestr("[Content_Types].xml",
                   '<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">'
                   '<Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/>'
                   '<Default Extension="xml" ContentType="application/xml"/>'
                   '<Override PartName="/xl/workbook.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"/>'
                   '<Override PartName="/xl/worksheets/sheet1.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/>'
                   "</Types>")
        z.writestr("_rels/.rels",
                   '<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">'
                   '<Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="xl/workbook.xml"/></Relationships>')
        z.writestr("xl/_rels/workbook.xml.rels",
                   '<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">'
                   '<Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet" Target="worksheets/sheet1.xml"/></Relationships>')
        z.writestr("xl/workbook.xml",
                   '<?xml version="1.0" encoding="UTF-8" standalone="yes"?><workbook xmlns="%s" xmlns:r="%s">'
                   '<sheets><sheet name="Sheet1" sheetId="1" r:id="rId1"/></sheets><calcPr fullCalcOnLoad="1"/></workbook>' % (S, R))
        z.writestr("xl/worksheets/sheet1.xml",
                   '<?xml version="1.0" encoding="UTF-8" standalone="yes"?><worksheet xmlns="%s"><sheetData>%s</sheetData></worksheet>'
                   % (S, "".join(xml)))
    replace(dest)


def excel_to_of(formula):
    """SUM(A1:A5)+B2 -> SUM([.A1:.A5])+[.B2]; ";" separates arguments."""
    ranges = []

    def keep(m):
        ranges.append("[.%s:.%s]" % (m.group(1), m.group(2)))
        return "\x00%d\x00" % (len(ranges) - 1)

    f = re.sub(r"\$?\b([A-Z]{1,3}\$?\d+):\$?([A-Z]{1,3}\$?\d+)\b", keep, formula.replace("$", ""))
    f = re.sub(r"\b([A-Z]{1,3}\d+)\b", r"[.\1]", f)
    f = re.sub(r"\x00(\d+)\x00", lambda m: ranges[int(m.group(1))], f)
    return f.replace(",", ";")


def sc_to_ods(src, dest):
    cells = read_sc(src)
    if cells:
        max_c = max(c for c, _ in cells)
        max_r = max(r for _, r in cells)
    else:
        max_c = max_r = 0
    rows = []
    for r in range(max_r + 1):
        tds = []
        for c in range(max_c + 1):
            cell = cells.get((c, r))
            if cell is None:
                tds.append("<table:table-cell/>")
            elif cell[0] == "n":
                tds.append('<table:table-cell office:value-type="float" office:value="%s"><text:p>%s</text:p></table:table-cell>'
                           % (cell[1], cell[1]))
            elif cell[0] == "s":
                tds.append('<table:table-cell office:value-type="string"><text:p>%s</text:p></table:table-cell>' % escape(cell[1]))
            else:
                of = "of:=" + excel_to_of(cell[1])
                tds.append('<table:table-cell table:formula="%s" office:value-type="float"/>' % escape(of, {'"': "&quot;"}))
        rows.append("<table:table-row>%s</table:table-row>" % "".join(tds))
    content = ('<?xml version="1.0" encoding="UTF-8"?><office:document-content %s office:version="1.2">'
               '<office:body><office:spreadsheet><table:table table:name="Sheet1">'
               '<table:table-column table:number-columns-repeated="%d"/>%s</table:table>'
               "</office:spreadsheet></office:body></office:document-content>") % (ODT_NS, max_c + 1, "".join(rows))
    write_odf(dest + ".new", "application/vnd.oasis.opendocument.spreadsheet", content)
    replace(dest)


# ================================================================= main

def main(argv):
    if len(argv) < 3:
        sys.exit(__doc__)
    cmd, src, dest = argv[0], argv[1], argv[2]
    template = argv[3] if len(argv) > 3 else None
    if cmd == "doc-to-text":
        text = docx_to_text(src) if ext(src) == "docx" else odt_to_text(src)
        open(dest, "w", encoding="utf-8").write(text)
    elif cmd == "text-to-doc":
        (text_to_docx if ext(dest) == "docx" else text_to_odt)(src, dest, template)
    elif cmd == "sheet-to-sc":
        sheet_to_sc(src, dest)
    elif cmd == "sc-to-sheet":
        (sc_to_xlsx if ext(dest) == "xlsx" else sc_to_ods)(src, dest)
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main(sys.argv[1:])
