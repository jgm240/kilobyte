#!/usr/bin/python3
"""kb-office: office files for Kilobyte's text-mode programs.

Documents (DOCX, ODT) become plain text for the Editor and back:
    kb-office doc-to-text  DOC.docx|odt  OUT.txt
    kb-office text-to-doc  IN.txt  DOC.docx|odt  [TEMPLATE]

Spreadsheets (XLSX, ODS) become sc-im sheets and back:
    kb-office sheet-to-sc  BOOK.xlsx|ods  OUT.sc
    kb-office sc-to-sheet  IN.sc  BOOK.xlsx|ods

The text form: paragraphs separated by blank lines, "# " to "###### " for
headings, "- " for list items, "| a | b |" for table rows. When a document
is written back with a TEMPLATE (the original file), everything but the
text is kept: styles, headers, footers, page setup, pictures' files.
Spreadsheets keep values, text and formulas of the first sheet; formatting
is not kept. Only the Python standard library is used.
"""
import re
import sys
import zipfile
import xml.etree.ElementTree as ET
from xml.sax.saxutils import escape

W = "http://schemas.openxmlformats.org/wordprocessingml/2006/main"
S = "http://schemas.openxmlformats.org/spreadsheetml/2006/main"
R = "http://schemas.openxmlformats.org/officeDocument/2006/relationships"
ODF = {
    "office": "urn:oasis:names:tc:opendocument:xmlns:office:1.0",
    "text": "urn:oasis:names:tc:opendocument:xmlns:text:1.0",
    "table": "urn:oasis:names:tc:opendocument:xmlns:table:1.0",
    "style": "urn:oasis:names:tc:opendocument:xmlns:style:1.0",
    "fo": "urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0",
}


def q(ns, tag):
    return "{%s}%s" % (ns, tag)


def ext(path):
    return path.rsplit(".", 1)[-1].lower()


# ============================================================ documents

def docx_to_text(path):
    z = zipfile.ZipFile(path)
    body = ET.fromstring(z.read("word/document.xml")).find(q(W, "body"))
    out = []

    def para_text(p):
        parts = []
        for node in p.iter():
            if node.tag == q(W, "t"):
                parts.append(node.text or "")
            elif node.tag == q(W, "tab"):
                parts.append("\t")
            elif node.tag in (q(W, "br"), q(W, "cr")):
                parts.append(" ")
        return "".join(parts).strip()

    for el in body:
        if el.tag == q(W, "p"):
            text = para_text(el)
            style = el.find(".//" + q(W, "pStyle"))
            sid = style.get(q(W, "val"), "") if style is not None else ""
            m = re.match(r"(?i)heading\s*(\d)", sid)
            is_list = el.find(".//" + q(W, "numPr")) is not None or re.match(r"(?i)list", sid)
            if is_list and text:
                out.append("- " + text)
            elif m and text:
                out.append("#" * int(m.group(1)) + " " + text)
            elif sid.lower() == "title" and text:
                out.append("# " + text)
            else:
                out.append(text)
        elif el.tag == q(W, "tbl"):
            for row in el.findall(q(W, "tr")):
                cells = [" ".join(para_text(p) for p in tc.findall(".//" + q(W, "p"))) for tc in row.findall(q(W, "tc"))]
                out.append("| " + " | ".join(cells) + " |")
    return join_blocks(out)


def odt_to_text(path):
    z = zipfile.ZipFile(path)
    root = ET.fromstring(z.read("content.xml"))
    office_text = root.find(".//" + q(ODF["office"], "text"))
    out = []

    def text_of(el):
        parts = [el.text or ""]
        for child in el:
            if child.tag == q(ODF["text"], "s"):
                parts.append(" " * int(child.get(q(ODF["text"], "c"), "1")))
            elif child.tag == q(ODF["text"], "tab"):
                parts.append("\t")
            elif child.tag == q(ODF["text"], "line-break"):
                parts.append(" ")
            elif child.tag in (q(ODF["text"], "note"),):
                pass
            else:
                parts.append(text_of(child))
            parts.append(child.tail or "")
        return "".join(parts)

    def walk(el, in_list=False):
        for child in el:
            tag = child.tag
            if tag == q(ODF["text"], "h"):
                level = int(child.get(q(ODF["text"], "outline-level"), "1"))
                out.append("#" * min(level, 6) + " " + text_of(child).strip())
            elif tag == q(ODF["text"], "p"):
                t = text_of(child).strip()
                out.append(("- " + t) if in_list and t else t)
            elif tag == q(ODF["text"], "list"):
                walk(child, True)
            elif tag in (q(ODF["text"], "list-item"), q(ODF["text"], "section")):
                walk(child, in_list)
            elif tag == q(ODF["table"], "table"):
                for row in child.iter(q(ODF["table"], "table-row")):
                    cells = [" ".join(text_of(p).strip() for p in cell.iter(q(ODF["text"], "p")))
                             for cell in row.findall(q(ODF["table"], "table-cell"))]
                    out.append("| " + " | ".join(cells) + " |")

    walk(office_text)
    return join_blocks(out)


def join_blocks(lines):
    """Paragraphs with a blank line between them; list items and table rows
    stay together."""
    out = []
    for line in lines:
        if not line:
            continue
        kind = "list" if line.startswith("- ") else "table" if line.startswith("| ") else "p"
        if out and not (kind != "p" and out[-1][0] == kind):
            out.append(("gap", ""))
        out.append((kind, line))
    return "\n".join(text for _, text in out) + "\n"


def parse_text(path):
    """Plain text -> blocks: ("h", level, text), ("p", text), ("li", text), ("row", [cells])."""
    blocks, para = [], []

    def flush():
        if para:
            blocks.append(("p", " ".join(para)))
            para.clear()

    for raw in open(path, encoding="utf-8", errors="replace").read().splitlines():
        line = raw.rstrip()
        if not line.strip():
            flush()
            continue
        m = re.match(r"^(#{1,6})\s+(.*)", line)
        if m:
            flush()
            blocks.append(("h", len(m.group(1)), m.group(2).strip()))
        elif re.match(r"^\s*[-*]\s+", line):
            flush()
            blocks.append(("li", re.sub(r"^\s*[-*]\s+", "", line)))
        elif line.startswith("|") and line.endswith("|"):
            flush()
            cells = [c.strip() for c in line.strip("|").split("|")]
            if not all(re.fullmatch(r":?-{2,}:?", c) for c in cells if c):   # markdown ruler
                blocks.append(("row", cells))
        else:
            para.append(line.strip())
    flush()
    return blocks


def w_run(text):
    return '<w:r><w:t xml:space="preserve">%s</w:t></w:r>' % escape(text)


def docx_body(blocks, styles):
    """WordprocessingML for the blocks; styles: ids that exist in the file."""
    heading_id = {}
    for i in range(1, 7):
        for candidate in ("Heading%d" % i, "heading%d" % i, "berschrift%d" % i, "Titre%d" % i):
            if candidate in styles:
                heading_id[i] = candidate
                break
        heading_id.setdefault(i, "Heading%d" % i)
    list_style = next((s for s in ("ListBullet", "ListParagraph", "Listenabsatz") if s in styles), None)
    out, table = [], []

    def end_table():
        if table:
            rows = "".join("<w:tr>%s</w:tr>" % "".join(
                "<w:tc><w:p>%s</w:p></w:tc>" % w_run(c) for c in cells) for cells in table)
            out.append('<w:tbl><w:tblPr><w:tblStyle w:val="TableGrid"/><w:tblW w:w="0" w:type="auto"/>'
                       '<w:tblBorders><w:top w:val="single" w:sz="4"/><w:left w:val="single" w:sz="4"/>'
                       '<w:bottom w:val="single" w:sz="4"/><w:right w:val="single" w:sz="4"/>'
                       '<w:insideH w:val="single" w:sz="4"/><w:insideV w:val="single" w:sz="4"/>'
                       "</w:tblBorders></w:tblPr>%s</w:tbl>" % rows)
            table.clear()

    for b in blocks:
        if b[0] != "row":
            end_table()
        if b[0] == "h":
            out.append('<w:p><w:pPr><w:pStyle w:val="%s"/></w:pPr>%s</w:p>' % (heading_id[b[1]], w_run(b[2])))
        elif b[0] == "li":
            style = '<w:pStyle w:val="%s"/>' % list_style if list_style else ""
            out.append("<w:p><w:pPr>%s</w:pPr>%s</w:p>" % (style, w_run("• " + b[1] if not list_style else b[1])))
        elif b[0] == "row":
            table.append(b[1])
        else:
            out.append("<w:p>%s</w:p>" % w_run(b[1]))
    end_table()
    return "".join(out)


