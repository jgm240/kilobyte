app_field() { # app_field ID N: the Nth column of the program's first line
    apps_table | awk -F'|' -v id="$1" -v n="$2" '$1 == id { print $n; exit }'
}

# run_app ID [ARGUMENTS]: run that program here, in this terminal.
run_app() {
    local id=$1
    shift
    if [ -r "$PARENTAL" ] && [[ " $(parental_blocked) " == *" $id "* ]]; then
        kb_msg "Kilobyte" "A parent turned this program off for you." 7 50
        return
    fi
    case $id in
        Editor)      run_editor "$@" ;;
        Spreadsheet) run_spreadsheet "$@" ;;
        Web)         run_web "$@" ;;
        Mail)        run_mail ;;
        Files)       run_files "$@" ;;
        Terminal)    run_terminal ;;
        Feeds)       "$APPS/feeds" ;;
        Chat)        "$APPS/chat" ;;
        BBS)         "$APPS/bbs" ;;
        BBSHost)     "$APPS/bbshost" ;;
        Messenger)   kb_run python3 "$KB_LIB/py/messenger.py" ;;
        YouTube)     "$APPS/youtube" ;;
        Network)     "$APPS/netdrives" ;;
        TimeMachine) "$APPS/timemachine" "$@" ;;
        Remote)      "$APPS/remote" ;;
        Citrix)      "$APPS/citrix" "$@" ;;
        Video)       "$APPS/player" "$@" ;;
        Pictures)    "$APPS/pictures" "$@" ;;
        Camera)      "$APPS/camera" "$@" ;;
        Music)       run_music "$@" ;;
        Podcasts)    "$APPS/podcasts" "$@" ;;
        Disc)        "$APPS/disc" ;;
        Sound)       kb_guarded '\e' alsamixer ;;
        Paint)       kb_run "$APPS/paint" "$@" ;;
        ASCIIArt)    "$APPS/asciiart" ;;
        Today)       "$APPS/today" ;;
        Notes)       "$APPS/notes" ;;
        Dictionary)  "$APPS/dictionary" ;;
        Encyclopedia) "$APPS/wikipedia" ;;
        Calculator)  "$APPS/calculator" ;;
        Agenda)      kb_guarded q calcurse ;;
        Clock)       "$APPS/clock" ;;
        Cardfile)    "$APPS/cardfile" ;;
        Battery)     "$APPS/battery" ;;
        Month)       kb_dialog --title " Calendar " --ok-label "Close" --no-cancel --calendar "Use Tab and the arrow keys to move." 0 0 >/dev/null ;;
        Charmap)     kb_textfile "Character Map" "$KB_SHARE/charmap.txt" ;;
        Print)       "$APPS/print" "$@" ;;
        USB)         "$APPS/usb" ;;
        Backup)      "$APPS/backup" ;;
        Typing)      "$APPS/typing" ;;
        Sync)        "$APPS/sync" ;;
        Trash)       "$APPS/trash" ;;
        Wine)        "$APPS/wine" "$@" ;;
        DOS)         "$APPS/dos" "$@" ;;
        Store)       "$APPS/store" ;;
        Saver)       run_saver ;;
        Lock)        "$APPS/lock" ;;
        Mines)       kb_run "$APPS/mines" ;;
        Solitaire)   kb_run "$APPS/solitaire" ;;
        Reversi)     kb_run "$APPS/reversi" ;;
        Chess)       kb_run "$APPS/chess" ;;
        Sudoku)      kb_guarded Q nudoku ;;
        Stories)     "$APPS/stories" ;;
        MoonBuggy)   kb_guarded '' /usr/games/moon-buggy ;;
        Snake)       kb_run /usr/games/worm ;;
        Robots)      kb_run /usr/games/robots ;;
        Hangman)     kb_run /usr/games/hangman ;;
        Adventure)   kb_guarded '' /usr/games/adventure ;;
        Rain)        kb_run /usr/games/rain ;;
        Worms)       kb_run /usr/games/worms ;;
        Find)        "$APPS/kbfind" "$@" ;;
        Settings)
            "$APPS/settings" "$@"
            # 42: Kilobyte was updated, so the new one should run.
            if [ $? -eq 42 ]; then
                if [ -n "${KB_APP_WINDOW:-}" ]; then
                    kb_yesno "Kilobyte Update" "The new Kilobyte is used after logging out and in.\n\nLog out now? (Every window is closed.)" 9 60 &&
                        kill -USR1 "${KB_DESK_PID:-0}" 2>/dev/null
                else
                    [ -n "${KB_STTY:-}" ] && stty "$KB_STTY"
                    exec /usr/bin/kilobyte
                fi
            fi ;;
        Install)     kb_sudo && sudo KB_THEME="$(kb_theme_name)" /usr/sbin/kilobyte-install ;;
        Help)        kb_textfile "Help" "$KB_SHARE/help.txt" ;;
        Users)       "$APPS/settings" SwitchUser ;;
        Shutdown)    shut_down ;;
        Restart)     kb_yesno "Restart" "Restart the computer now?" && { clear; kb_sound shutdown wait; sudo -n "$KB_LIB/kb-root" power reboot; } ;;
        Store:*)     "$APPS/store" --run "${id#Store:}" ;;
        OpenX)       "$APPS/xopen" "$@" ;;
        Apt:*)       "$APPS/xopen" --app "${id#Apt:}" ;;
        *)           kb_msg "Kilobyte" "There is no program called \"$id\"." ;;
    esac
}

# launch ID [ARGUMENTS]: start a program. In Kilobyte Desktop it gets a
# window of its own and the Program Manager stays where it is; without
# windows (or inside a program's window) it runs right here.
launch() {
    local id=$1 name size
    if [ -n "${KILOBYTE_DESK:-}" ] && [ -z "${KB_APP_WINDOW:-}" ] && [ -S "${KB_DESK_SOCK:-}" ]; then
        name=$(app_field "$id" 3) size=$(app_field "$id" 6)
        python3 "$KB_LIB/py/deskrun.py" window "${name:-$id}" "${size:-M}" /usr/bin/kilobyte --app "$@" && return 0
    fi
    run_app "$@"
}

submenu() { # submenu TITLE TEXT TAG DESC HELP ...; prints the chosen tag
    local title=$1 text=$2; shift 2
    kb_dialog --title " $title " --item-help --ok-label "Run" --cancel-label "Back" \
        --default-item "${SUB_DEFAULT:-}" --menu "$text" 0 64 0 "$@"
}

# The menu of one category.
category_menu() { # category_menu CATEGORY TITLE TEXT
    local sel="" items=() id cat name help rest
    while IFS='|' read -r id cat name help rest; do
        [ "$cat" = "$1" ] && items+=("$id" "$name" "$help")
    done < <(apps_table)
    [ ${#items[@]} -gt 0 ] || return 0
    while sel=$(kb_dialog --title " $2 " --item-help --no-tags --ok-label "Run" --cancel-label "Back" \
            --default-item "$sel" --menu "$3" 0 64 0 "${items[@]}"); do
        launch "$sel"
    done
}

# Parental controls: say when the computer time is nearly up, and when it is.
KB_TIME_WARNED=
time_warning() {
    local left=""
    { read -r left _ < "/run/kilobyte-parental/${USER:-x}"; } 2>/dev/null || return 0
    [[ $left =~ ^[0-9]+$ ]] || return 0
    if [ "$left" -eq 0 ] && [ "$KB_TIME_WARNED" != 0 ]; then
        KB_TIME_WARNED=0
        kb_msg "Time Is Up" "\Z1\ZbThe computer time is up.\Zn\n\nSave your work now: in a minute this session ends." 9 56
    elif [ "$left" -gt 0 ] && [ "$left" -le 5 ] && [ -z "$KB_TIME_WARNED" ]; then
        KB_TIME_WARNED=5
        kb_msg "Nearly Time" "\ZbOnly $left minutes of computer time are left.\Zn\n\nTime to finish what you are doing." 9 56
    fi
}

# Warn once when the battery runs low; again only after it was charged.
KB_BATTERY_WARNED=
battery_warning() {
    local bat pct
    bat=$(kb_battery) || return 0
    pct=${bat%%%*}
    if [ "${bat: -1}" = + ] || [ "$pct" -gt 15 ]; then
        KB_BATTERY_WARNED=
    elif [ "$pct" -le 10 ] && [ -z "$KB_BATTERY_WARNED" ]; then
        KB_BATTERY_WARNED=1
        kb_msg "Battery Low" "\Z1\ZbThe battery is at $pct%.\Zn\n\nPlug in the charger soon, or save your work." 9 52
    fi
}

# The screen saver, in the mode chosen in Settings (random if none).
run_saver() {
    "$APPS/saver" "$(cat "$KB_CONF/saver-mode" 2>/dev/null || echo random)"
    kb_load_theme
}

saver_minutes() {
    local m
    m=$(cat "$KB_CONF/saver-minutes" 2>/dev/null)
    [[ $m =~ ^[0-9]+$ ]] && echo "$m" || echo 5
}

# Weather and news beside the menu, on screens wide enough for both.
tiles_args() {
    local cols rows weather news wl nl x
    [ -e "$KB_CONF/tiles-off" ] && return
    [ -n "${KILOBYTE_DESK:-}" ] && return      # Kilobyte Desktop shows them on the desktop
    cols=$(tput cols) rows=$(tput lines)
    [ "$cols" -ge 132 ] && [ "$rows" -ge 30 ] || return
    # New weather and news are fetched in the background, at most every five
    # minutes; the saved ones are read straight from their files.
    if [ "$SECONDS" -ge "${KB_TILES_NEXT:-0}" ]; then
        KB_TILES_NEXT=$(( SECONDS + 300 ))
        "$KB_LIB/kb-tiles" refresh </dev/null >/dev/null 2>&1 &
    fi
    local lines=() line
    weather="" news="" wl=0 nl=0
    { mapfile -t lines < "$KB_CONF/tiles/weather"; } 2>/dev/null
    wl=${#lines[@]}
    [ "$wl" -gt 0 ] && printf -v weather '%s\n' "${lines[@]}" && weather=${weather%$'\n'}
    lines=()
    { mapfile -t lines < "$KB_CONF/tiles/news"; } 2>/dev/null
    nl=${#lines[@]}
    for line in "${lines[@]}"; do news+="${line:0:58}"$'\n'; done
    news=${news%$'\n'}
    [ -n "$weather$news" ] || return
    x=$(( (cols - 62 - 2 - 64) / 2 + 64 ))
    if [ -n "$weather" ]; then
        printf '%s\0' --keep-window --no-collapse --begin 3 "$x" --title " Weather " \
            --infobox "$weather" $(( wl + 2 )) 62 --and-widget
    fi
    if [ -n "$news" ]; then
        printf '%s\0' --keep-window --no-collapse --begin $(( 3 + wl + 3 )) "$x" --title " News " \
            --infobox "$news" $(( nl + 2 )) 62 --and-widget
    fi
    # The menu goes to the left of the tiles (and needs its options again).
    printf '%s\0' --colors --cr-wrap --begin 3 $(( x - 66 ))
}

# kilobyte-transition in a terminal window rather than on a console of its
# own (the Mac's Lima machine, an SSH login): Exit just closes Kilobyte.
kb_in_window() {
    [ "$KB_VARIANT" = transition ] || return 1
    case $(tty 2>/dev/null) in /dev/tty[0-9]*) return 1 ;; esac
    return 0
}

shut_down() {
    if [ "$KB_VARIANT" = kindle ]; then
        kb_yesno "Exit" "Leave KilobytEink and go back to the Kindle?" 7 50 && exit 0
        return
    fi
    if [ "$KB_VARIANT" = wsl ] || kb_in_window; then
        kb_yesno "Exit" "Close Kilobyte? (kb open brings it back.)" 7 50 && exit 0
        return
    fi
    kb_yesno "Shut Down" "Turn off the computer now?" || return
    clear
    kb_sound shutdown wait
    sudo -n "$KB_LIB/kb-root" power poweroff 2>/dev/null ||
        kb_msg "Shut Down" "This computer cannot be turned off from Kilobyte."
}

# Returns 0 to stay, 10 to log out, 11 to drop to a shell, 12 to close
# this window.
quit_menu() {
    local sel items=()
    if [ "$KB_VARIANT" = kindle ]; then
        kb_yesno "Exit" "Leave KilobytEink and go back to the Kindle?" 7 50 && return 10
        return 0
    fi
    if [ "$KB_VARIANT" = wsl ] || kb_in_window; then
        kb_yesno "Exit" "Close Kilobyte? (kb open brings it back.)" 7 50 && return 10
        return 0
    fi
    [ -n "${KILOBYTE_DESK:-}" ] && items+=(Close "Close this window" "The other windows stay open")
    if [ "$KB_VARIANT" = transition ]; then
        # Next to a normal desktop: Kilobyte keeps its own console, and
        # logging out there would only log in again.
        items+=(Desktop "Back to the desktop" "Kilobyte stays as it is; \"kb open\" or this menu comes back")
    else
        items+=(Logout "Log out" "End this session")
    fi
    sel=$(submenu "Exit" "Leave Kilobyte." "${items[@]}" \
        Shell    "Exit to shell"          "Leave Kilobyte; type kilobyte to come back" \
        Restart  "Restart the computer"   "Reboot" \
        Shutdown "Shut down the computer" "Power off") || return 0
    case $sel in
        Close)    return 12 ;;
        Desktop)  clear; /usr/bin/kb close || { echo; read -r -n 1 -s -p "Press any key." || true; } ;;
        Logout)
            # In windows, log out means closing all of them.
            [ -n "${KB_DESK_PID:-}" ] && kill -USR1 "$KB_DESK_PID" 2>/dev/null
            return 10 ;;
        Shell)    return 11 ;;
        Restart)  kb_yesno "Restart" "Restart the computer now?" && { clear; kb_sound shutdown wait; sudo -n "$KB_LIB/kb-root" power reboot; } ;;
        Shutdown) shut_down ;;
    esac
    return 0
}

program_manager() {
    local sel=Editor rc items idle=0 tiles=() id cat name help rest
    while true; do
        battery_warning
        time_warning
        items=()
        local cats=" "
        while IFS='|' read -r id cat name help rest; do
            [ "$cat" = main ] && items+=("$id" "$name" "$help")
            cats+="$cat "
        done < <(apps_table)
        # Categories with nothing in them (on a Kindle: Media) are left out.
        [[ $cats == *" internet "* ]] && items+=(Internet "Internet  »" "News feeds, chat, Messenger, BBSes, online videos, network drives...")
        [[ $cats == *" media "* ]] && items+=(Media "Media  »" "Video player, music, podcasts, pictures, camera, discs")
        [[ $cats == *" accessories "* ]] && items+=(Accessories "Accessories  »" "Today, notes, dictionary, encyclopedia, backup, typing tutor, paint...")
        [[ $cats == *" games "* ]] && items+=(Games "Games  »" "Chess, Sudoku, text adventures, Mines, Solitaire...")
        [[ $cats == *" more "* ]] && items+=(More "More programs  »" "What you installed (Store, APT); graphical programs in X")
        items+=(Find "KBFind" "Find anything: programs, settings, files and what is in them (Ctrl+Space)")
        items+=(Settings "Settings" "Wi-Fi, theme, wallpaper, keyboard, date, software, users...")
        kb_is_live && items+=(Install "Install Kilobyte to disk" "Copy this system to the computer's hard disk")
        items+=(Help "Help" "How to use Kilobyte" Quit "Exit  »" "Log out, restart or shut down")

        # The timeout only redraws the clock in the top line. Ctrl-C here
        # (and only here) sets KB_CTRL_C instead of being ignored.
        KB_CTRL_C=
        kb_title "Program Manager"
        mapfile -d '' tiles < <(tiles_args)
        trap 'KB_CTRL_C=1' INT QUIT
        sel=$(kb_dialog "${tiles[@]}" --title " Program Manager " --timeout 30 --item-help \
            --default-item "$sel" --ok-label " Run " --cancel-label " Exit " \
            --menu "Choose with the arrow keys or first letter, then \ZbEnter\Zn." \
            0 62 0 "${items[@]}")
        rc=$?
        trap : INT QUIT
        if [ -n "$KB_CTRL_C" ]; then
            sel=${sel:-Editor}
            shut_down
            continue
        fi
        # Idle: the timeout counts toward the screen saver.
        if [ $rc -eq "$DIALOG_TIMEOUT" ]; then
            idle=$(( idle + 30 ))
            # (In Kilobyte Desktop the desktop starts the screen saver, over all windows.)
            if [ -z "${KILOBYTE_DESK:-}" ] && [ "$(saver_minutes)" -gt 0 ] && [ $idle -ge $(( $(saver_minutes) * 60 )) ] &&
               [ "$(cat "$KB_CONF/saver-mode" 2>/dev/null)" != off ]; then
                run_saver
                [ -e "$KB_CONF/saver-lock" ] && "$APPS/lock"
                idle=0
            fi
        else
            idle=0
        fi
        case $rc in
            "$DIALOG_TIMEOUT") sel=${sel:-Editor}; continue ;;
            "$DIALOG_CANCEL" | "$DIALOG_ESC") sel=Quit ;;
        esac
        case $sel in
            Internet)    category_menu internet "Internet" "On-line, the text way." ;;
            Media)       category_menu media "Media" "Videos, music, pictures and discs." ;;
            Accessories) category_menu accessories "Accessories" "Small helpers." ;;
            Games)       category_menu games "Games" "Take a break." ;;
            More)        category_menu more "More Programs" "Installed from the Store or with APT. Graphical ones open in X: F9 has their menu." ;;
            Quit)        quit_menu; rc=$?; [ $rc -ne 0 ] && return $rc ;;
            *)           launch "$sel" ;;
        esac
    done
}

case "${1:-}" in
    --version)   echo "Kilobyte $KB_VERSION"; exit 0 ;;
    --help)      echo "usage: kilobyte [--version | --list-apps | --app ID [ARGUMENTS]]"; exit 0 ;;
    --list-apps) apps_table; exit 0 ;;
    --app)
        # One program, here (Kilobyte Desktop gives it a window of its own).
        shift
        [ $# -gt 0 ] || { echo "usage: kilobyte --app ID [ARGUMENTS]" >&2; exit 2; }
        export KILOBYTE=1 KB_APP_WINDOW=1
        stty susp undef 2>/dev/null
        run_app "$@"
        exit 0 ;;
esac

command -v dialog >/dev/null || { echo "kilobyte: dialog is not installed" >&2; exit 1; }
kb_setup_home
kb_export_editor

# The CD version has no room for the screen reader: say how to get it, the
# first time (and each time Kilobyte was started "with speech" without it).
if [ "$KB_VARIANT" = cd ] && ! command -v espeakup >/dev/null &&
   { [ ! -e "$KB_CONF/accessibility-told" ] || grep -qw 'kilobyte.speech=1' /proc/cmdline 2>/dev/null; }; then
    kb_msg "Accessibility" "To use accessibility features, you need to download them. Make sure you have an internet connection and run 'kbutils dl accessibility'." 9 66
    : > "$KB_CONF/accessibility-told"
fi

# A Raspberry Pi 1 or Zero (one slow ARMv6 core) and the CD version (made for
# PCs from the 1990s, often with 128 MB) start without windows: every window
# is a terminal emulator of its own, which is too much for them. Once;
# Settings > Login and startup switches them on all the same.
if [ ! -e "$KB_CONF/windows-asked" ]; then
    kb_variant=""
    { read -r kb_variant < /etc/kilobyte/variant; } 2>/dev/null
    if [ "$kb_variant" = cd ] || [ "$(uname -m)" = armv6l ]; then
        : > "$KB_CONF/windows-asked"
        : > "$KB_CONF/windows-off"
    fi
fi

# Windows (movable windows, several programs at once) unless switched off in
# Settings > Login and startup, or speech was asked for at start-up (a screen
# reader follows one program at a time best). If the window system fails,
# carry on without.
kb_speech_boot=""
grep -qw 'kilobyte.speech=1' /proc/cmdline 2>/dev/null && kb_speech_boot=1
if [ -z "${KILOBYTE_DESK:-}" ] && [ ! -e "$KB_CONF/windows-off" ] && [ -z "$kb_speech_boot" ] && [ -t 0 ] &&
   python3 -c 'import pyte' 2>/dev/null; then
    kb_sound startup
    if "$KB_LIB/apps/desk" kilobyte; then
        # All windows closed: log out, unless windows were just switched off.
        [ -e "$KB_CONF/windows-off" ] || { clear; kb_palette ""; exit 0; }
    else
        echo "Kilobyte Desktop stopped unexpectedly; starting without windows." >&2
        sleep 2
    fi
fi
export KILOBYTE=1
# Ctrl-Z would suspend Kilobyte and leave a bare shell: switch it off.
KB_STTY=$(stty -g 2>/dev/null)
stty susp undef 2>/dev/null
# (kilobyte-transition is updated by apt, with the rest of the computer.)
[ "$KB_VARIANT" = transition ] || kb_update_check_later
[ -n "${KILOBYTE_DESK:-}" ] || kb_sound startup
# Today first, if chosen in its Options.
[ -e "$KB_CONF/today-at-start" ] && "$APPS/today"
program_manager
rc=$?
[ -n "$KB_STTY" ] && stty "$KB_STTY" 2>/dev/null
clear
kb_palette ""   # restore the console's own colours
[ $rc -eq 11 ] && { echo "Type kilobyte to return to the Program Manager."; exit 3; }
exit 0
