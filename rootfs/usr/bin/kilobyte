#!/bin/bash
# Kilobyte - a desktop environment that is not really one.
#
# The "desktop" is the Program Manager: a dialog(1) menu that launches
# fullscreen text-mode programs and returns when they exit.
#
# Ctrl-C never leaves Kilobyte: in the Program Manager it offers to shut
# down, in a menu it goes back, in a program it closes the program (see
# kb-guard for programs that would ignore it).
#
# Exit status: 0 log out, 3 the user chose "Exit to shell". Anything else is
# unexpected, and the login script starts Kilobyte again.

. /usr/lib/kilobyte/lib.sh

APPS=/usr/lib/kilobyte/apps

# Programs launched from the menus.

run_editor() { # run_editor [FILE]
    local f=${1:-}
    [ -n "$f" ] || f=$(kb_pick_file "Edit" "*") || return
    case ${f,,} in
        *.docx | *.odt) office_document "$f" ;;
        *)              kb_guarded '\e[21~' mcedit "$f" ;;   # F10 quits, asking to save first
    esac
}

run_spreadsheet() { # run_spreadsheet [FILE]
    local f=${1:-}
    [ -n "$f" ] || f=$(kb_pick_file "Spreadsheet" "*.sc" "*.csv" "*.tsv" "*.xlsx" "*.ods") || return
    case $f in *.*) ;; *) f="$f.sc" ;; esac
    case ${f,,} in
        *.xlsx | *.ods) office_sheet "$f" ;;
        *)              kb_guarded '\e:q\r' sc-im "$f" ;;
    esac
}

# Word and Writer documents (DOCX, ODT) are edited as plain text: headings
# "# ", list items "- ", table rows "| a | b |". Saving puts the text back
# into the document and keeps its styles, headers and page layout.
office_document() {
    local f=$1 tmp txt before
    tmp=$(mktemp -d)
    txt="$tmp/$(basename "${f%.*}").txt"
    if [ -s "$f" ]; then
        if ! "$KB_LIB/kb-office" doc-to-text "$f" "$txt" 2>"$tmp/err"; then
            kb_msg "Edit" "\Z1This document could not be opened.\Zn\n\n$(tail -n 1 "$tmp/err")" 10 64
            rm -rf "$tmp"
            return
        fi
        kb_info "Bold, italics and pictures are not shown here. Headings start with #, lists with -."
        sleep 2
    else
        printf '# %s\n\n' "$(basename "${f%.*}")" > "$txt"
    fi
    before=$(cksum < "$txt")
    kb_guarded '\e[21~' mcedit "$txt"
    if [ "$(cksum < "$txt")" != "$before" ] || [ ! -e "$f" ]; then
        if kb_yesno "Save Document" "Save your changes into \Zb$(basename "$f")\Zn?\n\nIts styles, headers and page layout are kept. A copy of the old version is kept as $(basename "$f")~." 11 66; then
            [ -e "$f" ] && cp "$f" "$f~"
            if "$KB_LIB/kb-office" text-to-doc "$txt" "$f" "$( [ -e "$f~" ] && echo "$f~")" 2>"$tmp/err"; then
                kb_msg "Save Document" "\ZbSaved.\Zn" 6 30
            else
                kb_msg "Save Document" "\Z1Saving failed:\Zn\n\n$(tail -n 1 "$tmp/err")\n\nYour text is still in $txt" 11 66
                return
            fi
        fi
    fi
    rm -rf "$tmp"
}

# Excel and Calc sheets (XLSX, ODS): values, text and formulas of the first
# sheet, edited in sc-im and written back when it was saved there (:w).
office_sheet() {
    local f=$1 tmp sc before
    tmp=$(mktemp -d)
    sc="$tmp/$(basename "${f%.*}").sc"
    if [ -s "$f" ]; then
        if ! "$KB_LIB/kb-office" sheet-to-sc "$f" "$sc" 2>"$tmp/err"; then
            kb_msg "Spreadsheet" "\Z1This spreadsheet could not be opened.\Zn\n\n$(tail -n 1 "$tmp/err")" 10 64
            rm -rf "$tmp"
            return
        fi
        kb_info "The first sheet opens. Colours and number formats are not kept. :w saves, :q quits."
        sleep 2
    else
        : > "$sc"
    fi
    before=$(cksum < "$sc")
    kb_guarded '\e:q\r' sc-im "$sc"
    if [ "$(cksum < "$sc")" != "$before" ]; then
        if kb_yesno "Save Spreadsheet" "Save your changes into \Zb$(basename "$f")\Zn?\n\nA copy of the old version is kept as $(basename "$f")~." 10 66; then
            [ -e "$f" ] && cp "$f" "$f~"
            if "$KB_LIB/kb-office" sc-to-sheet "$sc" "$f" 2>"$tmp/err"; then
                kb_msg "Save Spreadsheet" "\ZbSaved.\Zn" 6 30
            else
                kb_msg "Save Spreadsheet" "\Z1Saving failed:\Zn\n\n$(tail -n 1 "$tmp/err")\n\nYour sheet is still in $sc" 11 66
                return
            fi
        fi
    fi
    rm -rf "$tmp"
}

run_web() {
    kb_run elinks "${1:-file://$KB_SHARE/start.html}"
}

run_files() { # run_files [FOLDER]
    kb_guarded '\e[21~' mc "${1:-$HOME}" "$KB_DESKTOP"
}

run_terminal() {
    clear
    printf '\033[1;37;44m%*s\r  Kilobyte Terminal  -  type "exit" to return to the Program Manager\033[0m\n\n' "$(tput cols)" ""
    # A real shell: Ctrl-C and Ctrl-Z keep their usual meaning in here.
    stty susp '^Z'
    KILOBYTE_SHELL=1 bash -i
    stty susp undef
    kb_load_theme
}

# --- the programs ------------------------------------------------------------
# One table for the Program Manager's menus, the Programs menu and the icons
# of Kilobyte Windows (kilobyte --list-apps), and kb-open:
#
#   ID|category|name|help line|two characters for an icon|window size
#
# Window size: S small, M usual, L as large as the desktop allows.

apps_table() {
    cat <<'TABLE'
Editor|main|Text editor|Text files and documents (also DOCX, ODT); F9 opens the menus|Ed|L
Spreadsheet|main|Spreadsheet|Tables and formulas, also XLSX and ODS (sc-im: :w saves, :q quits)|##|L
Web|main|Web browser|Web pages with CSS and JavaScript (ELinks; Esc opens its menus)|@ |L
Mail|main|Email|Read and write email (Alpine; the first start sets up your account)|M@|L
Files|main|File manager|Two-panel file manager (mc, F10 quits); F2 has Open with, Trash, Desktop|▓▓|L
Terminal|main|Terminal|Command line, type exit to come back|>_|M
Web|internet|Web browser|Web pages with CSS and JavaScript (ELinks)|@ |L
Mail|internet|Email|Read and write email (Alpine)|M@|L
Chat|internet|Chat|Talk in chat rooms (IRC with WeeChat)|☺☺|L
BBS|internet|BBS Dialer|Call bulletin board systems that still run today|BB|M
YouTube|internet|YouTube Downloader|Search, watch and save videos or their sound|Yt|M
Network|internet|Network drives|Shared folders of Windows PCs and servers (SMB, SFTP)|⌂⌂|M
Remote|internet|Remote Kilobyte|Use another Kilobyte computer in a window (SSH)|≡→|L
Citrix|internet|Citrix Workspace|Remote desktops and apps of a company (needs Citrix's program)|Cx|M
Video|media|Video Player|Videos and music as coloured blocks or the real picture|Tv|M
Pictures|media|Pictures|Photos and drawings, shown with coloured blocks|▒▓|M
Music|media|Music Player|Songs and playlists with dancing bars|♫ |M
YouTube|media|YouTube Downloader|Search, watch and save videos or their sound|Yt|M
Disc|media|Disc Player|DVD films, audio CDs and data discs|◘ |M
Sound|media|Sound volume|alsamixer: arrows change, M mutes, Esc closes|♪ |M
Paint|accessories|Paint|Paint pictures with blocks; mouse or keyboard; saves PNG and ANSI art|▀▄|L
Calculator|accessories|Calculator|Type an expression, get the answer (bc)|+-|S
Agenda|accessories|Agenda|Calendar, appointments and to-do list (calcurse; ? inside for help)|31|M
Clock|accessories|Clock|Big block-letter clock; any key closes it|☼ |S
Cardfile|accessories|Cardfile|Index cards for notes and addresses, kept in ~/Cardfile|≡ |M
Month|accessories|Calendar|Pick a date on a month calendar|Ca|S
Battery|accessories|Battery meter|Charge, time left and battery health (laptops)|█▌|S
Charmap|accessories|Character Map|Box drawing and block characters for your own text art|Ω |M
Print|accessories|Print|Send a file to the printer|Pr|M
USB|accessories|USB sticks|Open, safely remove or format a USB stick|↔ |M
Backup|accessories|Backup|Copy documents and settings to a USB stick|»»|M
Trash|accessories|Trash|Files you threw away: put them back or delete them for good|▄▄|M
Wine|accessories|Windows programs|Run .exe and .msi programs with Wine (box64/box86 on a Raspberry Pi)|W |M
Store|accessories|Store|More text-mode programs to install with a keypress|$ |M
Saver|accessories|Screen saver|Start the screen saver now|**|L
Lock|accessories|Lock the screen|Hide everything until your password is typed|╬ |L
Mines|games|Mines|Clear the minefield: Space uncovers, F flags; 1/2/3 choose the size|* |M
Solitaire|games|Solitaire|Klondike patience: Space takes and puts cards, D draws|♠♥|M
Reversi|games|Reversi|Reversi against the computer|○◙|M
MoonBuggy|games|Moon Buggy|Drive across the moon: Space jumps, a fires, q quits|o=|M
Snake|games|Snake|Eat the numbers, grow longer: h j k l steer, q quits|~~|M
Robots|games|Robots|Outwit the killer robots: hjkl yubn move, t teleports, q quits|R |M
Hangman|games|Hangman|Guess the word: type letters|_a|M
Adventure|games|Adventure|Colossal Cave Adventure: type commands such as GO NORTH; QUIT ends|N↑|M
Trek|games|Trek|Star Trek: type help inside the game|-=|M
Rain|games|Rain|Rain on the screen; Ctrl+C stops it|' |M
Worms|games|Worms|Worms on the screen; Ctrl+C stops it|~ |M
Settings|system|Settings|Wi-Fi, theme, wallpaper, keyboard, date, software, users...|≡≡|M
Help|system|Help|How to use Kilobyte|? |M
Users|system|Switch user|Let someone else log in; your programs keep running|☺ |S
Shutdown|system|Shut down|Turn the computer off|O |S
Restart|system|Restart|Restart the computer|<>|S
TABLE
    # Programs installed from the Store.
    "$APPS/store" --table 2>/dev/null
    kb_is_live && echo "Install|system|Install Kilobyte|Copy this system to the computer's hard disk|↓↓|M"
    return 0
}

app_field() { # app_field ID N: the Nth column of the program's first line
    apps_table | awk -F'|' -v id="$1" -v n="$2" '$1 == id { print $n; exit }'
}

# run_app ID [ARGUMENTS]: run that program here, in this terminal.
run_app() {
    local id=$1
    shift
    case $id in
        Editor)      run_editor "$@" ;;
        Spreadsheet) run_spreadsheet "$@" ;;
        Web)         run_web "$@" ;;
        Mail)        "$APPS/mail" ;;
        Files)       run_files "$@" ;;
        Terminal)    run_terminal ;;
        Chat)        "$APPS/chat" ;;
        BBS)         "$APPS/bbs" ;;
        YouTube)     "$APPS/youtube" ;;
        Network)     "$APPS/netdrives" ;;
        Remote)      "$APPS/remote" ;;
        Citrix)      "$APPS/citrix" "$@" ;;
        Video)       "$APPS/player" "$@" ;;
        Pictures)    "$APPS/pictures" "$@" ;;
        Music)       kb_run "$APPS/music" "$@" ;;
        Disc)        "$APPS/disc" ;;
        Sound)       kb_guarded '\e' alsamixer ;;
        Paint)       kb_run "$APPS/paint" "$@" ;;
        Calculator)  "$APPS/calculator" ;;
        Agenda)      kb_guarded q calcurse ;;
        Clock)       "$APPS/clock" ;;
        Cardfile)    "$APPS/cardfile" ;;
        Battery)     "$APPS/battery" ;;
        Month)       kb_dialog --title " Calendar " --ok-label "Close" --no-cancel --calendar "Use Tab and the arrow keys to move." 0 0 >/dev/null ;;
        Charmap)     kb_textfile "Character Map" "$KB_SHARE/charmap.txt" ;;
        Print)       "$APPS/print" "$@" ;;
        USB)         "$APPS/usb" ;;
        Backup)      "$APPS/backup" ;;
        Trash)       "$APPS/trash" ;;
        Wine)        "$APPS/wine" "$@" ;;
        Store)       "$APPS/store" ;;
        Saver)       run_saver ;;
        Lock)        "$APPS/lock" ;;
        Mines)       kb_run "$APPS/mines" ;;
        Solitaire)   kb_run "$APPS/solitaire" ;;
        Reversi)     kb_run "$APPS/reversi" ;;
        MoonBuggy)   kb_guarded '' /usr/games/moon-buggy ;;
        Snake)       kb_run /usr/games/worm ;;
        Robots)      kb_run /usr/games/robots ;;
        Hangman)     kb_run /usr/games/hangman ;;
        Adventure)   kb_guarded '' /usr/games/adventure ;;
        Trek)        kb_guarded '' /usr/games/trek ;;
        Rain)        kb_run /usr/games/rain ;;
        Worms)       kb_run /usr/games/worms ;;
        Settings)
            "$APPS/settings" "$@"
            # 42: Kilobyte was updated, so the new one should run.
            if [ $? -eq 42 ]; then
                if [ -n "${KB_APP_WINDOW:-}" ]; then
                    kb_yesno "Kilobyte Update" "The new Kilobyte is used after logging out and in.\n\nLog out now? (Every window is closed.)" 9 60 &&
                        kill -USR1 "${KB_DESK_PID:-0}" 2>/dev/null
                else
                    [ -n "${KB_STTY:-}" ] && stty "$KB_STTY"
                    exec /usr/bin/kilobyte
                fi
            fi ;;
        Install)     kb_sudo && sudo KB_THEME="$(kb_theme_name)" /usr/sbin/kilobyte-install ;;
        Help)        kb_textfile "Help" "$KB_SHARE/help.txt" ;;
        Users)       "$APPS/settings" SwitchUser ;;
        Shutdown)    shut_down ;;
        Restart)     kb_yesno "Restart" "Restart the computer now?" && { clear; kb_sound shutdown wait; sudo -n "$KB_LIB/kb-root" power reboot; } ;;
        Store:*)     "$APPS/store" --run "${id#Store:}" ;;
        *)           kb_msg "Kilobyte" "There is no program called \"$id\"." ;;
    esac
}

# launch ID [ARGUMENTS]: start a program. In Kilobyte Windows it gets a
# window of its own and the Program Manager stays where it is; without
# windows (or inside a program's window) it runs right here.
launch() {
    local id=$1 name size
    if [ -n "${KILOBYTE_DESK:-}" ] && [ -z "${KB_APP_WINDOW:-}" ] && [ -S "${KB_DESK_SOCK:-}" ]; then
        name=$(app_field "$id" 3) size=$(app_field "$id" 6)
        python3 "$KB_LIB/py/deskrun.py" window "${name:-$id}" "${size:-M}" /usr/bin/kilobyte --app "$@" && return 0
    fi
    run_app "$@"
}

submenu() { # submenu TITLE TEXT TAG DESC HELP ...; prints the chosen tag
    local title=$1 text=$2; shift 2
    kb_dialog --title " $title " --item-help --ok-label "Run" --cancel-label "Back" \
        --default-item "${SUB_DEFAULT:-}" --menu "$text" 0 64 0 "$@"
}

# The menu of one category.
category_menu() { # category_menu CATEGORY TITLE TEXT
    local sel="" items=() id cat name help rest
    while IFS='|' read -r id cat name help rest; do
        [ "$cat" = "$1" ] && items+=("$id" "$name" "$help")
    done < <(apps_table)
    [ ${#items[@]} -gt 0 ] || return 0
    while sel=$(kb_dialog --title " $2 " --item-help --no-tags --ok-label "Run" --cancel-label "Back" \
            --default-item "$sel" --menu "$3" 0 64 0 "${items[@]}"); do
        launch "$sel"
    done
}

# Warn once when the battery runs low; again only after it was charged.
KB_BATTERY_WARNED=
battery_warning() {
    local bat pct
    bat=$(kb_battery) || return 0
    pct=${bat%%%*}
    if [ "${bat: -1}" = + ] || [ "$pct" -gt 15 ]; then
        KB_BATTERY_WARNED=
    elif [ "$pct" -le 10 ] && [ -z "$KB_BATTERY_WARNED" ]; then
        KB_BATTERY_WARNED=1
        kb_msg "Battery Low" "\Z1\ZbThe battery is at $pct%.\Zn\n\nPlug in the charger soon, or save your work." 9 52
    fi
}

# The screen saver, in the mode chosen in Settings (random if none).
run_saver() {
    "$APPS/saver" "$(cat "$KB_CONF/saver-mode" 2>/dev/null || echo random)"
    kb_load_theme
}

saver_minutes() {
    local m
    m=$(cat "$KB_CONF/saver-minutes" 2>/dev/null)
    [[ $m =~ ^[0-9]+$ ]] && echo "$m" || echo 5
}

# Weather and news beside the menu, on screens wide enough for both.
tiles_args() {
    local cols rows weather news wl nl x
    [ -e "$KB_CONF/tiles-off" ] && return
    [ -n "${KILOBYTE_DESK:-}" ] && return      # Kilobyte Windows shows them on the desktop
    cols=$(tput cols) rows=$(tput lines)
    [ "$cols" -ge 132 ] && [ "$rows" -ge 30 ] || return
    "$KB_LIB/kb-tiles" refresh </dev/null >/dev/null 2>&1 &
    weather=$("$KB_LIB/kb-tiles" weather) news=$("$KB_LIB/kb-tiles" news)
    [ -n "$weather$news" ] || return
    x=$(( (cols - 62 - 2 - 64) / 2 + 64 ))
    wl=$(printf '%s\n' "$weather" | wc -l) nl=$(printf '%s\n' "$news" | wc -l)
    if [ -n "$weather" ]; then
        printf '%s\0' --keep-window --no-collapse --begin 3 "$x" --title " Weather " \
            --infobox "$weather" $(( wl + 2 )) 62 --and-widget
    fi
    if [ -n "$news" ]; then
        printf '%s\0' --keep-window --no-collapse --begin $(( 3 + wl + 3 )) "$x" --title " News " \
            --infobox "$(printf '%s\n' "$news" | cut -c1-58)" $(( nl + 2 )) 62 --and-widget
    fi
    # The menu goes to the left of the tiles (and needs its options again).
    printf '%s\0' --colors --cr-wrap --begin 3 $(( x - 66 ))
}

shut_down() {
    kb_yesno "Shut Down" "Turn off the computer now?" || return
    clear
    kb_sound shutdown wait
    sudo -n "$KB_LIB/kb-root" power poweroff 2>/dev/null ||
        kb_msg "Shut Down" "This computer cannot be turned off from Kilobyte."
}

# Returns 0 to stay, 10 to log out, 11 to drop to a shell, 12 to close
# this window.
quit_menu() {
    local sel items=()
    [ -n "${KILOBYTE_DESK:-}" ] && items+=(Close "Close this window" "The other windows stay open")
    sel=$(submenu "Exit" "Leave Kilobyte." "${items[@]}" \
        Logout   "Log out"                "End this session" \
        Shell    "Exit to shell"          "Leave Kilobyte; type kilobyte to come back" \
        Restart  "Restart the computer"   "Reboot" \
        Shutdown "Shut down the computer" "Power off") || return 0
    case $sel in
        Close)    return 12 ;;
        Logout)
            # In windows, log out means closing all of them.
            [ -n "${KB_DESK_PID:-}" ] && kill -USR1 "$KB_DESK_PID" 2>/dev/null
            return 10 ;;
        Shell)    return 11 ;;
        Restart)  kb_yesno "Restart" "Restart the computer now?" && { clear; kb_sound shutdown wait; sudo -n "$KB_LIB/kb-root" power reboot; } ;;
        Shutdown) shut_down ;;
    esac
    return 0
}

program_manager() {
    local sel=Editor rc items idle=0 tiles=() id cat name help rest
    while true; do
        battery_warning
        items=()
        while IFS='|' read -r id cat name help rest; do
            [ "$cat" = main ] && items+=("$id" "$name" "$help")
        done < <(apps_table)
        items+=(
            Internet    "Internet  »"                "Chat, BBS dialer, YouTube, network drives, remote computers..."
            Media       "Media  »"                   "Video player, music, pictures, discs"
            Accessories "Accessories  »"             "Paint, calculator, agenda, trash, store, lock..."
            Games       "Games  »"                   "Mines, Solitaire, Moon Buggy, Adventure..."
        )
        apps_table | grep -q '^[^|]*|more|' && items+=(More "More programs  »" "What you installed from the Store")
        items+=(Settings "Settings" "Wi-Fi, theme, wallpaper, keyboard, date, software, users...")
        kb_is_live && items+=(Install "Install Kilobyte to disk" "Copy this system to the computer's hard disk")
        items+=(Help "Help" "How to use Kilobyte" Quit "Exit  »" "Log out, restart or shut down")

        # The timeout only redraws the clock in the top line. Ctrl-C here
        # (and only here) sets KB_CTRL_C instead of being ignored.
        KB_CTRL_C=
        kb_title "Program Manager"
        mapfile -d '' tiles < <(tiles_args)
        trap 'KB_CTRL_C=1' INT QUIT
        sel=$(kb_dialog "${tiles[@]}" --title " Program Manager " --timeout 30 --item-help \
            --default-item "$sel" --ok-label " Run " --cancel-label " Exit " \
            --menu "Choose with the arrow keys or first letter, then \ZbEnter\Zn." \
            0 62 0 "${items[@]}")
        rc=$?
        trap : INT QUIT
        if [ -n "$KB_CTRL_C" ]; then
            sel=${sel:-Editor}
            shut_down
            continue
        fi
        # Idle: the timeout counts toward the screen saver.
        if [ $rc -eq "$DIALOG_TIMEOUT" ]; then
            idle=$(( idle + 30 ))
            # (In Kilobyte Windows the desktop starts the screen saver, over all windows.)
            if [ -z "${KILOBYTE_DESK:-}" ] && [ "$(saver_minutes)" -gt 0 ] && [ $idle -ge $(( $(saver_minutes) * 60 )) ] &&
               [ "$(cat "$KB_CONF/saver-mode" 2>/dev/null)" != off ]; then
                run_saver
                [ -e "$KB_CONF/saver-lock" ] && "$APPS/lock"
                idle=0
            fi
        else
            idle=0
        fi
        case $rc in
            "$DIALOG_TIMEOUT") sel=${sel:-Editor}; continue ;;
            "$DIALOG_CANCEL" | "$DIALOG_ESC") sel=Quit ;;
        esac
        case $sel in
            Internet)    category_menu internet "Internet" "On-line, the text way." ;;
            Media)       category_menu media "Media" "Videos, music, pictures and discs." ;;
            Accessories) category_menu accessories "Accessories" "Small helpers." ;;
            Games)       category_menu games "Games" "Take a break." ;;
            More)        category_menu more "More Programs" "Installed from the Store." ;;
            Quit)        quit_menu; rc=$?; [ $rc -ne 0 ] && return $rc ;;
            *)           launch "$sel" ;;
        esac
    done
}

case "${1:-}" in
    --version)   echo "Kilobyte $KB_VERSION"; exit 0 ;;
    --help)      echo "usage: kilobyte [--version | --list-apps | --app ID [ARGUMENTS]]"; exit 0 ;;
    --list-apps) apps_table; exit 0 ;;
    --app)
        # One program, here (Kilobyte Windows gives it a window of its own).
        shift
        [ $# -gt 0 ] || { echo "usage: kilobyte --app ID [ARGUMENTS]" >&2; exit 2; }
        export KILOBYTE=1 KB_APP_WINDOW=1
        stty susp undef 2>/dev/null
        run_app "$@"
        exit 0 ;;
esac

command -v dialog >/dev/null || { echo "kilobyte: dialog is not installed" >&2; exit 1; }
kb_setup_home

# Windows (movable windows, several programs at once) unless switched off in
# Settings > Login and startup. If the window system fails, carry on without.
if [ -z "${KILOBYTE_DESK:-}" ] && [ ! -e "$KB_CONF/windows-off" ] && [ -t 0 ] &&
   python3 -c 'import pyte' 2>/dev/null; then
    kb_sound startup
    if "$KB_LIB/apps/desk" kilobyte; then
        # All windows closed: log out, unless windows were just switched off.
        [ -e "$KB_CONF/windows-off" ] || { clear; kb_palette ""; exit 0; }
    else
        echo "Kilobyte Windows stopped unexpectedly; starting without windows." >&2
        sleep 2
    fi
fi
export KILOBYTE=1
# Ctrl-Z would suspend Kilobyte and leave a bare shell: switch it off.
KB_STTY=$(stty -g 2>/dev/null)
stty susp undef 2>/dev/null
kb_update_check_later
[ -n "${KILOBYTE_DESK:-}" ] || kb_sound startup
program_manager
rc=$?
[ -n "$KB_STTY" ] && stty "$KB_STTY" 2>/dev/null
clear
kb_palette ""   # restore the console's own colours
[ $rc -eq 11 ] && { echo "Type kilobyte to return to the Program Manager."; exit 3; }
exit 0
