#!/bin/bash
# Kilobyte Setup: copy the running live system onto a disk and make it boot.
#
# Disk layout (GPT, boots with both BIOS and UEFI):
#   1   1 MiB   BIOS boot partition (GRUB core image for BIOS)
#   2 512 MiB   EFI system partition (FAT32)
#   3  rest     root file system (ext4)
#
# Next to Windows 95/98/Me (PCs that start with their BIOS): its FAT drive is
# checked and made smaller with fatresize, files and all; Kilobyte goes into
# the freed space as a new partition of the same (MBR) table, and GRUB in
# the MBR offers both at start-up. Windows' drive appears as /media/windows.

. /usr/lib/kilobyte/lib.sh

if [ "$(id -u)" -ne 0 ]; then
    exec sudo KB_THEME="$(kb_theme_name)" "$0" "$@"
fi

SRC=/run/live/rootfs/filesystem.squashfs
TARGET=/mnt/kilobyte-target
LOG=/var/log/kilobyte-install.log
STATUS=/run/kilobyte-install.status
LIVE_USER=user

kb_backtitle() { printf ' ■ Kilobyte %s Setup' "$KB_VERSION"; }

log() { printf '%s\n' "$*" >> "$LOG"; }

cleanup() {
    for m in "$TARGET/boot/efi" "$TARGET"; do
        mountpoint -q "$m" && umount -R "$m" 2>>"$LOG"
    done
}

abort() {
    kb_msg "Setup" "Setup was cancelled. Nothing was changed on your disks." 8 50
    exit 1
}

if [ ! -d "$SRC/usr" ]; then
    kb_msg "Setup" "\Z1Kilobyte is not running from its live medium.\Zn\n\nSetup can only install from a Kilobyte USB stick or CD." 10 60
    exit 1
fi

# --- 1. Welcome ------------------------------------------------------------

kb_dialog --title " Welcome to Kilobyte Setup " --yes-label "Continue" --no-label "Cancel" --yesno "
Setup installs Kilobyte on this computer's disk.

  \Zb■\Zn  The disk you choose is \Zb\Z1completely erased\Zn.
  \Zb■\Zn  Installing takes a few minutes.
  \Zb■\Zn  Settings you made in the live session (keyboard,
     time zone, Wi-Fi networks, theme) are carried over.

Press \ZbEnter\Zn to continue or \ZbEsc\Zn to cancel." 16 60 || abort

# --- 2. Disk ---------------------------------------------------------------

live_disk=$(lsblk -no PKNAME "$(findmnt -no SOURCE /run/live/medium 2>/dev/null)" 2>/dev/null | head -n 1)

# --- Windows 95/98/Me, to install next to -------------------------------------

GIB=$((1024 * 1024 * 1024))
MIB=$((1024 * 1024))
KB_MIN=$((3 * GIB))          # the least Kilobyte gets
WIN_SPARE=$((500 * MIB))     # what Windows keeps free on its drive at least
MODE=disk

# The first FAT drive with Windows 9x on it: "PARTITION DISK".
find_win9x() {
    local path fstype pkname mnt found=""
    while read -r path fstype pkname; do
        [ "$fstype" = vfat ] && [ -n "$pkname" ] || continue
        [ "$(basename "$pkname")" = "$live_disk" ] && continue
        mnt=$(mktemp -d)
        if mount -o ro "$path" "$mnt" 2>/dev/null; then
            [ -n "$(find "$mnt" -maxdepth 1 -iname io.sys 2>/dev/null)" ] &&
                [ -n "$(find "$mnt" -maxdepth 2 -ipath "$mnt/windows/win.com" 2>/dev/null)" ] && found="$path $pkname"
            umount "$mnt"
        fi
        rmdir "$mnt"
        [ -n "$found" ] && { echo "$found"; return 0; }
    done < <(lsblk -lnpo PATH,FSTYPE,PKNAME 2>/dev/null)
    return 1
}

# What there is to share: sets WIN_* and the most Kilobyte can get (KB_MAX).
measure_win9x() {
    local mnt start size p disk_bytes
    local name; name=$(basename "$WIN_PART")
    [ "$(blkid -o value -s PTTYPE "$WIN_DISK")" = dos ] || return 3
    [ "$(sfdisk -l "$WIN_DISK" 2>/dev/null | grep -c "^$WIN_DISK")" -lt 4 ] || return 4
    WIN_NUM=$(cat "/sys/class/block/$name/partition")
    WIN_SIZE=$(blockdev --getsize64 "$WIN_PART")
    WIN_UUID=$(blkid -s UUID -o value "$WIN_PART")
    mnt=$(mktemp -d)
    mount -o ro "$WIN_PART" "$mnt" 2>/dev/null || { rmdir "$mnt"; return 1; }
    WIN_USED=$(df -B1 --output=used "$mnt" | tail -n 1 | tr -d ' ')
    umount "$mnt"; rmdir "$mnt"
    # Kilobyte goes after Windows: nothing else may be there.
    start=$(cat "/sys/class/block/$name/start")
    size=$(cat "/sys/class/block/$name/size")
    for p in /sys/class/block/"$(basename "$WIN_DISK")"/*/start; do
        [ "$(cat "$p")" -gt "$start" ] && return 2
    done
    disk_bytes=$(blockdev --getsize64 "$WIN_DISK")
    WIN_AFTER=$((disk_bytes - (start + size) * 512 - MIB))    # free space after it
    [ $WIN_AFTER -lt 0 ] && WIN_AFTER=0
    WIN_MIN=$((WIN_USED + WIN_SPARE))
    KB_MAX=$((WIN_SIZE - WIN_MIN + WIN_AFTER))
    # Without fatresize Windows' drive cannot shrink: only space after it counts.
    command -v fatresize >/dev/null || KB_MAX=$WIN_AFTER
    return 0
}

gb() { awk -v b="$1" 'BEGIN { printf "%.1f GB", b / 1073741824 }'; }

if [ ! -d /sys/firmware/efi ] && read -r WIN_PART WIN_DISK < <(find_win9x); then
    why=""
    measure_win9x
    case $? in
        1) why="The Windows drive could not be read." ;;
        2) why="There is another partition after the Windows drive." ;;
        3) why="The disk does not use the old (MBR) partition table." ;;
        4) why="The disk already has four partitions." ;;
    esac
    [ -z "$why" ] && [ "$KB_MAX" -lt "$KB_MIN" ] &&
        why="There is not enough room: Windows uses $(gb "$WIN_USED") of its $(gb "$WIN_SIZE") drive, and Kilobyte needs 3 GB."
    if [ -z "$why" ]; then
        how=$(kb_dialog --title " Windows Found " --ok-label "Next" --cancel-label "Cancel" --no-tags --menu "
Windows 95/98/Me is on $WIN_PART ($(gb "$WIN_SIZE"), $(gb "$WIN_USED") used).
How should Kilobyte be installed?" 13 72 2 \
            Alongside "Next to Windows: choose one of them at every start" \
            Erase     "On a whole disk: everything on it is erased") || abort
        [ "$how" = Alongside ] && MODE=alongside
    else
        kb_msg "Windows Found" "Windows 95/98/Me is on $WIN_PART, but Kilobyte cannot be installed next to it:\n\n$why\n\nSetup can still install Kilobyte on a whole disk, erasing it." 13 66
    fi
fi

if [ $MODE = alongside ]; then
    sizes=()
    for g in 3 4 6 8 12 16 24 32; do
        [ $((g * GIB)) -le "$KB_MAX" ] &&
            sizes+=("$g" "$g GB for Kilobyte, $(gb $((WIN_SIZE + WIN_AFTER - g * GIB))) stay for Windows")
    done
    sizes+=(max "$(gb "$KB_MAX") for Kilobyte (the most), $(gb $((WIN_SIZE + WIN_AFTER - KB_MAX))) for Windows")
    KB_SIZE=$(kb_dialog --title " Space for Kilobyte " --ok-label "Next" --cancel-label "Cancel" --no-tags \
        --default-item 4 --menu "Windows' drive is made smaller to make room; its files stay.
Windows needs at least $(gb "$WIN_MIN") of it." 18 72 9 "${sizes[@]}") || abort
    if [ "$KB_SIZE" = max ]; then KB_SIZE=$KB_MAX; else KB_SIZE=$((KB_SIZE * GIB)); fi
    WIN_NEW=$((WIN_SIZE + WIN_AFTER - KB_SIZE))
    [ $WIN_NEW -gt "$WIN_SIZE" ] && WIN_NEW=$WIN_SIZE
    DISK=$WIN_DISK
fi

disks=()
while read -r name size type tran model; do
    [ "$type" = disk ] || continue
    case $name in loop* | sr* | zram* | ram* | fd*) continue ;; esac
    [ "$name" = "$live_disk" ] && continue
    [ "$size" -ge $((4 * 1024 * 1024 * 1024)) ] || continue
    disks+=("/dev/$name" "$(numfmt --to=iec --suffix=B "$size")  ${tran:-}  ${model:-disk}")
done < <(lsblk -dnbo NAME,SIZE,TYPE,TRAN,MODEL)

if [ $MODE = alongside ]; then
    :
elif [ ${#disks[@]} -eq 0 ]; then
    kb_msg "Setup" "\Z1No disk found to install on.\Zn\n\nKilobyte needs a disk of at least 4 GB that is not the stick it runs from." 10 60
    exit 1
else
    DISK=$(kb_dialog --title " Where to install " --ok-label "Next" --cancel-label "Cancel" \
        --menu "Choose the disk for Kilobyte. \Z1Everything on it will be erased.\Zn" 16 70 6 "${disks[@]}") || abort
fi

# --- 3. Keyboard, time zone, computer name, account -------------------------

. /usr/lib/kilobyte/setup-questions.sh
RESERVED_USERS_FROM="$SRC/etc/passwd"
ask_keyboard  || abort
ask_timezone  || abort
ask_hostname  || abort
ask_user      || abort
ask_password  || abort
ask_autologin

# --- 5. Last chance --------------------------------------------------------

if [ $MODE = alongside ]; then
    kb_dialog --title " Ready to Install " --defaultno --yes-label "Install" --no-label "Cancel" --yesno "
  Windows       \Zb$WIN_PART\Zn: $(gb "$WIN_SIZE") now, $(gb "$WIN_NEW") afterwards
  Kilobyte      $(gb "$KB_SIZE") after it, on $DISK
  Keyboard      $KEYMAP
  Time zone     $TZONE
  Computer      $HOST
  User          $NAME (administrator), automatic login: $AUTOLOGIN

Windows' files stay, but resizing a drive is never without risk:
\Z1\Zbcopy what you cannot lose to another disk first.\Zn
At every start a menu offers Kilobyte and Windows 98.

Choose Install to start." 19 70 || abort
else
    kb_dialog --title " Ready to Install " --defaultno --yes-label "Install" --no-label "Cancel" --yesno "
  Disk          \Zb$DISK\Zn ($(lsblk -dno SIZE,MODEL "$DISK" | xargs))
  Keyboard      $KEYMAP
  Time zone     $TZONE
  Computer      $HOST
  User          $NAME (administrator), automatic login: $AUTOLOGIN

\Z1\ZbALL DATA ON $DISK WILL BE ERASED.\Zn

Choose Install to start." 17 64 || abort
fi

# --- 6. Install ------------------------------------------------------------

part() { # part DISK N -> partition device (sda -> sda3, nvme0n1 -> nvme0n1p3)
    case $1 in *[0-9]) echo "${1}p$2" ;; *) echo "$1$2" ;; esac
}
EFI_PART=$(part "$DISK" 2)
ROOT_PART=$(part "$DISK" 3)

progress() { printf 'XXX\n%d\n\n  %s\nXXX\n' "$1" "$2"; log "== $1% $2"; }

in_target() { chroot "$TARGET" "$@" >> "$LOG" 2>&1; }

install_system() {
    set -e
    trap 'echo "failed at line $LINENO" > "$STATUS"' ERR

    swapoff -a 2>/dev/null || true
    for p in $(lsblk -lno PATH "$DISK" | tail -n +2); do umount "$p" 2>/dev/null || true; done
    if [ $MODE = alongside ]; then
        progress 2 "Checking the Windows drive..."
        if ! fsck.fat -n "$WIN_PART" >> "$LOG" 2>&1; then
            echo "the Windows drive has errors: run ScanDisk in Windows, then Setup again" > "$STATUS"
            exit 1
        fi
        if [ "$WIN_NEW" -lt "$WIN_SIZE" ]; then
            progress 3 "Making the Windows drive smaller (this can take a while)..."
            local win_type
            win_type=$(sfdisk --part-type "$WIN_DISK" "$WIN_NUM")
            fatresize -f -s "$((WIN_NEW / MIB))M" -n "$WIN_NUM" "$WIN_DISK" >> "$LOG" 2>&1
            # fatresize writes type 0B (FAT32, CHS); a drive that had 0C (FAT32,
            # LBA) keeps it, or Windows 98 may not reach past 8 GB properly.
            sfdisk --part-type "$WIN_DISK" "$WIN_NUM" "$win_type" >> "$LOG" 2>&1 || true
            partx -u "$DISK" >> "$LOG" 2>&1 || true
            udevadm settle
            if ! fsck.fat -n "$WIN_PART" >> "$LOG" 2>&1; then
                echo "the Windows drive reports errors after resizing: see the log" > "$STATUS"
                exit 1
            fi
        fi
        progress 4 "Adding Kilobyte's partition..."
        printf ',,83\n' | sfdisk --append --no-reread "$DISK" >> "$LOG" 2>&1
        partx -a "$DISK" >> "$LOG" 2>&1 || partx -u "$DISK" >> "$LOG" 2>&1 || true
        udevadm settle
        sleep 1
        ROOT_PART=$(lsblk -lnpo PATH,TYPE "$DISK" | awk '$2 == "part" { p = $1 } END { print p }')
        log "Kilobyte goes on $ROOT_PART"
        if [ -z "$ROOT_PART" ] || [ "$ROOT_PART" = "$WIN_PART" ]; then
            echo "the new partition did not appear" > "$STATUS"
            exit 1
        fi
        progress 5 "Creating the file system..."
    else
        progress 2 "Erasing and partitioning $DISK..."
        wipefs -af "$DISK" >> "$LOG" 2>&1
        sfdisk --wipe always --wipe-partitions always "$DISK" >> "$LOG" 2>&1 <<EOF
label: gpt
size=1MiB, type=21686148-6449-6E6F-744E-656564454649, name="bios"
size=512MiB, type=C12A7328-F81F-11D2-BA4B-00A0C93EC93B, name="efi"
type=0FC63DAF-8483-4772-8E79-3D69D8477DE4, name="kilobyte"
EOF
        udevadm settle
        sleep 1
        progress 5 "Creating file systems..."
        mkfs.vfat -F 32 -n EFI "$EFI_PART" >> "$LOG" 2>&1
    fi
    mkfs.ext4 -F -q -L kilobyte "$ROOT_PART" >> "$LOG" 2>&1
    mkdir -p "$TARGET"
    mount "$ROOT_PART" "$TARGET"

    # Copy in the background and show how far along it is.
    local total used pct
    total=$(du -smx "$SRC" | cut -f1)
    cp -a "$SRC/." "$TARGET/" 2>> "$LOG" &
    local cp_pid=$!
    while kill -0 "$cp_pid" 2>/dev/null; do
        used=$(df -m --output=used "$TARGET" | tail -n 1)
        pct=$(( 8 + 70 * used / (total > 0 ? total : 1) ))
        [ $pct -gt 78 ] && pct=78
        progress $pct "Copying files... ($used of $total MB)"
        sleep 2
    done
    wait "$cp_pid"

    progress 80 "Configuring the system..."
    if [ $MODE = disk ]; then
        mkdir -p "$TARGET/boot/efi"
        mount "$EFI_PART" "$TARGET/boot/efi"
    fi
    for d in dev proc sys run; do mount --rbind "/$d" "$TARGET/$d"; mount --make-rslave "$TARGET/$d"; done

    {
        echo "# <file system>  <mount point>  <type>  <options>  <dump>  <pass>"
        echo "UUID=$(blkid -s UUID -o value "$ROOT_PART")  /          ext4  errors=remount-ro  0  1"
        [ $MODE = disk ] && echo "UUID=$(blkid -s UUID -o value "$EFI_PART")  /boot/efi  vfat  umask=0077         0  2"
        echo "/dev/sr0  /media/cdrom  udf,iso9660  ro,user,noauto  0  0"
    } > "$TARGET/etc/fstab"
    echo "$HOST" > "$TARGET/etc/hostname"
    sed -i "s/\bkilobyte\b/$HOST/g" "$TARGET/etc/hosts"
    ln -sf "/usr/share/zoneinfo/$TZONE" "$TARGET/etc/localtime"
    echo "$TZONE" > "$TARGET/etc/timezone"
    sed -i "s/^XKBLAYOUT=.*/XKBLAYOUT=\"$KEYMAP\"/" "$TARGET/etc/default/keyboard"
    cp /etc/default/console-setup "$TARGET/etc/default/console-setup"
    cp -a /etc/wpa_supplicant/wpa_supplicant-*.conf "$TARGET/etc/wpa_supplicant/" 2>/dev/null || true
    [ -e /etc/kilobyte/wifi-off ] && { mkdir -p "$TARGET/etc/kilobyte"; cp /etc/kilobyte/wifi-off "$TARGET/etc/kilobyte/"; }

    progress 84 "Creating your account..."
    # Remove everything that only makes sense on the live medium.
    rm -f "$TARGET/etc/sudoers.d/live"
    rm -rf "$TARGET/etc/systemd/system/getty@tty1.service.d"
    in_target userdel -r "$LIVE_USER" || true
    local groups g
    groups=$(user_groups "$TARGET/etc/group")
    in_target useradd -m -s /bin/bash -G "$groups" "$NAME"
    printf '%s:%s\n' "$NAME" "$PW1" | chroot "$TARGET" chpasswd
    in_target passwd -l root
    local theme_dir="$TARGET/home/$NAME/.config/kilobyte"
    mkdir -p "$theme_dir"
    kb_theme_name > "$theme_dir/theme"
    in_target chown -R "$NAME:$NAME" "/home/$NAME"
    if [ $MODE = alongside ]; then
        # Windows' drive, readable and writable by the new user.
        mkdir -p "$TARGET/media/windows"
        echo "UUID=$WIN_UUID  /media/windows  vfat  nofail,uid=$(chroot "$TARGET" id -u "$NAME"),gid=$(chroot "$TARGET" id -g "$NAME"),umask=022,utf8  0  0" >> "$TARGET/etc/fstab"
    fi
    [ "$AUTOLOGIN" = yes ] && write_autologin "$TARGET" "$NAME"

    in_target setupcon --save-only --force    # font and keyboard at boot

    progress 88 "Removing the live system tools..."
    in_target dpkg --purge live-boot live-boot-initramfs-tools || true
    in_target update-initramfs -u -k all

    progress 94 "Installing the boot loader..."
    # BIOS, and UEFI in the flavour of this build (64-bit, or 32-bit PCs).
    # 64-bit systems also get 32-bit EFI GRUB (EFI/BOOT/BOOTIA32.EFI) for old
    # EFI 1.x machines and early Intel Macs, whose firmware is 32-bit.
    local efi=x86_64-efi efi32=
    [ "$(dpkg --print-architecture)" = i386 ] && efi=i386-efi
    [ $efi = x86_64-efi ] && [ -d "$TARGET/usr/lib/grub/i386-efi" ] && efi32=i386-efi
    in_target grub-install --target=i386-pc "$DISK"
    if [ $MODE = alongside ]; then
        # A menu with both at every start; Windows starts from its own drive.
        printf '%s\n' '#!/bin/sh' "cat <<'MENU'" 'menuentry "Windows 98" {' '    insmod part_msdos' '    insmod fat' \
            "    search --no-floppy --fs-uuid --set=root $WIN_UUID" '    chainloader +1' '}' 'MENU' \
            > "$TARGET/etc/grub.d/35_windows9x"
        chmod 755 "$TARGET/etc/grub.d/35_windows9x"
        mkdir -p "$TARGET/etc/default/grub.d"
        printf 'GRUB_TIMEOUT=10\nGRUB_TIMEOUT_STYLE=menu\n' > "$TARGET/etc/default/grub.d/kilobyte-windows.cfg"
        in_target update-grub
        progress 98 "Finishing..."
        sync
        cleanup
        progress 100 "Done."
        echo ok > "$STATUS"
        sleep 1
        return 0
    fi
    in_target grub-install --target=$efi --efi-directory=/boot/efi --bootloader-id=kilobyte --removable --no-nvram
    [ -n "$efi32" ] && { in_target grub-install --target=$efi32 --efi-directory=/boot/efi \
        --bootloader-id=kilobyte --removable --no-nvram || true; }
    if [ -d /sys/firmware/efi ]; then
        # Register with the firmware in its own flavour (32-bit on a 64-bit PC).
        local fw=$efi
        [ "$(cat /sys/firmware/efi/fw_platform_size 2>/dev/null)" = 32 ] && [ -n "$efi32" ] && fw=$efi32
        in_target grub-install --target=$fw --efi-directory=/boot/efi --bootloader-id=kilobyte || true
    fi
    in_target update-grub

    progress 98 "Finishing..."
    sync
    cleanup
    progress 100 "Done."
    echo ok > "$STATUS"
    sleep 1
}

: > "$LOG"
rm -f "$STATUS"
# From here on the disk is being written: Ctrl-C must not stop that halfway.
trap '' INT QUIT
install_system | kb_dialog --title " Installing Kilobyte " --gauge "\n  Starting..." 9 70 0

if [ "$(cat "$STATUS" 2>/dev/null)" != ok ]; then
    cleanup
    kb_dialog --title " Setup Failed " --exit-label "Close" --textbox "$LOG" 0 0
    kb_msg "Setup Failed" "\Z1\ZbKilobyte could not be installed\Zn ($(cat "$STATUS" 2>/dev/null)).\n\nThe log is in $LOG." 10 60
    exit 1
fi

if kb_dialog --title " Kilobyte is Installed " --yes-label "Restart" --no-label "Later" --yesno "
\ZbKilobyte is now installed on $DISK.\Zn

Remove the USB stick or CD, then restart the computer.$([ $MODE = alongside ] && printf '\nA menu then chooses Kilobyte or Windows 98.')
Log in as \Zb$NAME\Zn with the password you chose." 11 60; then
    clear
    systemctl reboot
fi
