[Unit]
Description=Kilobyte: the fans as Fan Control sets them (quiet, normal, cool, full or a fixed speed)
# Automatic (the computer's own way) needs no service: Fan Control stops it.
ConditionPathExists=/etc/kilobyte/fan.conf
After=systemd-modules-load.service

[Service]
ExecStart=/usr/bin/python3 /usr/lib/kilobyte/py/fan.py run
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
