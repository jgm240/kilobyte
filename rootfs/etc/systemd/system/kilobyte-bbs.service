[Unit]
Description=Kilobyte BBS (hostbbs): the bulletin board friends dial into
Documentation=file:/usr/lib/kilobyte/py/hostbbs.py
After=network.target
# Switched on and off in Internet > Host a BBS (kb-root bbs on|off).

[Service]
ExecStart=/usr/bin/python3 /usr/lib/kilobyte/py/hostbbs.py run -c /etc/kilobyte/bbs/hostbbs.json --data-dir /var/lib/kilobyte-bbs
User=kbbs
Group=kbbs
WorkingDirectory=/var/lib/kilobyte-bbs
Environment=LANG=C.UTF-8 HOME=/var/lib/kilobyte-bbs PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5
# Telnet's own port, 23, is below 1024: allowed, nothing else.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# Callers are strangers: the BBS can read Kilobyte, its settings and its file
# areas, and write only its own data.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/kilobyte-bbs
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=300M
TasksMax=80
Nice=5

[Install]
WantedBy=multi-user.target
