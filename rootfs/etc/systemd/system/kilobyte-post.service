[Unit]
Description=Kilobyte start-up screen (and the end of the start-up messages)
After=systemd-vconsole-setup.service console-setup.service
Before=getty@tty1.service

[Service]
Type=oneshot
ExecStart=/usr/lib/kilobyte/post
StandardInput=null
StandardOutput=tty
TTYPath=/dev/tty1
TTYReset=yes
TimeoutSec=20

[Install]
WantedBy=multi-user.target
