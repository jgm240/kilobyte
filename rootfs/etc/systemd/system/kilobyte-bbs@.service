[Unit]
Description=Kilobyte BBS: a caller
Documentation=file:/usr/lib/kilobyte/py/bbs.py

[Service]
ExecStart=/usr/bin/python3 /usr/lib/kilobyte/py/bbs.py
StandardInput=socket
StandardOutput=socket
StandardError=journal
User=kbbs
Group=kbbs
WorkingDirectory=/var/lib/kilobyte-bbs
Environment=LANG=C.UTF-8 HOME=/var/lib/kilobyte-bbs
# A call lasts at most as long as the BBS allows (bbs.conf: minutes), and
# never more than four hours.
RuntimeMaxSec=4h
# Callers are strangers: the BBS can read Kilobyte and its own files, and
# write only its own data.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/kilobyte-bbs
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=200M
TasksMax=40
Nice=5
