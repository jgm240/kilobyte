[Unit]
Description=Kilobyte logo during start-up
Documentation=file:/usr/lib/kilobyte/bootlogo
# From as early as possible until the start-up screen (kilobyte-post, which
# stops it) takes over the console.
DefaultDependencies=no
Conflicts=shutdown.target
ConditionKernelCommandLine=!quiet

[Service]
Type=simple
ExecStart=/usr/lib/kilobyte/bootlogo watch
StandardInput=null
StandardOutput=tty
TTYPath=/dev/tty1
TTYReset=no
TTYVHangup=no
TTYVTDisallocate=no

[Install]
WantedBy=sysinit.target
