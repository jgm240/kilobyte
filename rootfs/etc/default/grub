GRUB_DEFAULT=0
GRUB_TIMEOUT=3
GRUB_DISTRIBUTOR="Kilobyte"
# No "quiet": every start-up message shows, under the Kilobyte logo.
GRUB_CMDLINE_LINUX_DEFAULT="consoleblank=0"
GRUB_CMDLINE_LINUX=""
# The Kilobyte menu in graphics mode; GRUB falls back to text by itself.
GRUB_TERMINAL_OUTPUT=gfxterm
GRUB_GFXMODE=1024x768,800x600,auto
GRUB_THEME=/usr/share/kilobyte/grub/theme.txt
GRUB_GFXPAYLOAD_LINUX=keep
GRUB_DISABLE_OS_PROBER=true
